<div class="row g-4">
<section class="col-lg-6"><h3 class="h6">@T("Tasks · handle + overlay","المهام · مقبض ونسخة متحركة")</h3>
    <Sortable TItem="Work" @bind-Items="tasks" GetId="x=>x.Id" GetLabel="x=>Arabic?x.Arabic:x.Title" Class="vstack gap-2" ItemClass="d-flex align-items-center gap-2 px-2 py-2 border rounded-3 bg-body" Instructions="@Instructions" HandleLabel="@T("Reorder","إعادة ترتيب")" Grabbed="@Grabbed" Moved="@Moved" Dropped="@Dropped" Cancelled="@Cancelled">
        <ItemTemplate Context="task"><span class="flex-fill text-truncate">@T(task.Title,task.Arabic)</span><span class="@($"badge bg-{task.Color}-subtle text-body-emphasis")">@task.Tag</span></ItemTemplate>
    </Sortable><p class="small text-body-secondary mt-2">@T("Drag by the grip, or focus it and use Space, ↑ ↓, Space.","اسحب المقبض، أو ركّز عليه واضغط مسافة ثم الأسهم ثم مسافة.")</p>
</section>
<div class="col-lg-6 vstack gap-4">
    <section><h3 class="h6">@T("Horizontal · whole item drags","أفقي · سحب العنصر بالكامل")</h3><Sortable TItem="string" @bind-Items="tags" GetId="x=>x" Orientation="horizontal" AsHandle Class="d-flex flex-wrap gap-2" ItemClass="px-3 py-1 border rounded-pill bg-body small fw-medium" Instructions="@Instructions" Grabbed="@Grabbed" Moved="@Moved" Dropped="@Dropped" Cancelled="@Cancelled"><ItemTemplate Context="tag">@tag</ItemTemplate></Sortable><output class="small font-monospace">@string.Join(" → ",tags)</output></section>
    <section><h3 class="h6">@T("Grid · mixed","شبكة · اتجاه مختلط")</h3><div style="max-width:320px"><Sortable TItem="string" @bind-Items="colors" GetId="x=>x" Orientation="mixed" AsHandle Class="d-grid gap-2" Style="grid-template-columns:repeat(4,1fr)" ItemStyle="ColorStyle" Instructions="@Instructions" Grabbed="@Grabbed" Moved="@Moved" Dropped="@Dropped" Cancelled="@Cancelled"><ItemTemplate Context="color"><span class="visually-hidden">@color</span></ItemTemplate></Sortable></div></section>
    <section dir="rtl"><h3 class="h6">بالعربية</h3><Sortable TItem="string" @bind-Items="chapters" GetId="x=>x" Class="vstack gap-2" ItemClass="d-flex align-items-center gap-2 px-2 py-2 border rounded-3 bg-body" Instructions="اضغط مسافة أو Enter لالتقاط العنصر، والأسهم لتحريكه، ومسافة لإفلاته، وEscape للإلغاء." HandleLabel="اسحب لإعادة الترتيب" Grabbed="التقطت {item}. الموضع {position} من {total}." Moved="نُقل {item} إلى الموضع {position} من {total}." Dropped="أُفلت {item} في الموضع {position} من {total}." Cancelled="أُلغي النقل. عاد {item} إلى الموضع {position} من {total}."><ItemTemplate Context="chapter"><span class="flex-fill">@chapter</span></ItemTemplate></Sortable></section>
</div></div>
@code {
    [Parameter] public bool Arabic { get; set; }
    public sealed record Work(string Id,string Title,string Arabic,string Tag,string Color);
    private IReadOnlyList<Work> tasks=new[]{new Work("t1","Write the release notes","كتابة ملاحظات الإصدار","Docs","info"),new Work("t2","Fix the RTL caret in Command","إصلاح مؤشر RTL في Command","Bug","warning"),new Work("t3","Add radius levels to the README","توثيق مستويات الحواف","Docs","info"),new Work("t4","Ship Speed Dial","إصدار Speed Dial","Feature","success"),new Work("t5","Review the QR code PR","مراجعة تحديث QR","Review","primary")};
    private IReadOnlyList<string> tags=new[]{"React","Bootstrap","Radix","SCSS","TypeScript"};
    private IReadOnlyList<string> colors=new[]{"#0ea5e9","#10b981","#f59e0b","#ef4444","#8b5cf6","#ec4899","#14b8a6","#64748b"};
    private IReadOnlyList<string> chapters=new[]{"الفاتحة","البقرة","آل عمران","النساء"};
    private string ColorStyle(string color)=>$"background-color:{color};aspect-ratio:1;border-radius:calc(.75rem * var(--rax-radius-scale))";
    private string T(string en,string ar)=>Arabic?ar:en;
    private string Instructions=>T("Press Space or Enter to pick up, arrows to move, Space to drop, Escape to cancel.","اضغط مسافة أو Enter لالتقاط العنصر، والأسهم لتحريكه، ومسافة لإفلاته، وEscape للإلغاء.");
    private string Grabbed=>T("Picked up {item}. Position {position} of {total}.","التقطت {item}. الموضع {position} من {total}.");
    private string Moved=>T("Moved {item} to position {position} of {total}.","نُقل {item} إلى الموضع {position} من {total}.");
    private string Dropped=>T("Dropped {item} at position {position} of {total}.","أُفلت {item} في الموضع {position} من {total}.");
    private string Cancelled=>T("Cancelled moving {item}. Position {position} of {total}.","أُلغي النقل. عاد {item} إلى الموضع {position} من {total}.");
}
