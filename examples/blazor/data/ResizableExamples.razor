<div class="vstack gap-4">
<section><h3 class="h6">@T("Mail · nested, collapsible and saved","البريد · متداخل وقابل للطي والحفظ")</h3>
<ResizablePanelGroup AutoSaveId="sheen-demo-mail" Variant="glass" Style="height:420px">
    <ResizablePanel Id="mail-folders" DefaultSize="20%" MinSize="12%" MaxSize="35%" Collapsible>
        <nav class="p-3 d-grid gap-2" aria-label="@T("Mail folders","مجلدات البريد")">@foreach(var folder in new[]{T("Inbox","الوارد"),T("Sent","المرسل"),T("Drafts","المسودات"),T("Archive","الأرشيف")}){<Button Variant="ghost" Size="sm" OnClick="()=>notice=folder">@folder</Button>}</nav>
    </ResizablePanel>
    <ResizableHandle Label="@T("Resize folders","تغيير عرض المجلدات")" />
    <ResizablePanel Id="mail-list" DefaultSize="34%" MinSize="22%">
        <ul class="list-unstyled p-2 m-0 d-grid gap-1">@for(var i=0;i<mail.Length;i++){var index=i;<li><button type="button" class="@($"w-100 text-start border-0 rounded-3 p-3 {(open==index?"bg-primary-subtle":"bg-transparent")}")" @onclick="()=>open=index"><strong class="d-block small">@mail[index].From</strong><span class="small">@T(mail[index].Subject,mail[index].Arabic)</span></button></li>}</ul>
    </ResizablePanel>
    <ResizableHandle WithHandle Label="@T("Resize message list","تغيير عرض الرسائل")" />
    <ResizablePanel Id="mail-reader" DefaultSize="46%" MinSize="30%">
        <ResizablePanelGroup Orientation="vertical" AutoSaveId="sheen-demo-mail-reader" Style="height:100%">
            <ResizablePanel Id="reader-message" DefaultSize="65%" MinSize="30%"><article class="p-4"><div class="small text-body-secondary">@mail[open].From</div><h4 class="h6 mt-2">@T(mail[open].Subject,mail[open].Arabic)</h4><p class="small">@T("Thanks for checking the latest SheenUI components. Try resizing these panels and opening another message.","شكراً لتجربة مكونات SheenUI. جرّب تغيير أحجام اللوحات وفتح رسالة أخرى.")</p></article></ResizablePanel>
            <ResizableHandle WithHandle Label="@T("Resize reply","تغيير ارتفاع الرد")" />
            <ResizablePanel Id="reader-reply" DefaultSize="35%" MinSize="20%"><div class="p-3 h-100 d-flex flex-column gap-2"><textarea class="form-control sheen-textarea flex-fill" aria-label="@T("Reply","الرد")" placeholder="@T("Reply…","اكتب ردّك…")" @bind="reply"></textarea><div><Button Size="sm" OnClick="Send">@T("Send","إرسال")</Button></div></div></ResizablePanel>
        </ResizablePanelGroup>
    </ResizablePanel>
</ResizablePanelGroup>
<p class="small text-body-secondary">@T("Drag a divider, or focus it with Tab and use the arrow keys. Double-click resets it. The layout is remembered.","اسحب الفاصل أو ركّز عليه واستخدم الأسهم. النقر المزدوج يعيد الأحجام. يُحفظ التخطيط.")</p><output role="status">@notice</output>
</section>
<section><h3 class="h6">@T("Live sizes","الأحجام الحالية")</h3><ResizablePanelGroup Style="height:140px;border:1px solid var(--sheen-glass-border-color);border-radius:var(--sheen-radius)" LayoutChanged="Changed">
    <ResizablePanel Id="live-a" DefaultSize="40%" MinSize="20%"><div class="h-100 d-flex align-items-center justify-content-center fs-4"><span data-resizable-size="live-a">@Pct("live-a",40)</span></div></ResizablePanel>
    <ResizableHandle WithHandle Label="@T("Resize A and B","تغيير حجم أ وب")" />
    <ResizablePanel Id="live-b" DefaultSize="60%" MinSize="20%"><div class="h-100 d-flex align-items-center justify-content-center fs-4"><span data-resizable-size="live-b">@Pct("live-b",60)</span></div></ResizablePanel>
</ResizablePanelGroup></section>
<section><h3 class="h6">@T("Vertical","عمودي")</h3><ResizablePanelGroup Orientation="vertical" Variant="glass" Style="height:260px"><ResizablePanel Id="editor-code" DefaultSize="70%" MinSize="25%"><pre class="m-0 p-3 small">&lt;ResizablePanelGroup Orientation="vertical"&gt;
    &lt;ResizablePanel DefaultSize="70%" /&gt;
    &lt;ResizableHandle WithHandle /&gt;
    &lt;ResizablePanel MinSize="80px" /&gt;
&lt;/ResizablePanelGroup&gt;</pre></ResizablePanel><ResizableHandle WithHandle Label="@T("Resize terminal","تغيير ارتفاع الطرفية")"/><ResizablePanel Id="editor-terminal" DefaultSize="30%" MinSize="80px"><pre class="m-0 p-3 small text-body-secondary">$ npm run build
✓ built in 9.4s</pre></ResizablePanel></ResizablePanelGroup></section>
<section dir="rtl"><h3 class="h6">بالعربية · RTL</h3><ResizablePanelGroup Variant="glass" Style="height:120px" Direction="rtl"><ResizablePanel Id="arabic-start" DefaultSize="30%" MinSize="15%"><div class="p-3">البداية</div></ResizablePanel><ResizableHandle WithHandle Label="تغيير حجم اللوحتين"/><ResizablePanel Id="arabic-end" DefaultSize="70%" MinSize="20%"><div class="p-3">النهاية · اسحب الفاصل أو استخدم الأسهم</div></ResizablePanel></ResizablePanelGroup></section>
</div>
@code {
    [Parameter] public bool Arabic { get; set; }
    private int open;private string reply="",notice="";
    private readonly (string From,string Subject,string Arabic)[] mail={ ("Sara Ahmed","Design review","مراجعة التصميم"),("Omar Khalid","Release checklist","قائمة الإصدار"),("Layla Hassan","Team notes","ملاحظات الفريق") };
    private IReadOnlyDictionary<string,double> sizes=new Dictionary<string,double>();
    private string T(string en,string ar)=>Arabic?ar:en;
    private string Pct(string id,double initial)=>$"{Math.Round(sizes.TryGetValue(id,out var value)?value:initial)}%";
    private void Changed(IReadOnlyDictionary<string,double> value)=>sizes=value;
    private void Send(){if(string.IsNullOrWhiteSpace(reply))return;notice=T("Reply sent (demo).","تم إرسال الرد تجريبياً.");reply="";}
}
