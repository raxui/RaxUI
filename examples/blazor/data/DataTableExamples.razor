<div class="vstack gap-5">
    <section><h3 class="h6">@T("Recent invoices","الفواتير الأخيرة")</h3><div class="rax-table-frame">
        <Table><TableHeader><TableRow><TableHead>@T("Invoice","الفاتورة")</TableHead><TableHead>@T("Status","الحالة")</TableHead><TableHead>@T("Method","الدفع")</TableHead><TableHead Class="text-end">@T("Amount","المبلغ")</TableHead></TableRow></TableHeader>
            <TableBody>@foreach(var row in recent){<TableRow @key="row.Id"><TableCell>@row.Id</TableCell><TableCell>@Status(row.Status)</TableCell><TableCell>@Method(row.Method)</TableCell><TableCell Class="text-end">@Money(row.Amount)</TableCell></TableRow>}</TableBody>
            <TableFooter><TableRow><TableCell colspan="3">@T("Total","المجموع")</TableCell><TableCell Class="text-end">@Money(recent.Sum(x=>x.Amount))</TableCell></TableRow></TableFooter>
            <TableCaption>@T("Your four most recent invoices.","آخر أربع فواتير.")</TableCaption>
        </Table></div>
    </section>
    <section><div class="d-flex flex-wrap justify-content-between gap-2 mb-3"><div><h3 class="h6 mb-1">@T("Orders","الطلبات")</h3><p class="small text-body-secondary mb-0">@T("Sort, search, filter, select rows for bulk actions, hide columns or switch density.","ابحث ورتب وصفِّ وحدد الطلبات، وأخفِ الأعمدة أو غيّر الكثافة.")</p></div>
        <label class="d-flex gap-2 align-items-center">@T("Simulate loading","محاكاة التحميل")<Switch @bind-Value="loading" /></label></div>
        <DataTable @ref="table" TItem="Order" Items="orders" Columns="Columns" GetRowId="row=>row.Id" Label="@T("Orders","الطلبات")" Labels="Labels" Loading="loading" InitialSorting="@(new[]{new DataTableTypes.Sort("date",true)})">
            <Toolbar><Button Size="sm" Variant="secondary" OnClick="()=>Export(orders.Count)">@T("Export","تصدير")</Button></Toolbar>
            <BulkActions Context="selected"><Button Size="sm" Variant="ghost" OnClick="()=>ExportSelected(selected.Count)">@T("Export","تصدير")</Button><Button Size="sm" Variant="ghost" Class="text-danger" OnClick="()=>Delete(selected)">@T("Delete","حذف")</Button></BulkActions>
        </DataTable>
        <output class="small" role="status">@message</output>
    </section>
</div>
@code {
    [Parameter] public bool Arabic { get; set; }
    private DataTable<Order>? table;
    private async Task ExportSelected(int count){Export(count);if(table is not null)await table.ClearSelection();}
    private bool loading;
    private string message="";
    public sealed record Order(string Id,string Name,string Email,string Status,string Method,DateOnly Date,decimal Amount);
    private static readonly string[] names={"Saad Alsaree","Sara Ahmed","Omar Khalid","Layla Hassan","Noura Ali","Yousef Nasser","Mona Fares","Ahmed Saleh","Huda Karim","Salem Hassan","Reem Ali","Faisal Mansour","Dana Yousef","Khalid Rahman","Lina Sabri","Majed Omar"};
    private List<Order> orders=Enumerable.Range(0,48).Select(i=>new Order($"ORD-{1048-i}",names[i*7%names.Length],names[i*7%names.Length].Split(' ')[0].ToLowerInvariant()+"@example.com",new[]{"paid","paid","paid","pending","paid","refunded","paid","failed","pending"}[i*5%9],new[]{"card","apple","card","bank"}[i*3%4],new DateOnly(2026,10,21).AddDays(-i),(i*7919%900)+19.99m)).ToList();
    private Order[] recent=Array.Empty<Order>();
    protected override void OnInitialized()=>recent=orders.Take(4).ToArray();
    private string T(string en,string ar)=>Arabic?ar:en;
    private string Status(string value)=>value switch {"paid"=>T("Paid","مدفوع"),"pending"=>T("Pending","معلّق"),"refunded"=>T("Refunded","مسترد"),_=>T("Failed","فشل")};
    private string Method(string value)=>value switch {"card"=>T("Card","بطاقة"),"apple"=>"Apple Pay",_=>T("Bank transfer","تحويل مصرفي")};
    private string Money(decimal amount)=>amount.ToString("N2",System.Globalization.CultureInfo.GetCultureInfo(Arabic?"ar-IQ":"en-US"))+T(" IQD"," د.ع");
    private RenderFragment<Order> Customer=>row=>@<div><span class="fw-medium">@row.Name</span><div class="small text-body-secondary">@row.Email</div></div>;
    private RenderFragment<Order> Badge=>row=>@<span class="@($"badge rounded-pill bg-{(row.Status=="paid"?"success":row.Status=="failed"?"danger":row.Status=="pending"?"warning":"secondary")}-subtle text-body-emphasis")">@Status(row.Status)</span>;
    private RenderFragment<Order> Actions=>row=>@<DropdownMenu TriggerVariant="ghost" TriggerClass="btn-sm"><Trigger><span aria-label="@T("Order actions","إجراءات الطلب")">⋯</span></Trigger><ChildContent><DropdownMenuItem OnSelect="()=>Export(1)">@T("Export","تصدير")</DropdownMenuItem><DropdownMenuItem OnSelect="()=>Delete(new[]{row})">@T("Delete","حذف")</DropdownMenuItem></ChildContent></DropdownMenu>;
    private IReadOnlyList<DataTableTypes.Column<Order>> Columns=>new DataTableTypes.Column<Order>[]{
        new(){Id="id",Title=T("Order","الطلب"),Value=r=>r.Id},
        new(){Id="customer",Title=T("Customer","العميل"),Value=r=>r.Name+" "+r.Email,Cell=Customer},
        new(){Id="status",Title=T("Status","الحالة"),Value=r=>r.Status,Cell=Badge,Options=new[]{"paid","pending","refunded","failed"}.Select(x=>new DataTableTypes.Option(x,Status(x))).ToArray()},
        new(){Id="method",Title=T("Payment","الدفع"),Value=r=>r.Method,Format=v=>Method(Convert.ToString(v)??""),Options=new[]{"card","apple","bank"}.Select(x=>new DataTableTypes.Option(x,Method(x))).ToArray()},
        new(){Id="date",Title=T("Date","التاريخ"),Value=r=>r.Date,Format=v=>((DateOnly)v!).ToString("yyyy-MM-dd")},
        new(){Id="amount",Title=T("Amount","المبلغ"),Value=r=>r.Amount,Format=v=>Money((decimal)v!),Align="end"},
        new(){Id="actions",Title=T("Actions","الإجراءات"),Value=r=>r.Id,Cell=Actions,Sortable=false,Searchable=false,Hideable=false}
    };
    private DataTableTypes.Labels Labels=>Arabic?new(){Search="بحث في الطلبات أو العملاء…",View="العرض",Columns="الأعمدة",Compact="مضغوط",Comfortable="مريح",Reset="مسح الفلاتر",Empty="لا توجد نتائج.",SelectAll="تحديد صفوف الصفحة",SelectRow="تحديد الطلب",ClearSelection="إلغاء التحديد",RowsPerPage="صفوف الصفحة",Previous="السابق",Next="التالي",Pagination="الصفحات",MorePages="صفحات أخرى",BulkActions="إجراءات جماعية",Results=n=>$"{n} نتائج",Selected=n=>$"{n} محدد",Page=n=>$"صفحة {n}"}:new(){Search="Search orders or customers…"};
    private void Export(int count)=>message=T($"Export started · {count} orders · CSV",$"بدء التصدير · {count} طلب · CSV");
    private void Delete(IReadOnlyList<Order> rows){var ids=rows.Select(x=>x.Id).ToHashSet();orders=orders.Where(x=>!ids.Contains(x.Id)).ToList();message=T($"Deleted {ids.Count} orders",$"تم حذف {ids.Count} طلب");}
}
