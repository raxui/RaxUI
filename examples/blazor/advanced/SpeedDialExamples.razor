<div class="row g-4">
<section class="col-md-6 col-xl-3"><h3 class="h6 fw-semibold mb-3">@T("With labels","مع تسميات")</h3><div data-dial-labels class="position-relative border rounded-4 bg-body-tertiary overflow-hidden" style="height:320px"><output class="d-block p-3 small text-body-secondary">@(last ?? T("Press the button in the corner","اضغط الزر في الزاوية"))</output><SpeedDial Class="position-absolute m-3" style="bottom:0;inset-inline-end:0"><SpeedDialTrigger Label="@T("Actions","إجراءات")" /><SpeedDialContent Label="@T("Document actions","إجراءات المستند")"><SpeedDialActions Arabic="@Arabic" Selected="Pick" /></SpeedDialContent></SpeedDial></div></section>
<section class="col-md-6 col-xl-3"><h3 class="h6 fw-semibold mb-3">@T("Sides","الاتجاهات")</h3><div data-dial-sides class="position-relative border rounded-4 bg-body-tertiary" style="height:320px">
@foreach(var side in sides){<SpeedDial Side="@side" Class="position-absolute" style="@Place(side)"><SpeedDialTrigger Size="icon" Label="@($"Open {side}")" /><SpeedDialContent><SpeedDialActions WithLabels="false" Arabic="@Arabic" Count="2" Size="icon-sm" /></SpeedDialContent></SpeedDial>}
</div></section>
<section class="col-md-6 col-xl-3"><h3 class="h6 fw-semibold mb-3">@T("Hover · controlled","تحويم · حالة متحكم بها")</h3><div data-dial-hover class="position-relative border rounded-4 bg-body-tertiary overflow-hidden" style="height:320px"><div class="p-3 vstack gap-2 small"><span class="text-body-secondary">@T("Hover the button (opens after 250 ms). The switch controls the same state.","مرر المؤشر على الزر لفتحه بعد 250 مللي ثانية. المفتاح يتحكم بالحالة نفسها.")</span><label class="d-flex align-items-center gap-2"><Switch @bind-Value="open" />@T("Open","مفتوح")</label></div><SpeedDial ActivationMode="hover" @bind-Open="open" CloseOnInteractOutside="false" Class="position-absolute m-3" style="bottom:0;inset-inline-end:0"><SpeedDialTrigger Variant="tinted" /><SpeedDialContent><SpeedDialActions Count="3" Arabic="@Arabic" /></SpeedDialContent></SpeedDial></div></section>
<section class="col-md-6 col-xl-3"><h3 class="h6 fw-semibold mb-3">بالعربية</h3><div dir="rtl" data-dial-arabic class="position-relative border rounded-4 bg-body-tertiary overflow-hidden" style="height:320px"><output class="d-block p-3 small text-body-secondary">@(arabicLast ?? "اضغط الزر في الزاوية")</output><SpeedDial Class="position-absolute m-3" style="bottom:0;inset-inline-end:0"><SpeedDialTrigger Label="إجراءات" /><SpeedDialContent Label="إجراءات المستند"><SpeedDialActions Arabic Selected="PickArabic" /></SpeedDialContent></SpeedDial></div></section>
</div>
@code {
    [Parameter] public bool Arabic { get; set; }
    private string? last, arabicLast;
    private bool open;
    private void Pick(string value)=>last=T("Picked: ","اخترت: ")+value;
    private void PickArabic(string value)=>arabicLast="اخترت: "+value;
    private static readonly string[] sides = ["top","bottom","left","right"];
    private string T(string en,string ar)=>Arabic ? ar : en;
    private static string Place(string side)=>side switch { "top"=>"bottom:1rem;left:50%;transform:translateX(-50%)", "bottom"=>"top:1rem;left:50%;transform:translateX(-50%)", "left"=>"right:1rem;top:50%;transform:translateY(-50%)", _=>"left:1rem;top:50%;transform:translateY(-50%)" };
}
