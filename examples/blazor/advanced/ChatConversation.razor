@* Built-in SVG paths from Lucide (ISC), matching the React source. *@
@implements IDisposable
<div class="vstack gap-3" data-conversation="@(Simulate ? "live" : "arabic")">
@if (Simulate) { <div class="d-flex flex-wrap align-items-center gap-2"><Toggle Size="sm" Variant="outline" @bind-Pressed="offline">@T("Simulate offline","محاكاة انقطاع الاتصال")</Toggle><span class="small text-body-secondary">@T("Send a message: Sending → Sent → Read, then a reply. Scroll up first to see the jump button.","أرسل رسالة لمشاهدة حالة الإرسال ثم الرد. مرر للأعلى لإظهار زر الرسائل الجديدة.")</span></div> }
<div dir="@(Arabic ? "rtl" : "ltr")"><Chat Labels="@Words" Class="border rounded-4 bg-body" style="@(Simulate ? "height:520px" : "height:380px")">
@if (Simulate) { <div class="d-flex align-items-center gap-2 px-3 py-2 border-bottom"><Avatar Size="sm" Name="@T("Noura Ali","نورا علي")" /><div class="lh-sm"><div class="fw-semibold text-body-emphasis small">@T("Noura Ali","نورا علي")</div><div class="text-success" style="font-size:12px">@(typing ? T("typing…","تكتب…") : T("online","متصلة"))</div></div></div> }
<ChatMessages Label="@T("Conversation messages","رسائل المحادثة")" JumpLabel="@T("New messages","رسائل جديدة")"><ChatDaySeparator>@T("Today","اليوم")</ChatDaySeparator>
@foreach(var group in Groups()) {
<ChatMessageGroup @key="group[0].Id" From="@group[0].From" Name="@(group[0].From=="other" ? T(Simulate ? "Noura" : "Customer support",Simulate ? "نورا" : "خدمة العملاء") : null)" Time="@group[^1].Time">
<Avatar>@if(group[0].From=="other"){<Avatar Size="sm" Name="@T("Noura Ali","خدمة العملاء")" Src="@(Simulate ? null : "/avatars/astronaut.jpg")" Alt="" />}</Avatar>
<ChildContent>@foreach(var message in group){<ChatBubble @key="message.Id" Status="@message.Status" OnRetry="()=>Retry(message)">@message.Body</ChatBubble>}</ChildContent>
</ChatMessageGroup>
}
@if(typing){<ChatTyping Label="@T("Noura is typing","نورا تكتب")"><Avatar><Avatar Size="sm" Name="@T("Noura Ali","نورا علي")" /></Avatar></ChatTyping>}
</ChatMessages>
<ChatComposer @bind-Value="draft" OnSend="Send" Placeholder="@T(Simulate ? "Message Noura" : "Write a message","اكتب رسالة")" SendLabel="@T("Send","إرسال")">
<Actions>@if(Simulate){<Button Type="button" Variant="ghost" Size="icon-sm" aria-label="@T("Attach a file","إرفاق ملف")" OnClick="Attach"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 11-8.5 8.5a5.5 5.5 0 0 1-7.8-7.8l9-9a3.7 3.7 0 0 1 5.2 5.2l-9 9a1.8 1.8 0 0 1-2.6-2.6l8.5-8.5" /></svg></Button>}</Actions>
</ChatComposer></Chat></div>
@if(attachmentNotice is not null){<output class="small text-body-secondary">@attachmentNotice</output>}
</div>
@code {
    [Parameter] public bool Arabic { get; set; }
    [Parameter] public bool Simulate { get; set; }
    private sealed class Message(int id,string from,string body,string time,string? status=null) { public int Id=id;public string From=from,Body=body,Time=time;public string? Status=status; }
    private readonly List<Message> messages=[];
    private readonly CancellationTokenSource lifetime=new();
    private bool offline,typing,disposed;
    private int nextId=100,replyIndex,pendingReplies;
    private string draft="";
    private string? attachmentNotice;
    private void Attach()=>attachmentNotice=T("Attachment action: connect your file picker.","اربط إجراء الإرفاق بمنتقي الملفات في تطبيقك.");
    private string T(string en,string ar)=>Arabic ? ar : en;
    private Chat.Text Words=>Arabic ? new() { Sending="جارٍ الإرسال",Sent="أُرسلت",Delivered="وصلت",Read="قُرئت",Failed="لم تُرسل",Retry="إعادة المحاولة" } : new();
    protected override void OnInitialized(){
        if(Simulate){ messages.AddRange([new(1,"other",T("Morning! Did the new accent colours make it into the build?","صباح الخير! هل أُضيفت ألوان التمييز الجديدة؟"),"9:41"),new(2,"other",T("The emerald one looks great on the glass.","اللون الزمردي جميل مع Glass."),"9:41"),new(3,"self",T("Yes, they're in. Indigo and amber too.","نعم، مع النيلي والعنبري أيضاً."),"9:43","read"),new(4,"self",T("There's also a radius setting now: five levels and square corners.","أُضيف إعداد لحواف المكونات بخمسة مستويات وزوايا مربعة."),"9:43","read"),new(5,"other",T("Nice. Can you try it in Arabic as well? مرحبا 👋","ممتاز. هل يمكنك تجربته بالعربية؟ مرحباً 👋"),"9:45")]); }
        else messages.AddRange([new(1,"other","السلام عليكم، هل وصل الطلب؟","١٠:٠٢"),new(2,"self","وعليكم السلام، نعم وصل اليوم صباحاً. شكراً لكم!","١٠:٠٥","read"),new(3,"other","رائع 🎉 رقم الطلب للمرجع: #1042","١٠:٠٦")]);
    }
    private List<List<Message>> Groups(){var groups=new List<List<Message>>();foreach(var m in messages){if(groups.Count>0&&groups[^1][0].From==m.From)groups[^1].Add(m);else groups.Add([m]);}return groups;}
    private void Send(string text){
        foreach(var m in messages.Where(m=>m.From=="self"&&m.Status!="failed"))m.Status=null;
        var message=new Message(nextId++,"self",text,DateTime.Now.ToString("h:mm",System.Globalization.CultureInfo.InvariantCulture),Simulate ? "sending" : "sent");messages.Add(message);
        if(Simulate)_=Deliver(message,offline);
    }
    private void Retry(Message message){message.Status="sending";_=Deliver(message,offline);}
    private async Task Deliver(Message message,bool fail){
        try {
            await Task.Delay(fail ? 700 : 500,lifetime.Token);
            if(fail){message.Status="failed";await InvokeAsync(StateHasChanged);return;}
            message.Status="sent";await InvokeAsync(StateHasChanged);
            await Task.Delay(600,lifetime.Token);message.Status="read";pendingReplies++;typing=true;await InvokeAsync(StateHasChanged);
            await Task.Delay(1500,lifetime.Token);pendingReplies--;typing=pendingReplies>0;
            string[] replies=Arabic ? ["ممتاز 👍","سأراجع ملف التصميم وأعود إليك.","هل يمكنك مشاركة رابط المعاينة؟","رائع، انشره!"] : ["Sounds good to me 👍","Let me check the design file and get back to you.","Can you share the link to the preview?","Perfect, ship it!"];
            messages.Add(new(nextId++,"other",replies[replyIndex++%replies.Length],DateTime.Now.ToString("h:mm",System.Globalization.CultureInfo.InvariantCulture)));await InvokeAsync(StateHasChanged);
        } catch(OperationCanceledException) when(disposed) { }
    }
    public void Dispose(){disposed=true;lifetime.Cancel();lifetime.Dispose();}
}
