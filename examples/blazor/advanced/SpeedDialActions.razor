@* Built-in SVG paths from Lucide (ISC), matching the React source. *@
@foreach (var action in actions.Take(Count)) {
<SpeedDialItem>@if (WithLabels) { <SpeedDialLabel>@(Arabic ? action.Arabic : action.Label)</SpeedDialLabel> }
<SpeedDialAction Label="@(WithLabels ? null : Arabic ? action.Arabic : action.Label)" Size="@Size" OnSelect="()=>Selected.InvokeAsync(Arabic ? action.Arabic : action.Label)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="@action.Path" /></svg></SpeedDialAction></SpeedDialItem>
}
@code {
    [Parameter] public bool Arabic { get; set; }
    [Parameter] public bool WithLabels { get; set; } = true;
    [Parameter] public int Count { get; set; } = 4;
    [Parameter] public string Size { get; set; } = "icon";
    [Parameter] public EventCallback<string> Selected { get; set; }
    private static readonly (string Label, string Arabic, string Path)[] actions = [
