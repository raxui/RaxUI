<div class="row g-5">
<div class="col-lg-6">
<h3 class="h6 fw-semibold mb-3">@T("Variants","المظاهر")</h3>
@foreach(var variant in new[]{"tinted","solid","outline"}){<div class="d-flex flex-wrap gap-2 mb-2">@foreach(var color in Colors){<Badge Variant="@variant" Color="@color">@ColorLabel(color)</Badge>}</div>}
<h3 class="h6 fw-semibold mt-4 mb-3">@T("Dots · icons · sizes","النقاط · الأيقونات · الأحجام")</h3>
<div class="d-flex flex-wrap align-items-center gap-2 mb-2"><Badge Color="danger" Ping>@T("Live","مباشر")</Badge><Badge Color="success" Dot>@T("Online","متصل")</Badge><Badge Color="neutral" Variant="outline" Dot>@T("Draft","مسودة")</Badge><Badge Variant="solid">@Icon("M5 12.5 10 17 19 7") @T("Verified","موثّق")</Badge><Badge Color="warning">@Star @T("Featured","مميّز")</Badge></div>
<div class="d-flex flex-wrap align-items-center gap-2"><Badge Size="sm">@T("Small","صغير")</Badge><Badge>@T("Default","افتراضي")</Badge><Badge Size="lg">@T("Large","كبير")</Badge><Badge Size="lg" Shape="rounded" Variant="outline" Color="neutral">v2.4.0</Badge><a href="#changelog" class="sheen-badge" data-variant="tinted" data-color="info">@T("Changelog →","سجل التغييرات ←")</a></div>
<h3 class="h6 fw-semibold mt-4 mb-3">@T("Filters","الفلاتر")</h3>
<div class="d-flex flex-wrap align-items-center gap-2">@foreach(var filter in filters){<Badge @key="filter" Size="lg" Color="neutral" OnRemove="()=>RemoveFilter(filter)" RemoveLabel="@($"{T("Remove","إزالة")} {filter}")">@filter</Badge>}@if(filters.Count<AllFilters.Length){<Button Variant="link" Size="sm" @onclick="()=>filters=AllFilters.ToList()">@T("Reset","إعادة ضبط")</Button>}</div>
</div>
<div class="col-lg-6">
<h3 class="h6 fw-semibold mb-3">@T("Counts","العدادات")</h3>
<div class="d-flex flex-wrap align-items-center gap-4">
<BadgeCount Count="messages" GetLabel="MessagesLabel"><Button Variant="secondary" Size="icon" aria-label="@T("Messages","الرسائل")" @onclick="()=>messages++">@Icon("M3 6h18v12H3zM3 6l9 7 9-7")</Button></BadgeCount>
<BadgeCount Count="128"><Button Variant="secondary" Size="icon" aria-label="@T("Notifications","الإشعارات")">@Bell</Button></BadgeCount>
<BadgeCount Count="cart" Color="primary" GetLabel="CartLabel"><Button Variant="secondary" Size="icon" aria-label="@T("Cart","السلة")" @onclick="()=>cart++">@Icon("M3 4h2l2.4 11h11L21 7H6.2M9 20h.01M18 20h.01")</Button></BadgeCount>
<BadgeCount Count="1" Dot GetLabel="ActivityLabel"><Avatar Src="/avatars/astronaut.jpg" Name="Eileen Collins" /></BadgeCount>
<div class="d-flex gap-2 ms-auto"><Button Variant="tinted" Size="sm" @onclick="()=>messages++">@T("+1 message","رسالة +1")</Button><Button Variant="ghost" Size="sm" @onclick="()=>messages=0">@T("Mark read","تحديد كمقروء")</Button></div></div>
<h3 class="h6 fw-semibold mt-4 mb-3">@T("Glass · over media","زجاجي · فوق الصور")</h3>
<div class="position-relative overflow-hidden" style="border-radius:var(--sheen-radius);max-width:360px"><img src="/avatars/coffee.jpg" alt="@T("Espresso on a red saucer","قهوة على صحن أحمر")" class="d-block w-100" style="height:180px;object-fit:cover" /><div class="position-absolute top-0 start-0 end-0 d-flex justify-content-between p-2"><Badge Variant="glass" Color="success" Dot>@T("Open now","مفتوح الآن")</Badge><Badge Variant="glass">@Star 4.9</Badge></div></div>
<div dir="rtl" class="d-flex flex-wrap align-items-center gap-2 mt-4"><Badge Color="success" Dot>متصل</Badge><Badge Color="warning">قيد المراجعة</Badge>@if(showBaghdad){<Badge Size="lg" Color="neutral" OnRemove="()=>showBaghdad=false" RemoveLabel="إزالة بغداد">بغداد</Badge>}<BadgeCount Count="5" GetLabel="NotificationLabel""><Button Variant="secondary" Size="icon" aria-label="الإشعارات">@Bell</Button></BadgeCount></div>
</div></div>
@code {
    [Parameter] public bool Arabic { get; set; }
    private static readonly string[] Colors={"primary","secondary","success","warning","danger","info","neutral"};
    private static readonly string[] AllFilters={"React","Bootstrap","Radix","SCSS","TypeScript"};
    private List<string> filters=AllFilters.ToList();private int messages=3,cart=1;private bool showBaghdad=true;
    private void RemoveFilter(string filter)=>filters.Remove(filter);
    private string T(string en,string ar)=>Arabic?ar:en;
    private string MessagesLabel(int n)=>T($"{n} unread messages",$"{n} رسائل غير مقروءة");
    private string CartLabel(int n)=>T($"{n} items in cart",$"{n} عناصر في السلة");
    private string ActivityLabel(int n)=>T("New activity","نشاط جديد");
    private string NotificationLabel(int n)=>$"{n} إشعارات";
    private string ColorLabel(string color)=>color switch{"primary"=>T("Primary","أساسي"),"secondary"=>T("Secondary","ثانوي"),"success"=>T("Paid","مدفوع"),"warning"=>T("Pending","قيد الانتظار"),"danger"=>T("Failed","فشل"),"info"=>T("Info","معلومات"),_=>T("Neutral","محايد")};
    // Built-in icon paths from Lucide (ISC).
    private RenderFragment Icon(string path)=>@<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="@path" /></svg>;
    private RenderFragment Bell=>Icon("M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.94 1.94 0 0 0 3.4 0");
    private RenderFragment Star=>Icon("m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9Z");
}
