@inherits ShellExampleBase
<div class="vstack gap-4"><BannerGroup><Banner Title="@T("New components", "مكونات جديدة")" Dismissible DismissLabel="@T("Dismiss announcement", "إخفاء الإعلان")"><ChildContent>@T("Navigation components are ready to try.", "مكونات التنقل جاهزة للتجربة.")</ChildContent><Action><Button Size="sm" OnClick="@(() => floating = true)">@T("Preview", "معاينة")</Button></Action></Banner><Banner Tone="warning" Title="@T("Maintenance", "صيانة")" Dismissible>@T("Scheduled maintenance starts at midnight.", "تبدأ الصيانة المجدولة منتصف الليل.")</Banner></BannerGroup>
<Banner Tone="success" Variant="solid" Title="@T("Changes saved", "تم الحفظ")">@T("Your workspace is up to date.", "مساحة العمل محدثة.")</Banner>
<div dir="rtl"><Banner Title="إعلان" Dismissible DismissLabel="إخفاء الإعلان العربي" @bind-Open="arabicOpen"><ChildContent>مكونات التنقل تدعم العربية والثيم الحالي.</ChildContent><Action><Button Size="sm">معرفة المزيد</Button></Action></Banner></div>
<div class="d-flex gap-2 flex-wrap"><Button Variant="outline" OnClick="@(() => arabicOpen = true)">إعادة الإعلان</Button><Button Variant="outline" OnClick="@(() => floating = true)">@T("Floating banner", "إعلان عائم")</Button></div>
<Banner @ref="tip" PersistKey="rax-demo-shell-tip" Title="@T("Remember dismissal", "تذكر الإخفاء")" Dismissible DismissLabel="@T("Dismiss remembered tip", "إخفاء النصيحة")">@T("This tip stays dismissed until you reset it.", "تبقى النصيحة مخفية حتى إعادة ضبطها.")</Banner><Button Variant="outline" OnClick="@(() => tip?.ResetAsync() ?? Task.CompletedTask)">@T("Reset remembered tip", "إعادة ضبط النصيحة")</Button>
<Banner Position="bottom" Variant="glass" Title="@T("Floating notice", "إشعار عائم")" Dismissible @bind-Open="floating"><ChildContent>@T("This banner inherits the nearest theme.", "يرث هذا الإعلان الثيم المحيط به.")</ChildContent><Action><Button Size="sm" OnClick="@(() => floating = false)">@T("Got it", "حسناً")</Button></Action></Banner></div>
@code { private bool arabicOpen = true, floating; private Banner? tip; }
