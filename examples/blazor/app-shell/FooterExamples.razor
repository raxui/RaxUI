@inherits ShellExampleBase
<div class="vstack gap-3"><label class="align-self-start">@T("Variant", "المظهر")<select class="form-select form-select-sm" @bind="variant" aria-label="Footer variant"><option>subtle</option><option>plain</option><option>glass</option></select></label>
<Footer Variant="@variant"><FooterMain><FooterBrand Name="SheenUI" Tagline="@T("Thoughtful components for your next idea.", "مكونات مدروسة لفكرتك القادمة.")" Href="#shell-home"><Logo><ShellIcon /></Logo><ChildContent><FooterSocial><FooterSocialLink Href="#shell-code" Label="GitHub" PreventDefault><ShellIcon /></FooterSocialLink><FooterSocialLink Href="#shell-mail" Label="Email" PreventDefault><ShellIcon Path="M4 4h16v16H4zM4 4l8 8 8-8" /></FooterSocialLink></FooterSocial></ChildContent></FooterBrand>
<FooterColumns>@foreach (var column in columns) { <FooterColumn Title="@T(column.English,column.Arabic)">@foreach (var link in column.Links) { <FooterLink Href="@("#shell-" + link)" PreventDefault>@link</FooterLink> }</FooterColumn> }</FooterColumns>
<FooterNewsletter Title="@T("Stay in the loop", "ابق على اطلاع")" Description="@T("Monthly updates. Use fail@example.com to try the error state.", "تحديثات شهرية. جرّب fail@example.com لعرض الخطأ.")" SubmitLabel="@T("Subscribe", "اشتراك")" SendingLabel="@T("Subscribing…", "جارٍ الاشتراك…")" SuccessMessage="@T("Thanks! Check your inbox to confirm.", "شكراً! تحقق من بريدك للتأكيد.")" InvalidMessage="@T("Enter a valid email address.", "أدخل بريداً إلكترونياً صالحاً.")" ErrorMessage="@T("Something went wrong. Try again.", "حدث خطأ. حاول مجدداً.")" OnSubscribe="Subscribe" /></FooterMain>
<FooterBottom><FooterCopyright Owner="SheenUI" /><FooterLegal Label="@T("Legal", "روابط قانونية")"><a data-enhance-nav="false" href="#shell-privacy" @onclick:preventDefault>@T("Privacy", "الخصوصية")</a><a data-enhance-nav="false" href="#shell-terms" @onclick:preventDefault>@T("Terms", "الشروط")</a></FooterLegal><FooterBackToTop Label="@T("Back to top", "العودة للأعلى")" /></FooterBottom></Footer><output class="small" data-subscription>@subscribed</output></div>
@code {
    private string variant = "subtle", subscribed = "";
    private readonly (string English, string Arabic, string[] Links)[] columns = [("Product", "المنتج", ["Components", "Examples", "Changelog"]), ("Resources", "المصادر", ["Documentation", "Community", "Support"]), ("Company", "الشركة", ["About", "Contact"])];
    private async Task Subscribe(string email) { await Task.Delay(150); if (email.StartsWith("fail@", StringComparison.OrdinalIgnoreCase)) throw new InvalidOperationException("Demo failure"); subscribed = email; }
}
