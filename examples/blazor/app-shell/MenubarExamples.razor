@inherits ShellExampleBase
<div class="border rounded-4 overflow-hidden"><div class="border-bottom p-2"><Menubar Label="@T("Editor menu", "قائمة المحرر")">
<MenubarMenu Value="file"><MenubarTrigger>@T("File", "ملف")</MenubarTrigger><MenubarContent><MenubarItem OnSelect="New">@T("New", "جديد")<MenubarShortcut>⌘N</MenubarShortcut></MenubarItem><MenubarSub><MenubarSubTrigger>@T("Open recent", "فتح ملف حديث")</MenubarSubTrigger><MenubarSubContent>@foreach (var item in recent) { <MenubarItem OnSelect="@(() => Open(item))">@item</MenubarItem> }<MenubarSeparator /><MenubarItem Disabled>@T("Clear menu", "مسح القائمة")</MenubarItem></MenubarSubContent></MenubarSub><MenubarSeparator /><MenubarItem OnSelect="@(() => status = "Saved")">@T("Save", "حفظ")<MenubarShortcut>⌘S</MenubarShortcut></MenubarItem><MenubarItem Disabled>@T("Export PDF", "تصدير PDF")</MenubarItem></MenubarContent></MenubarMenu>
<MenubarMenu Value="edit"><MenubarTrigger>@T("Edit", "تحرير")</MenubarTrigger><MenubarContent><MenubarItem OnSelect="@(() => { text = ""; status = "Cleared"; })">@T("Clear text", "مسح النص")</MenubarItem><MenubarItem OnSelect="@(() => { text += "\nHello"; status = "Inserted"; })">@T("Insert greeting", "إضافة تحية")</MenubarItem></MenubarContent></MenubarMenu>
<MenubarMenu Value="view"><MenubarTrigger>@T("View", "عرض")</MenubarTrigger><MenubarContent><MenubarCheckboxItem @bind-Checked="wrap">@T("Word wrap", "التفاف النص")</MenubarCheckboxItem><MenubarCheckboxItem @bind-Checked="ruler">@T("Show ruler", "إظهار المسطرة")</MenubarCheckboxItem><MenubarSeparator /><MenubarLabel>@T("Text size", "حجم النص")</MenubarLabel><MenubarRadioGroup @bind-Value="size" Label="Text size"><MenubarRadioItem Value="sm">@T("Small", "صغير")</MenubarRadioItem><MenubarRadioItem Value="md">@T("Medium", "متوسط")</MenubarRadioItem><MenubarRadioItem Value="lg">@T("Large", "كبير")</MenubarRadioItem></MenubarRadioGroup></MenubarContent></MenubarMenu>
</Menubar></div><div class="p-3"><div class="small text-body-secondary mb-2">@name</div>@if (ruler) { <div class="small font-monospace border-bottom mb-2">0 ···· 10 ···· 20 ···· 30 ···· 40</div> }<textarea class="form-control" rows="6" aria-label="Document" style="white-space:@(wrap ? "pre-wrap" : "pre");font-size:@(size == "sm" ? ".8rem" : size == "lg" ? "1.2rem" : "1rem")" @bind="text" @bind:event="oninput"></textarea><output class="small text-body-secondary d-block mt-2" data-editor-status>@status · @size · @wrap</output></div></div>
@code {
    private string name = "Untitled.md", text = "Menus that feel native: hover across them once one is open.", status = "Saved", size = "md";
    private bool wrap = true, ruler;
    private readonly string[] recent = ["Roadmap 2027.md", "Release notes.md", "Theme ideas.md"];
    private void New() { name = "Untitled.md"; text = ""; status = "New document"; }
    private void Open(string file) { name = file; text = "# " + file.Replace(".md", "") + "\n\nOpened from Recent."; status = "Opened " + file; }
}
