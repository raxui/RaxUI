@inherits ShellExampleBase
<div class="vstack gap-3"><div class="d-flex flex-wrap gap-3"><label>@T("Variant", "المظهر")<select class="form-select form-select-sm" @bind="variant" aria-label="Sidebar variant"><option>sidebar</option><option>floating</option><option>inset</option></select></label><label>@T("Collapse", "الطي")<select class="form-select form-select-sm" @bind="collapse" aria-label="Sidebar collapse"><option>icon</option><option>offcanvas</option><option>none</option></select></label><label>@T("Side", "الجهة")<select class="form-select form-select-sm" @bind="side" aria-label="Sidebar side"><option>start</option><option>end</option></select></label></div>
<div class="border rounded-4 overflow-hidden"><SidebarProvider StorageKey="sheen-demo-sidebar" style="--sheen-sidebar-height:460px">
<Sidebar Variant="@variant" Collapsible="@collapse" Side="@side" Label="@T("Workspace", "مساحة العمل")">
<SidebarHeader><SidebarMenuButton Size="lg" Tooltip="SheenUI"><Icon><ShellIcon /></Icon><ChildContent>SheenUI<br /><small>@T("Baghdad workspace", "مساحة عمل بغداد")</small></ChildContent></SidebarMenuButton><SidebarInput aria-label="@T("Search navigation", "البحث في التنقل")" placeholder="@T("Search…", "بحث…")" /></SidebarHeader><SidebarSeparator />
<SidebarContent><SidebarGroup><SidebarGroupLabel>@T("Workspace", "مساحة العمل")</SidebarGroupLabel><SidebarMenu>@foreach (var item in items) { <SidebarMenuItem><SidebarMenuButton Href="@("#shell-" + item.Id)" IsActive="@(page == item.Id)" OnClick="@(() => page = item.Id)" Tooltip="@T(item.English,item.Arabic)" PreventDefault><Icon><ShellIcon Path="@item.Path" /></Icon><ChildContent>@T(item.English, item.Arabic)</ChildContent></SidebarMenuButton>@if (item.Id == "inbox") { <SidebarMenuBadge>12</SidebarMenuBadge> }</SidebarMenuItem> }
<SidebarMenuCollapsible Title="@T("Reports", "التقارير")"><Icon><ShellIcon Path="M3 3v18h18M7 15l4-4 3 3 6-6" /></Icon><ChildContent>@foreach (var report in reports) { <SidebarMenuSubItem><SidebarMenuSubButton Href="@("#shell-" + report)" IsActive="@(page == report)" OnClick="@(() => page = report)" PreventDefault>@report</SidebarMenuSubButton></SidebarMenuSubItem> }</ChildContent></SidebarMenuCollapsible></SidebarMenu></SidebarGroup><SidebarGroup><SidebarGroupLabel>@T("Loading projects", "تحميل المشاريع")</SidebarGroupLabel><SidebarMenuSkeleton /><SidebarMenuSkeleton /></SidebarGroup></SidebarContent>
<SidebarFooter><SidebarMenuButton Href="#shell-settings" IsActive="@(page == "settings")" OnClick="@(() => page = "settings")" Tooltip="@T("Settings", "الإعدادات")" PreventDefault><Icon><ShellIcon Path="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M14 4v4M8 10v4M16 16v4" /></Icon><ChildContent>@T("Settings", "الإعدادات")</ChildContent></SidebarMenuButton></SidebarFooter><SidebarRail />
</Sidebar><SidebarInset><div class="d-flex align-items-center gap-2 border-bottom p-2"><SidebarTrigger Label="@T("Toggle sidebar", "تبديل الشريط الجانبي")" /><span>Workspace / @(page)</span></div><div class="p-4"><h3 class="h5" data-sidebar-page>@(page)</h3><p class="text-body-secondary">@T("Ctrl/Command+B toggles the sidebar. On phones the same links open in a Sheet. Collapse groups and select a page to see the gliding highlight.", "استخدم Ctrl/Command+B للتبديل. على الهاتف تفتح الروابط داخل Sheet. جرّب المجموعات واختيار الصفحات لرؤية التظليل المنزلق.")</p><input class="form-control" aria-label="@T("Editor", "المحرر")" placeholder="@T("Shortcuts stay out of text fields", "الاختصارات لا تتدخل أثناء الكتابة")" /></div></SidebarInset>
</SidebarProvider></div></div>
@code {
    private string page = "inbox", variant = "sidebar", collapse = "icon", side = "start";
    private readonly string[] reports = ["Overview", "Revenue", "Retention"];
    private readonly (string Id, string English, string Arabic, string Path)[] items = [("inbox", "Inbox", "الوارد", "M22 12h-6l-2 3h-4l-2-3H2M5 5h14l3 7v6H2v-6Z"), ("today", "Today", "اليوم", "M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10ZM12 1v2M12 21v2M1 12h2M21 12h2"), ("calendar", "Calendar", "التقويم", "M4 5h16v16H4zM4 9h16M8 3v4M16 3v4")];
}
