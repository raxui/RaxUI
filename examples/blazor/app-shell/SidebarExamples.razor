@inherits ShellExampleBase
@implements IDisposable
<div class="vstack gap-3" data-sidebar-main><div class="d-flex flex-wrap gap-3"><ToggleGroup Value="VariantSelection" ValueChanged="SetVariant" Required Variant="segmented" Size="sm" Label="Sidebar variant"><ToggleGroupItem Value="sidebar">Sidebar</ToggleGroupItem><ToggleGroupItem Value="floating">@T("Floating","عائم")</ToggleGroupItem><ToggleGroupItem Value="inset">Inset</ToggleGroupItem></ToggleGroup><ToggleGroup Value="CollapseSelection" ValueChanged="SetCollapse" Required Variant="segmented" Size="sm" Label="Sidebar collapse"><ToggleGroupItem Value="icon">@T("Icons","أيقونات")</ToggleGroupItem><ToggleGroupItem Value="offcanvas">Off-canvas</ToggleGroupItem></ToggleGroup><ToggleGroup Value="SideSelection" ValueChanged="SetSide" Required Variant="segmented" Size="sm" Label="Sidebar side"><ToggleGroupItem Value="start">@T("Start","البداية")</ToggleGroupItem><ToggleGroupItem Value="end">@T("End","النهاية")</ToggleGroupItem></ToggleGroup></div>
<div class="border rounded-4 overflow-hidden"><SidebarProvider StorageKey="sheen-demo-sidebar" style="--sheen-sidebar-height:600px">
<Sidebar Variant="@variant" Collapsible="@collapse" Side="@side" Label="@T("Workspace", "مساحة العمل")">
<SidebarHeader><DropdownMenu TriggerVariant="ghost" TriggerClass="sheen-sidebar-menu-button" TriggerLabel="@T("Switch workspace","تبديل مساحة العمل")"><Trigger><span class="badge bg-primary">A</span><span class="text-start">@workspace<br /><small>@T("Pro plan","خطة Pro")</small></span></Trigger><ChildContent><DropdownMenuLabel>@T("Workspaces","مساحات العمل")</DropdownMenuLabel><DropdownMenuItem OnSelect='()=>workspace="Acme Inc."'>Acme Inc.</DropdownMenuItem><DropdownMenuItem OnSelect='()=>workspace="Globex"'>Globex</DropdownMenuItem><DropdownMenuSeparator /><DropdownMenuItem OnSelect='()=>workspace=T("New workspace","مساحة جديدة")'>@T("New workspace","مساحة جديدة")</DropdownMenuItem></ChildContent></DropdownMenu><SidebarInput aria-label="@T("Search navigation", "البحث في التنقل")" placeholder="@T("Search…", "بحث…")" /></SidebarHeader><SidebarSeparator />
<SidebarContent><SidebarGroup><SidebarGroupLabel>@T("Workspace", "مساحة العمل")</SidebarGroupLabel><SidebarMenu>@foreach (var item in items) { <SidebarMenuItem><SidebarMenuButton Href="@("#shell-" + item.Id)" IsActive="@(page == item.Id)" OnClick="@(() => page = item.Id)" Tooltip="@T(item.English,item.Arabic)" PreventDefault><Icon><ShellIcon Path="@item.Path" /></Icon><ChildContent>@T(item.English, item.Arabic)</ChildContent></SidebarMenuButton>@if (item.Id == "inbox") { <SidebarMenuBadge>12</SidebarMenuBadge> }</SidebarMenuItem> }
<SidebarMenuCollapsible Title="@T("Reports", "التقارير")"><Icon><ShellIcon Path="M3 3v18h18M7 15l4-4 3 3 6-6" /></Icon><ChildContent>@foreach (var report in reports) { <SidebarMenuSubItem><SidebarMenuSubButton Href="@("#shell-" + report)" IsActive="@(page == report)" OnClick="@(() => page = report)" PreventDefault>@report</SidebarMenuSubButton></SidebarMenuSubItem> }</ChildContent></SidebarMenuCollapsible></SidebarMenu></SidebarGroup><SidebarGroup><SidebarGroupLabel>@T("Projects","المشاريع")</SidebarGroupLabel><SidebarGroupAction Label="@T("Add project","إضافة مشروع")" OnClick="AddProject"><ShellIcon Path="M12 5v14M5 12h14" /></SidebarGroupAction><SidebarMenu>@foreach(var project in projects){<SidebarMenuItem @key="project"><SidebarMenuButton Href="#project" IsActive="@(page==project)" OnClick="()=>page=project" PreventDefault Tooltip="@project"><Icon><ShellIcon Path="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18" /></Icon><ChildContent>@project</ChildContent></SidebarMenuButton><DropdownMenu TriggerVariant="ghost" TriggerClass="sheen-sidebar-menu-action" TriggerLabel="@($"{project} {T("options","خيارات")}")"><Trigger><ShellIcon Path="M5 12h.01M12 12h.01M19 12h.01" /></Trigger><ChildContent><DropdownMenuItem OnSelect="()=>page=project">@T("Open","فتح")</DropdownMenuItem><DropdownMenuItem OnSelect="()=>RenameProject(project)">@T("Rename","إعادة تسمية")</DropdownMenuItem><DropdownMenuSeparator /><DropdownMenuItem OnSelect="()=>projects.Remove(project)">@T("Delete","حذف")</DropdownMenuItem></ChildContent></DropdownMenu></SidebarMenuItem>}</SidebarMenu></SidebarGroup>
<SidebarGroup><SidebarGroupLabel>@T("Favorites","المفضلة")</SidebarGroupLabel><SidebarMenu>@if(loading){<SidebarMenuItem><SidebarMenuSkeleton /></SidebarMenuItem><SidebarMenuItem><SidebarMenuSkeleton /></SidebarMenuItem>}else{@foreach(var favorite in new[]{"Q4 roadmap","Hiring plan"}){<SidebarMenuItem><SidebarMenuButton Href="#favorite" IsActive="@(page==favorite)" OnClick="()=>page=favorite" PreventDefault Tooltip="@favorite"><Icon><ShellIcon Path="m12 3 2.8 5.7 6.2.9-4.5 4.4 1 6.2L12 17.3 6.5 20.2l1-6.2L3 9.6l6.2-.9z" /></Icon><ChildContent>@favorite</ChildContent></SidebarMenuButton></SidebarMenuItem>}}</SidebarMenu></SidebarGroup></SidebarContent>
<SidebarFooter><SidebarMenuButton Href="#shell-settings" IsActive="@(page == "settings")" OnClick="@(() => page = "settings")" Tooltip="@T("Settings", "الإعدادات")" PreventDefault><Icon><ShellIcon Path="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M14 4v4M8 10v4M16 16v4" /></Icon><ChildContent>@T("Settings", "الإعدادات")</ChildContent></SidebarMenuButton><SidebarMenuButton Size="lg" Tooltip="Noura Al-Qahtani"><Icon><Avatar Size="sm" Name="Noura Al-Qahtani" Src="/avatars/astronaut.jpg" /></Icon><ChildContent><strong>Noura Al-Qahtani</strong><br /><small>noura@acme.co</small></ChildContent></SidebarMenuButton></SidebarFooter><SidebarRail />
</Sidebar><SidebarInset><div class="d-flex align-items-center gap-2 border-bottom p-2"><SidebarTrigger Label="@T("Toggle sidebar", "تبديل الشريط الجانبي")" /><span>Workspace / @(page)</span></div><div class="p-4"><h3 class="h5" data-sidebar-page>@(page)</h3><p class="text-body-secondary">@T("Ctrl/Command+B toggles the sidebar. On phones the same links open in a Sheet. Collapse groups and select a page to see the gliding highlight.", "استخدم Ctrl/Command+B للتبديل. على الهاتف تفتح الروابط داخل Sheet. جرّب المجموعات واختيار الصفحات لرؤية التظليل المنزلق.")</p><input class="form-control" aria-label="@T("Editor", "المحرر")" placeholder="@T("Shortcuts stay out of text fields", "الاختصارات لا تتدخل أثناء الكتابة")" /><div class="row g-3 mt-2">@for(var i=0;i<3;i++){<div class="col-sm-4"><div class="border rounded-3 bg-body-tertiary" style="height:96px"></div></div>}</div><div class="border rounded-3 bg-body-tertiary mt-3" style="height:180px"></div></div></SidebarInset>
</SidebarProvider></div></div>
<section class="mt-4"><h3 class="h6">بالعربية</h3><div dir="rtl" class="overflow-hidden border rounded-4 bg-body"><SidebarProvider Shortcut="@null" style="--sheen-sidebar-height:320px;--sheen-sidebar-width:14rem"><Sidebar Collapsible="icon" Label="القائمة"><SidebarContent><SidebarGroup><SidebarGroupLabel>مساحة العمل</SidebarGroupLabel><SidebarMenu>@foreach(var text in new[]{"الرئيسية","الرسائل","التقويم","التقارير"}){<SidebarMenuItem><SidebarMenuButton Href="#ar" IsActive="@(arabicPage==text)" Tooltip="@text" OnClick="()=>arabicPage=text" PreventDefault><Icon><ShellIcon /></Icon><ChildContent>@text</ChildContent></SidebarMenuButton>@if(text=="الرسائل"){<SidebarMenuBadge>3</SidebarMenuBadge>}</SidebarMenuItem>}</SidebarMenu></SidebarGroup></SidebarContent><SidebarRail /></Sidebar><SidebarInset><header class="d-flex align-items-center gap-2 px-3 py-2 border-bottom"><SidebarTrigger Label="تبديل القائمة العربية" /><strong>@arabicPage</strong></header><div class="p-3 small text-body-secondary">الشريط على اليمين، ويطوى إلى أيقونات تظهر أسماؤها عند المرور عليها.</div></SidebarInset></SidebarProvider></div></section>
@code {
    private IReadOnlyList<string> VariantSelection=>new[]{variant};private IReadOnlyList<string> CollapseSelection=>new[]{collapse};private IReadOnlyList<string> SideSelection=>new[]{side};
    private void SetVariant(IReadOnlyList<string> values){if(values.Count>0)variant=values[0];}private void SetCollapse(IReadOnlyList<string> values){if(values.Count>0)collapse=values[0];}private void SetSide(IReadOnlyList<string> values){if(values.Count>0)side=values[0];}
    private string workspace="Acme Inc.",arabicPage="الرئيسية";private bool loading=true;
    private readonly List<string> projects=new(){"Design system","Marketing site","Mobile app"};private int nextProject=4;
    private readonly CancellationTokenSource lifetime=new();
    private void AddProject()=>projects.Add($"Project {nextProject++}");
    private void RenameProject(string name){var index=projects.IndexOf(name);if(index>=0){var renamed=name+" (renamed)";projects[index]=renamed;if(page==name)page=renamed;}}
    protected override async Task OnAfterRenderAsync(bool firstRender){if(!firstRender)return;try{await Task.Delay(1400,lifetime.Token);loading=false;StateHasChanged();}catch(OperationCanceledException){}}
    public void Dispose(){lifetime.Cancel();lifetime.Dispose();}

    private string page = "inbox", variant = "sidebar", collapse = "icon", side = "start";
    private readonly string[] reports = ["Overview", "Revenue", "Retention"];
    private readonly (string Id, string English, string Arabic, string Path)[] items = [("inbox", "Inbox", "الوارد", "M22 12h-6l-2 3h-4l-2-3H2M5 5h14l3 7v6H2v-6Z"), ("today", "Today", "اليوم", "M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10ZM12 1v2M12 21v2M1 12h2M21 12h2"), ("calendar", "Calendar", "التقويم", "M4 5h16v16H4zM4 9h16M8 3v4M16 3v4")];
}
