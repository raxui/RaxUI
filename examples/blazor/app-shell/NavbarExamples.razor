@inherits ShellExampleBase
<div class="vstack gap-3" data-navbar-site>
<h3 class="h6 fw-semibold mb-0">@T("Site · scroll inside the frame","موقع · مرّر داخل الإطار")</h3>
<div class="d-flex flex-wrap gap-2"><ToggleGroup Value="VariantSelection" ValueChanged="SetVariant" Required Variant="segmented" Size="sm" Label="Navbar variant"><ToggleGroupItem Value="transparent">@T("Transparent","شفاف")</ToggleGroupItem><ToggleGroupItem Value="glass">Glass</ToggleGroupItem><ToggleGroupItem Value="solid">@T("Solid","مصمت")</ToggleGroupItem></ToggleGroup><Toggle Size="sm" Variant="outline" @bind-Pressed="floating">@T("Floating","عائم")</Toggle><Toggle Size="sm" Variant="outline" @bind-Pressed="hide">@T("Hide on scroll","إخفاء عند التمرير")</Toggle></div>
<div id="@scrollId" class="border rounded-4 position-relative" style="height:460px;overflow:auto;isolation:isolate">
<Navbar Variant="@variant" Floating="@floating" HideOnScroll="@hide" ScrollContainer="@("#" + scrollId)" Expand="lg">
    <NavbarBrand Href="#shell-home" PreventDefault><span class="badge bg-primary">S</span> SheenUI</NavbarBrand>
    <NavbarLinks Label="@T("Main", "التنقل الرئيسي")">@foreach (var item in links) { <NavbarLink Href="@("#shell-" + item.Id)" Active="@(page == item.Id)" OnClick="@(() => page = item.Id)" PreventDefault>@T(item.English, item.Arabic)</NavbarLink> }</NavbarLinks>
    <NavbarActions><Button Size="sm" Variant="ghost" Class="d-none d-sm-inline-flex">@T("Sign in","تسجيل الدخول")</Button><Button Size="sm">@T("Get started", "ابدأ الآن")</Button></NavbarActions><NavbarToggle OpenLabel="@T("Open menu", "فتح القائمة")" CloseLabel="@T("Close menu", "إغلاق القائمة")" />
    <NavbarMenu Label="@T("Mobile navigation", "التنقل على الهاتف")">@foreach (var item in links) { <NavbarMenuLink Href="@("#shell-" + item.Id)" Active="@(page == item.Id)" OnClick="@(() => page = item.Id)" PreventDefault>@T(item.English, item.Arabic)</NavbarMenuLink> }</NavbarMenu>
</Navbar>
<section class="bg-primary-subtle" style="margin-top:calc(-1 * var(--sheen-navbar-height,3.75rem) - 1px);padding:6rem 1.5rem 3rem"><div class="mx-auto" style="max-width:560px"><div class="small fw-semibold text-primary-emphasis mb-2">@(page)</div><h3 class="h2 fw-bold">@T("Components you own","مكونات تمتلكها")</h3><p class="text-body-secondary mb-0">@T("Copy them in, keep the code. Glass, springs and right-to-left from the first line.","انسخ المكونات واحتفظ بالكود، مع الزجاج والحركة ودعم العربية.")</p></div></section><div class="p-4"><p class="text-body-secondary">@T("Hover the links to see the highlight glide. Select a page, resize the window, then scroll down and up.", "مرر المؤشر لرؤية التظليل المنزلق. اختر صفحة وغيّر حجم النافذة ثم مرر للأسفل والأعلى.")</p>@for (var i = 0; i < 8; i++) { <p class="text-body-secondary py-2">@T("The bar turns to glass after scrolling, hides while reading down and returns when you scroll up.", "يتحول الشريط إلى Glass بعد التمرير ويختفي أثناء القراءة ويعود عند التمرير للأعلى.")</p> }</div>
</div><output class="small text-body-secondary" data-navbar-page>@(page)</output>
</div>
<div class="row g-4 mt-1">
<section class="col-lg-5"><h3 class="h6 fw-semibold mb-3">@T("Phone width · menu","عرض الهاتف · قائمة")</h3><div data-navbar-phone class="border rounded-4 bg-body overflow-hidden position-relative" style="height:420px;max-width:380px"><Navbar Expand="never" Variant="glass"><NavbarBrand Href="#home" PreventDefault><span class="badge bg-primary">S</span> SheenUI</NavbarBrand><NavbarActions><Avatar Size="sm" Src="/avatars/astronaut.jpg" Name="Noura Al-Qahtani" /></NavbarActions><NavbarToggle OpenLabel="@T("Open phone menu","فتح قائمة الهاتف")" CloseLabel="@T("Close phone menu","إغلاق قائمة الهاتف")" /><NavbarMenu Label="@T("Phone navigation","التنقل على الهاتف")">@foreach(var item in links){<NavbarMenuLink Href="@("#phone-"+item.Id)" Active="@(phonePage==item.Id)" OnClick="()=>phonePage=item.Id" PreventDefault>@T(item.English,item.Arabic)</NavbarMenuLink>}</NavbarMenu></Navbar><div class="p-4"><h4 class="h5 fw-semibold" data-navbar-phone-page>@phonePage</h4><p class="small text-body-secondary">@T("Below the breakpoint the links fold into a menu that drops under the bar; the items rise in one by one.","أسفل نقطة التوقف تُعرض الروابط في قائمة تحت الشريط وتظهر العناصر بالتتابع.")</p></div></div></section>
<section class="col-lg-7"><h3 class="h6 fw-semibold mb-3">بالعربية · عائم · روابط في الوسط</h3><div dir="rtl" class="border rounded-4 overflow-hidden bg-body-tertiary" style="height:200px"><Navbar Floating Variant="glass" Expand="lg"><NavbarBrand Href="#home" PreventDefault>متجر</NavbarBrand><NavbarLinks Label="الرئيسية" Align="center">@foreach(var text in arabicLinks){<NavbarLink Href="#ar" Active="@(arabicPage==text)" OnClick="()=>arabicPage=text" PreventDefault>@text</NavbarLink>}</NavbarLinks><NavbarActions><Button Size="sm">تسوّق الآن</Button></NavbarActions><NavbarToggle OpenLabel="فتح القائمة العربية" CloseLabel="إغلاق القائمة العربية" /><NavbarMenu Label="القائمة العربية">@foreach(var text in arabicLinks){<NavbarMenuLink Href="#ar" Active="@(arabicPage==text)" OnClick="()=>arabicPage=text" PreventDefault>@text</NavbarMenuLink>}</NavbarMenu></Navbar></div></section>
</div>
@code {
    private IReadOnlyList<string> VariantSelection=>new[]{variant};
    private void SetVariant(IReadOnlyList<string> values){if(values.Count>0)variant=values[0];}
    private string phonePage="docs",arabicPage="الرئيسية";
    private static readonly string[] arabicLinks={"الرئيسية","المنتجات","العروض","تواصل"};
    private string variant = "transparent", page = "product"; private bool floating, hide = true;
    private readonly string scrollId = "shell-scroll-" + Guid.NewGuid().ToString("N");
    private readonly (string Id, string English, string Arabic)[] links = [("product", "Product", "المنتج"), ("pricing", "Pricing", "الأسعار"), ("docs", "Docs", "التوثيق"), ("blog", "Blog", "المدونة")];
}
