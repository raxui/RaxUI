@inherits ShellExampleBase
<div class="vstack gap-4"><div class="d-flex align-items-center justify-content-between border rounded-4 p-2"><strong class="px-2">SheenUI</strong><NavigationMenu Label="@T("Site navigation", "تنقل الموقع")"><NavigationMenuList>
<NavigationMenuItem Value="components"><NavigationMenuTrigger>@T("Components", "المكونات")</NavigationMenuTrigger><NavigationMenuContent><ul class="sheen-nav-grid">@foreach (var item in products) { <NavigationMenuListItem Href="@("#shell-" + item.English)" Title="@T(item.English, item.Arabic)" Description="@T(item.Description, item.ArabicDescription)" OnClick="@(() => selected = item.English)" PreventDefault><Icon><ShellIcon /></Icon></NavigationMenuListItem> }</ul></NavigationMenuContent></NavigationMenuItem>
<NavigationMenuItem Value="solutions"><NavigationMenuTrigger>@T("Solutions", "الحلول")</NavigationMenuTrigger><NavigationMenuContent><ul class="sheen-nav-grid" style="--sheen-nav-columns:1">@foreach (var item in solutions) { <NavigationMenuListItem Href="#shell-solution" Title="@T(item.English, item.Arabic)" Description="@T("Ready to compose", "جاهز للبناء")" OnClick="@(() => selected = item.English)" PreventDefault /> }</ul></NavigationMenuContent></NavigationMenuItem>
<NavigationMenuItem><NavigationMenuLink Href="#shell-docs" TriggerStyle OnClick="@(() => selected = "Docs")" PreventDefault>@T("Docs", "التوثيق")</NavigationMenuLink></NavigationMenuItem><NavigationMenuIndicator />
</NavigationMenuList></NavigationMenu></div><output class="small text-body-secondary" data-navigation-selection>@selected</output>
<div dir="rtl"><p class="small fw-semibold">بالعربية</p><NavigationMenu Label="المتجر"><NavigationMenuList><NavigationMenuItem Value="departments"><NavigationMenuTrigger>الأقسام</NavigationMenuTrigger><NavigationMenuContent><ul class="sheen-nav-grid"><NavigationMenuListItem Href="#shell-books" Title="الكتب" Description="روايات وكتب علمية ومراجع." PreventDefault /><NavigationMenuListItem Href="#shell-art" Title="الفنون" Description="أدوات رسم وخط عربي." PreventDefault /><NavigationMenuListItem Href="#shell-electronics" Title="الإلكترونيات" Description="هواتف وحواسيب وملحقات." PreventDefault /><NavigationMenuListItem Href="#shell-gifts" Title="الهدايا" Description="تغليف مجاني مع كل طلب." PreventDefault /></ul></NavigationMenuContent></NavigationMenuItem><NavigationMenuItem Value="offers"><NavigationMenuTrigger>العروض</NavigationMenuTrigger><NavigationMenuContent><ul class="sheen-nav-grid" style="--sheen-nav-columns:1"><NavigationMenuListItem Href="#shell-sale" Title="عروض الأسبوع" Description="توصيل داخل العراق." PreventDefault /></ul></NavigationMenuContent></NavigationMenuItem></NavigationMenuList></NavigationMenu></div></div>
@code {
    private string selected = "Components";
    private readonly (string English, string Arabic, string Description, string ArabicDescription)[] products = [("Forms", "النماذج", "Fields, selection and validation.", "الحقول والاختيار والتحقق."), ("Data", "البيانات", "Tables and charts.", "الجداول والرسوم."), ("Overlays", "النوافذ", "Dialogs, sheets and popovers.", "الحوار والشيت والقوائم."), ("Theming", "الثيم", "Accents and dark mode.", "الألوان والوضع الداكن.")];
    private readonly (string English, string Arabic)[] solutions = [("Dashboards", "لوحات التحكم"), ("Arabic products", "منتجات عربية"), ("Secure apps", "تطبيقات آمنة")];
}
