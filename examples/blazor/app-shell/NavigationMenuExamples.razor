@inherits ShellExampleBase
<div class="vstack gap-4"><h3 class="h6 fw-semibold">@T("Site header · hover or click · the panel glides and resizes","ترويسة الموقع · مرّر أو اضغط · تتحرك اللوحة ويتغير حجمها")</h3><div class="d-flex align-items-center justify-content-between border rounded-4 p-2 position-relative"><strong class="px-2">SheenUI</strong><NavigationMenu Class="@(ready?"d-none d-md-block":null)" Label="@T("Site navigation", "تنقل الموقع")"><NavigationMenuList>
<NavigationMenuItem Value="components"><NavigationMenuTrigger>@T("Components", "المكونات")</NavigationMenuTrigger><NavigationMenuContent><div class="d-flex flex-column flex-sm-row gap-2"><NavigationMenuLink Class="sheen-nav-feature" Href="#get-started" OnClick='()=>selected="Get started"' PreventDefault><span class="sheen-nav-item-icon"><ShellIcon Path="M13 2 3 14h9l-1 8 10-12h-9z" /></span><strong class="mt-auto">@T("Get started","ابدأ الآن")</strong><span class="small text-body-secondary">@T("Copy a component, keep the code. Bootstrap underneath.","انسخ المكوّن واحتفظ بالكود، مبني على Bootstrap.")</span></NavigationMenuLink><ul class="sheen-nav-grid">@foreach (var item in products) { <NavigationMenuListItem Href="@("#shell-" + item.English)" Title="@T(item.English, item.Arabic)" Description="@T(item.Description, item.ArabicDescription)" OnClick="@(() => selected = item.English)" PreventDefault><Icon><ShellIcon Path="@ProductPath(item.English)" /></Icon></NavigationMenuListItem> }</ul></div></NavigationMenuContent></NavigationMenuItem>
<NavigationMenuItem Value="solutions"><NavigationMenuTrigger>@T("Solutions", "الحلول")</NavigationMenuTrigger><NavigationMenuContent><ul class="sheen-nav-grid" style="--sheen-nav-columns:1">@foreach (var item in solutions) { <NavigationMenuListItem Href="#shell-solution" Title="@T(item.English, item.Arabic)" Description="@T("Ready to compose", "جاهز للبناء")" OnClick="@(() => selected = item.English)" PreventDefault /> }</ul></NavigationMenuContent></NavigationMenuItem>
<NavigationMenuItem Value="resources"><NavigationMenuTrigger>@T("Resources","الموارد")</NavigationMenuTrigger><NavigationMenuContent><ul class="list-unstyled m-0" style="width:12rem">@foreach(var resource in resources){<li><NavigationMenuLink Href="#resource" Active='@(resource=="Changelog")' OnClick="()=>selected=resource" PreventDefault>@resource</NavigationMenuLink></li>}</ul></NavigationMenuContent></NavigationMenuItem>
<NavigationMenuItem><NavigationMenuLink Href="#shell-pricing" TriggerStyle Active OnClick="@(() => selected = "Pricing")" PreventDefault>@T("Pricing", "الأسعار")</NavigationMenuLink></NavigationMenuItem><NavigationMenuIndicator />
</NavigationMenuList></NavigationMenu><div class="d-none d-md-flex gap-2"><Button Size="sm" Variant="ghost">@T("Sign in","تسجيل الدخول")</Button><Button Size="sm">@T("Get started","ابدأ الآن")</Button></div><div class="d-md-none"><MenuToggle @bind-Open="mobileOpen" OpenLabel="@T("Open site navigation","فتح تنقل الموقع")" CloseLabel="@T("Close site navigation","إغلاق تنقل الموقع")" aria-controls="@mobileId" /><div id="@mobileId" hidden="@(!mobileOpen)" class="position-absolute start-0 end-0 top-100 px-2" style="z-index:10"><Accordion Class="mt-2 px-3 bg-body border rounded-4"><AccordionItem Title="@T("Components","المكونات")">@foreach(var item in products){<Button Variant="link" Class="d-block" @onclick="()=>ChooseMobile(item.English)">@T(item.English,item.Arabic)</Button>}</AccordionItem><AccordionItem Title="@T("Solutions","الحلول")">@foreach(var item in solutions){<Button Variant="link" Class="d-block" @onclick="()=>ChooseMobile(item.English)">@T(item.English,item.Arabic)</Button>}</AccordionItem><AccordionItem Title="@T("Resources","الموارد")">@foreach(var resource in resources){<Button Variant="link" Class="d-block" @onclick="()=>ChooseMobile(resource)">@resource</Button>}</AccordionItem></Accordion></div></div></div><output class="small text-body-secondary" data-navigation-selection>@selected</output>
<div dir="rtl"><p class="small fw-semibold">بالعربية</p><NavigationMenu Label="المتجر"><NavigationMenuList><NavigationMenuItem Value="departments"><NavigationMenuTrigger>الأقسام</NavigationMenuTrigger><NavigationMenuContent><ul class="sheen-nav-grid"><NavigationMenuListItem Href="#shell-books" Title="الكتب" Description="روايات وكتب علمية ومراجع." PreventDefault /><NavigationMenuListItem Href="#shell-art" Title="الفنون" Description="أدوات رسم وخط عربي." PreventDefault /><NavigationMenuListItem Href="#shell-electronics" Title="الإلكترونيات" Description="هواتف وحواسيب وملحقات." PreventDefault /><NavigationMenuListItem Href="#shell-gifts" Title="الهدايا" Description="تغليف مجاني مع كل طلب." PreventDefault /></ul></NavigationMenuContent></NavigationMenuItem><NavigationMenuItem Value="offers"><NavigationMenuTrigger>العروض</NavigationMenuTrigger><NavigationMenuContent><ul class="sheen-nav-grid" style="--sheen-nav-columns:1"><NavigationMenuListItem Href="#shell-sale" Title="عروض الأسبوع" Description="توصيل داخل العراق." PreventDefault /></ul></NavigationMenuContent></NavigationMenuItem><NavigationMenuItem><NavigationMenuLink Href="#contact" TriggerStyle PreventDefault>تواصل معنا</NavigationMenuLink></NavigationMenuItem></NavigationMenuList></NavigationMenu></div></div>
@code {
    private static string ProductPath(string name)=>name switch{"Forms"=>"M4 4h16v16H4zM8 9h8M8 13h8M8 17h4","Data"=>"M3 3v18h18M7 15l4-4 3 3 6-6","Overlays"=>"m12 2 10 5-10 5L2 7zM2 12l10 5 10-5M2 17l10 5 10-5",_=>"M12 22a10 10 0 1 1 10-10c0 2.8-2.2 4-4 4h-2a2 2 0 0 0-1 3.7A1.5 1.5 0 0 1 12 22z"};
    private bool ready;
    protected override void OnAfterRender(bool firstRender){if(firstRender){ready=true;StateHasChanged();}}
    private bool mobileOpen;private readonly string mobileId="shell-mobile-nav-"+Guid.NewGuid().ToString("N");
    private static readonly string[] resources={"Documentation","Changelog","Figma kit","Examples","Blog"};
    private void ChooseMobile(string value){selected=value;mobileOpen=false;}

    private string selected = "Components";
    private readonly (string English, string Arabic, string Description, string ArabicDescription)[] products = [("Forms", "النماذج", "Fields, selection and validation.", "الحقول والاختيار والتحقق."), ("Data", "البيانات", "Tables and charts.", "الجداول والرسوم."), ("Overlays", "النوافذ", "Dialogs, sheets and popovers.", "الحوار والشيت والقوائم."), ("Theming", "الثيم", "Accents and dark mode.", "الألوان والوضع الداكن.")];
    private readonly (string English, string Arabic)[] solutions = [("Dashboards", "لوحات التحكم"), ("Arabic products", "منتجات عربية"), ("Secure apps", "تطبيقات آمنة")];
}
