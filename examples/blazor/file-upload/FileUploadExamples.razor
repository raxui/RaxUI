@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
<div class="row g-4">
<div class="col-lg-7 vstack gap-4">
<section><h3 class="h6">@T("Drop zone · upload queue","منطقة إفلات · طابور الرفع")</h3><p class="small text-body-secondary">@T("Drop, click or focus and paste a screenshot. Three upload at a time; files with “fail” in the name fail once so you can retry.","اسحب الملفات أو تصفّح أو الصق صورة بعد التركيز. تُرفع ثلاثة ملفات معاً؛ يفشل الملف الذي يحتوي اسمه على fail أول مرة لتجربة إعادة المحاولة.")</p>
<FileUpload Variant="dropzone" @bind-Value="documents" MaxFiles="6" MaxSize="10485760" Accept=".pdf,.doc,.docx,.xlsx,.csv,.zip,image/*" Upload="FakeUpload" Labels="@CurrentLabels" aria-label="@T("Upload documents","رفع المستندات")" /></section>
<section><h3 class="h6">@T("Photos · grid","الصور · شبكة")</h3><FileUpload Variant="compact" Layout="grid" Title="@T("Add photos","إضافة صور")" Hint="@T("Images · up to 8 MB · 12 files max","صور · حتى 8 MB · 12 ملفاً كحد أقصى")" @bind-Value="photos" Preview="PhotoPreview" MaxFiles="12" MaxSize="8388608" Accept="image/*" Upload="FakeUpload" Labels="@CurrentLabels" /></section>
</div>
<div class="col-lg-5 vstack gap-4">
<section><h3 class="h6">@T("With EditForm + validation","داخل EditForm مع التحقق")</h3>
<EditForm Context="formContext" Model="application" OnValidSubmit="Send" class="vstack gap-3"><DataAnnotationsValidator />
<Field Id="upload-cv" For="@(()=>application.Cv)"><FieldLabel>CV</FieldLabel><FileUpload @key="application" Variant="compact" Title="@T("Attach your CV","إرفاق السيرة الذاتية")" @bind-Value="application.Cv" MaxFiles="1" MaxSize="2097152" Accept=".pdf,.doc,.docx" Labels="@CurrentLabels" /><FieldDescription>@T("Choosing another file replaces this one.","اختيار ملف آخر يستبدل الملف الحالي.")</FieldDescription><FieldError /></Field>
<div class="d-flex gap-2"><Button type="submit">@T("Send application","إرسال الطلب")</Button><Button type="button" Variant="ghost" @onclick="Reset">@T("Reset","إعادة ضبط")</Button></div>
<output role="status">@submitted</output></EditForm>
</section>
<section dir="rtl"><h3 class="h6">بالعربية</h3><FileUpload Variant="dropzone" @bind-Value="arabicFiles" Accept="image/*,.pdf" MaxSize="5242880" MaxFiles="4" Upload="FakeUpload" Labels="ArabicLabels" aria-label="رفع المرفقات" /></section>
</div></div>
@code {
    [Parameter] public bool Arabic { get; set; }
    [Parameter] public IReadOnlyList<IBrowserFile> InitialPhotos { get; set; } = Array.Empty<IBrowserFile>();
    private IReadOnlyList<IBrowserFile> documents=Array.Empty<IBrowserFile>(),photos=Array.Empty<IBrowserFile>(),arabicFiles=Array.Empty<IBrowserFile>();
    private Application application=new();
    private string submitted="";
    private readonly Dictionary<IBrowserFile,int> attempts=new(ReferenceEqualityComparer.Instance);
    protected override void OnInitialized(){photos=InitialPhotos;}
    public sealed class Application{[MinLength(1,ErrorMessage="Attach your CV. / أرفق سيرتك الذاتية.")] public IReadOnlyList<IBrowserFile> Cv { get; set; }=Array.Empty<IBrowserFile>();}
    public sealed class SamplePhoto(string name,byte[] content,string url):IBrowserFile
    {
        public string Name=>name; public long Size=>content.Length; public DateTimeOffset LastModified=>DateTimeOffset.UnixEpoch; public string ContentType=>"image/jpeg"; public string Url=>url;
        public Stream OpenReadStream(long maxAllowedSize=512000,CancellationToken cancellationToken=default){cancellationToken.ThrowIfCancellationRequested();if(Size>maxAllowedSize)throw new IOException("File exceeds the allowed size.");return new MemoryStream(content,false);}
    }
    private string? PhotoPreview(IBrowserFile file)=>file is SamplePhoto photo?photo.Url:null;
    private async Task FakeUpload(IBrowserFile file,FileUploadQueue.UploadContext context)
    {
        var attempt=attempts.GetValueOrDefault(file)+1;attempts[file]=attempt;
        // Read selected files too, so the sample exercises InputFile handles across picker batches.
        await using(var stream=file.OpenReadStream(10*1024*1024,context.CancellationToken)){var buffer=new byte[1];await stream.ReadAsync(buffer,context.CancellationToken);}
        for(var step=1;step<=15;step++){await Task.Delay(120,context.CancellationToken);if(file.Name.Contains("fail",StringComparison.OrdinalIgnoreCase)&&attempt==1&&step==8)throw new IOException(T("Network error — try again","خطأ في الشبكة — أعد المحاولة"));context.OnProgress(step*100d/15);}
    }
    private void Send()=>submitted=T($"Sent with {application.Cv[0].Name}",$"تم الإرسال مع {application.Cv[0].Name}");
    private void Reset(){application=new();submitted="";}
    private string T(string en,string ar)=>Arabic?ar:en;
    private FileUploadQueue.Text CurrentLabels=>Arabic?ArabicLabels:EnglishLabels;
    private static readonly FileUploadQueue.Text EnglishLabels=new();
    private static readonly FileUploadQueue.Text ArabicLabels=new(){Title="اسحب الملفات وأفلتها هنا أو",Browse="تصفّح",Compact="إرفاق ملفات",AnyFile="أي ملف",UpTo="حتى",MaxFiles="ملفات كحد أقصى",Files="ملفات",Remove="إزالة",RemoveAll="إزالة الكل",Cancel="إلغاء الرفع",Retry="إعادة المحاولة",Dismiss="إغلاق",Queued="في الانتظار…",Uploading="جارٍ الرفع…",Success="تم الرفع",Cancelled="أُلغي الرفع",Failed="فشل الرفع",RejectType="نوع الملف غير مسموح",RejectLarge="الملف أكبر من الحجم المسموح",RejectMany="تجاوزت عدد الملفات المسموح",Added="أُضيفت الملفات"};
}
