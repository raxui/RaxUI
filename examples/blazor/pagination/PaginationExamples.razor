<div class="row g-5"><div class="col-lg-7">
<section><h3 class="h6 fw-semibold mb-3">@T("Results","النتائج")</h3><Pagination @bind-Page="page" PageCount="20" Label="@T("Results pagination","صفحات النتائج")" /><p class="text-body-secondary small text-center mt-2 mb-0" role="status">@T($"Showing {(page-1)*20+1}–{Math.Min(page*20,386)} of 386 results",$"عرض {(page-1)*20+1}–{Math.Min(page*20,386)} من 386 نتيجة")</p></section>
<section><h3 class="h6 fw-semibold mt-5 mb-3">@T("Plain · small","بسيط · صغير")</h3><Pagination Variant="plain" Size="sm" @bind-Page="plain" PageCount="12" Siblings="2" IconOnly Label="@T("Small pagination","صفحات صغيرة")" /></section>
<section dir="rtl"><h3 class="h6 fw-semibold mt-5 mb-3">النتائج</h3><Pagination @bind-Page="arabic" PageCount="9" Label="ترقيم الصفحات" PreviousLabel="السابق" NextLabel="التالي" MoreLabel="صفحات أخرى" FormatPage="ArabicNumber" GetPageLabel="ArabicPage" /></section>
</div><div class="col-lg-5"><section><h3 class="h6 fw-semibold mb-3">@T("Compact","مختصر")</h3><div class="d-flex align-items-center justify-content-between gap-3"><span class="text-body-secondary small">@T("Photos","الصور")</span><Pagination Layout="compact" IconOnly @bind-Page="compact" PageCount="12" Label="@T("Photo pagination","صفحات الصور")" /></div></section>
<section><h3 class="h6 fw-semibold mt-5 mb-3">@T("Composable · links","تركيب · روابط")</h3><Pagination Variant="plain" Page="2" PageCount="3" GetHref="LinkHref" Label="@T("Linked pages","روابط الصفحات")" /></section></div></div>
@code {
    [Parameter] public bool Arabic { get; set; }
    private int page=4,plain=6,arabic=3,compact=3;
    private string T(string en,string ar)=>Arabic?ar:en;
    private static string ArabicNumber(int value)=>string.Concat(value.ToString(System.Globalization.CultureInfo.InvariantCulture).Select(c=>c is >= '0' and <= '9'?(char)('٠'+c-'0'):c));
    private static string ArabicPage(int value)=>$"الصفحة {ArabicNumber(value)}";
    private static string LinkHref(int value)=>$"/?page={value}#pagination";
}
