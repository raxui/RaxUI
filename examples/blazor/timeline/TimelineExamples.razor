<div class="row g-4">
<div class="col-lg-6 vstack gap-4">
<section dir="rtl"><h3 class="h6 fw-semibold mb-3">تتبّع الطلب · الوقت في عمود جانبي</h3><Timeline TimePosition="side" DoneLabel="مكتمل" CurrentLabel="جارٍ الآن" UpcomingLabel="قادم" ErrorLabel="فشل">
<TimelineGroup>اليوم</TimelineGroup>
<TimelineItem Index="0" Status="done" Marker="@Icon(Cart)" Time="@Clock(6)" Title="تم استلام الطلب" Description="طلب رقم ١٠٤٢ · ٣ منتجات" />
<TimelineItem Index="1" Status="done" Marker="@Icon(Box)" Time="@Clock(3)" Title="تم التجهيز" Description="مستودع بغداد" />
<TimelineItem Index="2" Status="current" Marker="@Icon(Truck)" Time="@Clock(.5)" Title="خرج للتوصيل" Description="المندوب: عمر · يصل خلال ٤٠ دقيقة"><Button Size="sm" Variant="tinted">تتبّع على الخريطة</Button></TimelineItem>
<TimelineItem Index="3" Status="upcoming" Marker="@Icon(Home)" Title="تم التسليم" />
</Timeline></section>
<section><h3 class="h6 fw-semibold mb-3">@T("Deploy log · small, with an error","سجل النشر · صغير، مع خطأ")</h3><Timeline Size="sm" Animated="false">
<TimelineItem Index="0" Time="12:01:04" Title="@T("Build","البناء")" Description="1m 12s" Tone="success" /><TimelineItem Index="1" Time="12:02:16" Title="@T("Tests","الاختبارات")" Description="412 passed" Tone="success" />
<TimelineItem Index="2" Status="error" Time="12:03:40" Title="@T("Deploy to production","النشر للإنتاج")" Description="@T("Health check failed on 2 of 6 instances.","فشل فحص الصحة لنسختين من أصل ست نسخ.")" /><TimelineItem Index="3" Status="upcoming" Title="@T("Notify team","إبلاغ الفريق")" />
</Timeline></section></div>
<div class="col-lg-6"><h3 class="h6 fw-semibold mb-3">@T("Activity · avatars, groups, relative time","النشاط · صور ومجموعات ووقت نسبي")</h3><Timeline>
<TimelineGroup>@T("Today","اليوم")</TimelineGroup>
<TimelineItem Index="0" Marker="@Person("Noura Al-Qahtani")" Time="@AgoText(.2)" DateTime="@Iso(.2)"><TitleContent>@T("Noura merged","نورة دمجت") <a href="#pr">#284 Timeline component</a></TitleContent><ChildContent><div class="border rounded-3 bg-body-tertiary p-3 small d-grid gap-1"><code>feat: alternate layout folds below 36rem</code><code>fix: pulse ring stays behind the marker</code></div></ChildContent></TimelineItem>
<TimelineItem Index="1" Marker="@Person("Omar Khalid","/avatars/astronaut.jpg")" Time="@AgoText(2)" DateTime="@Iso(2)" Title="@T("Omar commented on “Theme accents”","عمر علّق على ألوان الثيم")"><blockquote class="border rounded-3 bg-body-tertiary mb-0 p-3 small text-body-secondary">@T("“Emerald looks great with the glass. Ship it.”","الزمردي جميل مع الزجاج. انشروه.")</blockquote></TimelineItem>
<TimelineGroup>@T("Yesterday","أمس")</TimelineGroup>
<TimelineItem Index="2" Marker="@Person("Layla Hassan")" Time="@AgoText(26)" DateTime="@Iso(26)" Title="@T("Layla uploaded 2 files","ليلى رفعت ملفين")"><div class="d-flex flex-wrap gap-2">@foreach(var file in new[]{"brand-guide.pdf","palette.fig"}){<span class="d-inline-flex align-items-center gap-2 px-2 py-1 rounded-3 bg-body-tertiary small"><span class="d-inline-flex" style="width:16px;height:16px">@Icon(FileIcon)</span>@file</span>}</div></TimelineItem>
<TimelineItem Index="3" Marker="@Icon(Check)" Tone="success" Time="@AgoText(30)" DateTime="@Iso(30)" Title="@T("Release 3.1 published","نُشر الإصدار 3.1")" Description="Rating, Carousel, Stepper and File Upload." />
</Timeline></div>
<div class="col-12"><h3 class="h6 fw-semibold mb-3">@T("History · alternate","التاريخ · متناوب")</h3><Timeline Layout="alternate" aria-label="@T("History","التاريخ")">
<TimelineItem Index="0" Time="2021" Title="@T("First commit","أول تعديل")" Description="@T("A handful of glass buttons on Bootstrap 5.","مجموعة أزرار زجاجية مبنية على Bootstrap 5.")" Tone="neutral" />
<TimelineItem Index="1" Time="2022" Title="@T("Radix behaviour","سلوك Radix")" Description="@T("Dialogs, menus and popovers move to Radix primitives.","انتقلت نوافذ وقوائم نسخة React إلى Radix.")" />
<TimelineItem Index="2" Time="2024" Title="@T("RTL everywhere","RTL في كل مكان")" Description="@T("Every component mirrors for Arabic.","كل المكونات تدعم العرض العربي.")" Tone="info" />
<TimelineItem Index="3" Time="2025" Title="@T("Forms","النماذج")" Description="Field, FormSection, react-hook-form and zod." Tone="success" />
<TimelineItem Index="4" Status="current" Time="2026" Title="@T("Its own identity","هوية خاصة")" Description="Accents, IBM Plex, tighter corners." Marker="@Icon(Rocket)" />
</Timeline></div>
<div class="col-12"><h3 class="h6 fw-semibold mb-3">@T("Roadmap · horizontal","الخطة · أفقي")</h3><Timeline Layout="horizontal" aria-label="@T("Roadmap","الخطة")">@for(var i=0;i<Roadmap.Length;i++){var index=i;var row=Roadmap[index];<TimelineItem Index="index" Time="@row.Time" Title="@T(row.Title,row.Arabic)" Status="@row.Status">@if(row.Status=="current"){<Badge Size="sm">@T("In progress","جارٍ العمل")</Badge>}</TimelineItem>}</Timeline></div>
</div>
@code {
    [Parameter] public bool Arabic { get; set; }
    private readonly DateTimeOffset now=DateTimeOffset.Now;
    private string T(string en,string ar)=>Arabic?ar:en;
    private string Clock(double hours)=>string.Concat(now.AddHours(-hours).ToString("h:mm tt",System.Globalization.CultureInfo.GetCultureInfo("ar-IQ")).Select(c=>c is >= '0' and <= '9'?(char)('٠'+c-'0'):c));
    private string Iso(double hours)=>now.AddHours(-hours).ToString("O");
    private string AgoText(double hours)=>hours<1?T($"{Math.Round(hours*60)} minutes ago",$"قبل {Math.Round(hours*60)} دقيقة"):hours<24?T($"{Math.Round(hours)} hours ago",$"قبل {Math.Round(hours)} ساعة"):T("yesterday","أمس");
    private static readonly (string Time,string Title,string Arabic,string Status)[] Roadmap={new("Q1","Data grid","شبكة البيانات","done"),new("Q2","Text editor","محرر النصوص","done"),new("Q3","Carousel & timeline","الشرائح والخط الزمني","current"),new("Q4","Charts","الرسوم البيانية","upcoming"),new("2027","Docs site","موقع التوثيق","upcoming")};
    // Built-in icon paths from Lucide (ISC).
    private RenderFragment Icon(string path)=>@<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="@path" /></svg>;
    private RenderFragment Person(string name,string? src=null)=>@<Avatar Name="@name" Src="@src" />;
    private const string Cart="M3 4h2l2.4 11h11L21 7H6.2M9 20h.01M18 20h.01",Box="M21 8 12 3 3 8v8l9 5 9-5zM3 8l9 5 9-5M12 13v8",Truck="M3 6h11v10H3zM14 9h4l3 3v4h-7M7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM17 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z",Home="M3 11 12 4l9 7M5 10v10h14V10",Check="M20 6 9 17l-5-5",FileIcon="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5",Rocket="M12 15l-3-3a22 22 0 0 1 2-4A13 13 0 0 1 22 2c0 2.7-.8 7.5-6 11a22 22 0 0 1-4 2zM9 12H4l2-4h5M12 15v5l4-2v-5";
}
