<div class="vstack gap-4">
<div class="row g-4 align-items-center"><div class="col-md-auto d-flex justify-content-center"><QRCode Value="@value" Size="220" Shape="@shape" Level="@level" ForegroundColor="@colors[color].Fg" BackgroundColor="@colors[color].Bg" Downloads Filename="RaxUI" PngLabel="@T("Download PNG","تنزيل PNG")" SvgLabel="@T("Download SVG","تنزيل SVG")" ErrorLabel="@T("Unable to generate QR code.","تعذر إنشاء رمز QR.")" Overlay="@(logo ? Logo : null)" Label="@T("QR code","رمز QR")"></QRCode></div>
<div class="col-md" style="min-width:0"><div class="vstack gap-3"><label class="small fw-medium">@T("Content","المحتوى")<Input @bind-Value="value" Clearable aria-label="QR content" /></label><div class="d-flex flex-wrap gap-4"><div class="vstack gap-1 flex-grow-0"><span class="small fw-medium">@T("Modules","الشكل")</span><ToggleGroup Value="@(new[]{shape})" ValueChanged="v=>shape=v[0]" Required Variant="segmented" Size="sm" Label="Modules"><ToggleGroupItem Value="square">Square</ToggleGroupItem><ToggleGroupItem Value="rounded">Rounded</ToggleGroupItem><ToggleGroupItem Value="dots">Dots</ToggleGroupItem></ToggleGroup></div><div class="vstack gap-1 flex-grow-0"><span class="small fw-medium">@T("Error correction","تصحيح الأخطاء")</span><ToggleGroup Value="@(new[]{level})" ValueChanged="v=>level=v[0]" Required Variant="segmented" Size="sm" Label="Error correction">@foreach(var item in levels){<ToggleGroupItem Value="@item">@item</ToggleGroupItem>}</ToggleGroup></div></div><div class="d-flex flex-wrap align-items-end gap-4"><div class="vstack gap-1 flex-grow-0"><span class="small fw-medium">@T("Colours","الألوان")</span><ToggleGroup Value="@(new[]{color.ToString()})" ValueChanged="v=>color=int.Parse(v[0])" Required Variant="outline" Size="sm" Label="Colours">@for(var i=0;i<colors.Length;i++){var swatch=colors[i];<ToggleGroupItem Value="@i.ToString()" aria-label="@swatch.Name"><span class="d-inline-block rounded-circle border" style="@($"width:14px;height:14px;background:{swatch.Fg}")"></span></ToggleGroupItem>}</ToggleGroup></div><label class="d-flex align-items-center gap-2 small"><Switch @bind-Value="logo" />@T("Logo overlay (use H)","شعار في الوسط (استخدم H)")</label></div></div></div></div>
<div class="row g-4"><section class="col-lg-7"><h3 class="h6 fw-semibold mb-3">@T("Formats","الصيغ")</h3><div class="d-flex flex-wrap gap-4">@foreach(var format in formats){<div class="vstack gap-2 align-items-center flex-grow-0"><QRCode Value="RaxUI" Size="120" Format="@format" /><span class="small text-body-secondary">@(format=="image"?"Image (PNG)":format.ToUpperInvariant())</span></div>}</div></section><section class="col-lg-5"><h3 class="h6 fw-semibold mb-3">بالعربية</h3><div dir="rtl" class="d-flex flex-wrap align-items-center gap-3"><QRCode Value="مرحباً بك في RaxUI" Size="120" Shape="dots" Level="Q" Label="رمز QR" /><div class="small"><div class="fw-semibold">نص عربي</div><div class="text-body-secondary">يُرمَّز بـ UTF-8 ويُقرأ بكاميرا تدعم QR.</div></div></div></section></div>
</div>
@code {
 [Parameter] public bool Arabic {get;set;}
 private string T(string en,string ar)=>Arabic?ar:en;
 private string value="https://github.com/raxui/RaxUI",shape="rounded",level="H";
 private RenderFragment Logo=>@<text><svg viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="6" fill="#0f172a" /><path d="M8 7h5a3 3 0 0 1 0 6H8zm0 6h6a3 3 0 0 1 0 6H8z" fill="none" stroke="#fff" stroke-width="2" stroke-linejoin="round" /></svg></text>;
 private bool logo=true;private int color;
 private static readonly string[] levels=["L","M","Q","H"],formats=["svg","canvas","image"];
 private static readonly (string Fg,string Bg,string Name)[] colors=[("#000000","#ffffff","Classic"),("#0f172a","#f1f5f9","Slate"),("#065f46","#ecfdf5","Emerald"),("#3730a3","#eef2ff","Indigo")];
}
