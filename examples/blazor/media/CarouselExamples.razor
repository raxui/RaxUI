<div class="row g-4 media-carousel-examples">
<div class="col-lg-7 vstack gap-4"><section><h3 class="h6 fw-semibold mb-1">@T("Hero · autoplay","واجهة · تشغيل تلقائي")</h3><p class="small text-body-secondary mb-3">@T("Pauses while you hover or focus it; the dot fills until the next slide. Arrow keys work once it has focus.","يتوقف عند التحويم أو التركيز، وتمتلئ النقطة حتى الشريحة التالية. استخدم الأسهم بعد التركيز.")</p>
<Carousel Label="@T("What's new","الجديد")" Loop Autoplay="4500" Class="sheen-demo-hero" data-demo-hero><CarouselContent ViewportClass="rounded-5">@foreach(var slide in hero){<CarouselItem><div class="sheen-demo-slide" style="@($"--tone:var(--bs-{slide.Tone}-rgb)")"><span class="sheen-demo-slide-icon"><CarouselArtwork Icon="@slide.Icon" Size="30" /></span><div><div class="fs-4 fw-bold">@T(slide.Title,slide.Arabic)</div><div class="text-body-secondary">@T(slide.Text,slide.ArabicText)</div></div><Button Variant="tinted" Size="sm" Class="align-self-start">@T("Learn more","اعرف المزيد")</Button></div></CarouselItem>}</CarouselContent><CarouselPrevious /><CarouselNext /><div class="d-flex align-items-center justify-content-center gap-2 mt-3"><CarouselDots Class="m-0" /><CarouselPlayPause Variant="ghost" /></div></Carousel>
</section><section><h3 class="h6 fw-semibold mb-3">@T("Products · several per view","منتجات · عناصر متعددة")</h3><Carousel Label="Popular products" Align="start" SlideSize="78%" SmallSlideSize="50%" LargeSlideSize="33.333%" Gap="1rem" data-demo-products><CarouselContent>@foreach(var product in products){<CarouselItem><CarouselProduct Name="@product.Name" Price="@($"{product.Price} IQD")" Icon="@product.Icon" Tone="@product.Tone" Score="@product.Score" /></CarouselItem>}</CarouselContent><CarouselPrevious /><CarouselNext /><CarouselDots /></Carousel></section>
<section><h3 class="h6 fw-semibold mb-3">بالعربية</h3><div dir="rtl"><Carousel Label="منتجات" Labels="@ArabicLabels" Align="start" SlideSize="78%" SmallSlideSize="50%" Gap="1rem" data-demo-arabic><CarouselContent>@foreach(var product in arabicProducts){<CarouselItem><CarouselProduct Name="@product.Name" Price="@product.Price" Icon="@product.Icon" Tone="@product.Tone" Score="@product.Score" /></CarouselItem>}</CarouselContent><CarouselPrevious /><CarouselNext /><CarouselDots /></Carousel></div></section></div>
<div class="col-lg-5 vstack gap-4"><section><h3 class="h6 fw-semibold mb-3">@T("Gallery · fade, thumbnails","صور · تلاشي وصور مصغرة")</h3><Carousel Label="Photos" Effect="fade" Loop style="max-width:360px" data-demo-gallery><CarouselContent ViewportClass="rounded-5">@for(var i=0;i<photos.Length;i++){var photoIndex=i;<CarouselItem><img src="@($"/avatars/{photos[photoIndex]}.jpg")" alt="@($"{photos[photoIndex]} {photoIndex+1}")" class="d-block w-100" style="aspect-ratio:1;object-fit:cover" draggable="false" /></CarouselItem>}</CarouselContent><CarouselCounter /><CarouselPrevious /><CarouselNext /><CarouselThumbs><Template Context="i"><img src="@($"/avatars/{photos[i]}.jpg")" alt="" /></Template></CarouselThumbs></Carousel></section>
<section><h3 class="h6 fw-semibold mb-3">@T("Scale effect","تأثير التكبير")</h3><Carousel Label="Editor's picks" Loop Align="center" Effect="scale" SlideSize="72%" Gap="0.5rem" data-demo-scale><CarouselContent>@foreach(var slide in hero){<CarouselItem><div class="sheen-demo-slide sheen-demo-slide-sm" style="@($"--tone:var(--bs-{slide.Tone}-rgb)")"><span class="sheen-demo-slide-icon"><CarouselArtwork Icon="@slide.Icon" /></span><div class="fw-bold">@T(slide.Title,slide.Arabic)</div></div></CarouselItem>}</CarouselContent><CarouselDots /></Carousel></section>
<section><h3 class="h6 fw-semibold mb-3">@T("Vertical","عمودي")</h3><div class="border rounded-3 px-4 py-3"><Carousel Label="What people say" Orientation="vertical" Loop Autoplay="3200" Gap="0.5rem" data-demo-vertical><CarouselContent ViewportStyle="height:84px">@foreach(var quote in quotes){<CarouselItem style="flex-basis:84px"><figure class="h-100 d-flex flex-column justify-content-center mb-0"><blockquote class="mb-1 fw-medium">@quote.Text</blockquote><figcaption class="small text-body-secondary">@quote.Person</figcaption></figure></CarouselItem>}</CarouselContent><CarouselPlayPause Variant="ghost" /></Carousel></div></section>
</div></div>
@code {
 [Parameter] public bool Arabic {get;set;}
 private string T(string en,string ar)=>Arabic?ar:en;
 private static readonly string[] photos=["coffee","astronaut","chelsea","coffee","astronaut","chelsea"];
 private static readonly (string Tone,string Icon,string Title,string Text,string Arabic,string ArabicText)[] hero=[("primary","spark","SheenUI 3.0","Forms, dates, a data grid and now carousels.","SheenUI 3.0","نماذج وتواريخ وشبكة بيانات وعرض شرائح."),("success","shield","Accessible by default","Keyboard, screen readers and reduced motion.","وصول افتراضي","لوحة مفاتيح وقارئ شاشة وحركة مخفضة."),("warning","bolt","Spring motion","Animations that feel physical, never in the way.","حركة مرنة","حركة طبيعية لا تعيق الاستخدام."),("info","globe","RTL everywhere","Every component mirrors for Arabic and Hebrew.","دعم RTL","مكونات تتكيف مع العربية.")];
 private static readonly (string Name,int Price,double Score,string Icon,string Tone)[] products=[("Glass keyboard",129,4.6,"keyboard","primary"),("Studio headphones",249,4.8,"headphones","info"),("Silent mouse",59,4.2,"mouse","success"),("Desk lamp",89,3.9,"lamp","warning"),("Field watch",199,4.4,"watch","danger"),("Pocket camera",449,4.7,"camera","primary"),("Room speaker",179,4.1,"speaker","info")];
 private static readonly (string Name,string Price,double Score,string Icon,string Tone)[] arabicProducts=[("لوحة مفاتيح زجاجية","٤٨٤ د.ع",4.6,"keyboard","primary"),("سماعات استوديو","٩٣٤ د.ع",4.8,"headphones","info"),("فأرة صامتة","٢٢١ د.ع",4.2,"mouse","success"),("مصباح مكتب","٣٣٤ د.ع",3.9,"lamp","warning"),("هاتف","٣٬٧٤٩ د.ع",4.5,"phone","danger")];
 private static readonly (string Text,string Person)[] quotes=[("“The glass feels native on iOS.”","Noura, designer"),("“Dropped it into our Bootstrap app in an afternoon.”","Omar, engineer"),("“RTL just worked.”","Layla, product lead")];
 private static readonly Carousel.Text ArabicLabels=new(){Carousel="عرض شرائح",Slide="شريحة",SlideOf="{0} من {1}",Previous="الشريحة السابقة",Next="الشريحة التالية",GoTo="انتقل إلى الشريحة {0}",Pause="إيقاف التشغيل التلقائي",Play="تشغيل تلقائي"};
}
