<div>
<Textarea aria-label="@T("New post", "منشور جديد")" placeholder="@T("What’s happening?", "بماذا تفكر؟")" @bind-Value="text" OnKeyDown="KeyDown" AutoResize MinRows="2" MaxRows="8" MaxLength="280" ShowCount LimitLabel="@T("Character limit reached", "تم بلوغ الحد الأقصى للأحرف")">
    <Footer>
        <button type="button" class="rax-input-action" aria-label="@T("Bold", "عريض")"><TextareaExampleIcon Path="M7 5h6a3.5 3.5 0 0 1 0 7H7zM7 12h7a3.5 3.5 0 0 1 0 7H7z" /></button>
        <button type="button" class="rax-input-action" aria-label="@T("Italic", "مائل")"><TextareaExampleIcon Path="M10 5h8M6 19h8M14 5l-4 14" /></button>
        <button type="button" class="rax-input-action" aria-label="@T("Insert link", "إدراج رابط")"><TextareaExampleIcon Path="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" /></button>
        <button type="button" class="rax-input-action" aria-label="@T("Attach file", "إرفاق ملف")"><TextareaExampleIcon Path="m21 11-8.6 8.6a5.5 5.5 0 0 1-7.8-7.8l8.6-8.6a3.7 3.7 0 0 1 5.2 5.2l-8.6 8.6a1.8 1.8 0 0 1-2.6-2.6L15.5 7" /></button>
    </Footer>
    <FooterEnd><Button Size="sm" disabled="@Empty" OnClick="Post" Class="ms-1"><TextareaExampleIcon Path="M4 12 20 4l-6 16-3-7Z" />@T("Post", "نشر")</Button></FooterEnd>
</Textarea>
<div class="form-text">@T("Grows as you type · ⌘/Ctrl + Enter to post", "يتمدد أثناء الكتابة · ⌘/Ctrl + Enter للنشر")</div>
<div data-textarea-posts>@foreach (var post in posts) { <p class="small border-bottom py-2 mb-0">@post</p> }</div>
</div>
@code {
    [Parameter] public bool Arabic { get; set; }
    private string? text;
    private readonly List<string> posts = new();
    private bool Empty => string.IsNullOrWhiteSpace(text);
    private string T(string english, string arabic) => Arabic ? arabic : english;
    protected override void OnInitialized() => text = T("Loving the frosted inputs in RaxUI ✨ The ring fills as you type and turns amber near the limit.", "أحب حقول RaxUI ✨ تمتلئ الدائرة أثناء الكتابة ويتحول لونها عند الاقتراب من الحد الأقصى.");
    private void Post() { if (Empty || text!.Length > 280) return; posts.Insert(0, text.Trim()); if (posts.Count > 3) posts.RemoveAt(3); text = ""; }
    private void KeyDown(KeyboardEventArgs args) { if (args.Key == "Enter" && (args.CtrlKey || args.MetaKey)) Post(); }
}
