<div class="row g-5">
    <div class="col-lg-6">
        <h3 class="h6 fw-semibold mb-3">@T("Composer", "محرر المنشور")</h3>
        <TextareaComposerExample Arabic="@Arabic" />
        <h3 class="h6 fw-semibold mt-5 mb-3">@T("Validation", "التحقق من النص")</h3>
        <label for="ta-bio" class="form-label small fw-medium">@T("Bio", "النبذة الشخصية")</label>
        <Textarea id="ta-bio" @bind-Value="bio" Invalid="BioInvalid" aria-describedby="ta-bio-help" MinRows="3" />
        <div id="ta-bio-help" class="@(BioInvalid ? "form-text text-danger" : "form-text")">@(BioInvalid ? T($"At least 20 characters ({20 - (bio?.Trim().Length ?? 0)} more).", $"اكتب 20 حرفاً على الأقل (متبقي {20 - (bio?.Trim().Length ?? 0)}).") : T("Looks good.", "النص مناسب."))</div>
    </div>
    <div class="col-lg-6">
        <h3 class="h6 fw-semibold mb-3">@T("Default", "الافتراضي")</h3>
        <label for="ta-feedback" class="form-label small fw-medium">@T("Feedback", "الملاحظات والاقتراحات")</label>
        <Textarea id="ta-feedback" placeholder="@T("Tell us what you think…", "أخبرنا برأيك…")" />
        <h3 class="h6 fw-semibold mt-4 mb-3">@T("Filled · counter", "ممتلئ · عدّاد")</h3>
        <Textarea Variant="filled" aria-label="@T("Release notes", "ملاحظات الإصدار")" placeholder="@T("Release notes", "ملاحظات الإصدار")" @bind-Value="release" MaxLength="120" ShowCount AutoResize MinRows="2" LimitLabel="@T("Character limit reached", "تم بلوغ الحد الأقصى للأحرف")" />
        <h3 class="h6 fw-semibold mt-4 mb-3">@T("Disabled · RTL", "معطل · من اليمين لليسار")</h3>
        <div class="d-grid gap-3">
            <Textarea disabled aria-label="@T("Disabled", "معطل")" Value="@T("This note is locked.", "هذه الملاحظة مقفلة.")" MinRows="2" />
            <Textarea dir="rtl" aria-label="ملاحظات" placeholder="اكتب ملاحظاتك هنا…" MaxLength="200" ShowCount AutoResize MinRows="2" LimitLabel="تم بلوغ الحد الأقصى للأحرف" />
        </div>
    </div>
</div>
@code {
    [Parameter] public bool Arabic { get; set; }
    private string? bio = "Frontend", release = "Adds Input, Textarea and Breadcrumb.";
    private bool BioInvalid => (bio?.Trim().Length ?? 0) < 20;
    private string T(string english, string arabic) => Arabic ? arabic : english;
}
