<div class="row g-4">
<div class="col-12"><h3 class="h6 fw-semibold mb-1">@T("Checkout · linear, validated","إتمام الطلب · خطي مع التحقق")</h3><p class="small text-body-secondary mb-3">@T("Continue checks the step’s fields; a step with errors turns red. Done steps can be revisited.","متابعة تتحقق من حقول الخطوة؛ تُلوّن الخطوات التي تحتوي أخطاء بالأحمر ويمكن الرجوع للمكتملة.")</p><div class="border rounded-4 p-4" style="max-width:820px"><CheckoutExample Arabic="Arabic" /></div></div>
<div class="col-lg-6"><h3 class="h6 fw-semibold mb-3">@T("Onboarding · labels below, icons, free navigation","التهيئة · عناوين أسفل الأيقونات وتنقل حر")</h3><div class="border rounded-4 p-4"><Stepper Items="Onboarding" @bind-Value="onboarding" LabelPlacement="bottom" Label="@T("Set up your workspace","إعداد مساحة العمل")" OptionalLabel="@T("Optional","اختياري")">@for(var i=0;i<4;i++){var index=i;<StepperPanel Index="index"><p class="text-body-secondary mb-0">@T(OnboardingText[index].En,OnboardingText[index].Ar)</p></StepperPanel>}<StepperPanel Index="4"><p class="fw-semibold mb-0">@T("All set 🎉","اكتمل الإعداد 🎉")</p></StepperPanel>@if(onboarding<4){<div class="d-flex justify-content-end gap-2"><Button Variant="ghost" Disabled="@(onboarding==0)" @onclick="()=>onboarding--">@T("Previous","السابق")</Button><Button @onclick="()=>onboarding++">@(onboarding==3?T("Finish","إنهاء"):T("Next","التالي"))</Button></div>}</Stepper></div></div>
<div class="col-lg-6"><h3 class="h6 fw-semibold mb-3">@T("Vertical · content in the steps","عمودي · محتوى داخل الخطوات")</h3><div class="border rounded-4 p-4"><Stepper Items="DeploySteps" @bind-Value="deploy" Orientation="vertical" Size="sm" Label="@T("Deploy","النشر")" /></div></div>
<div class="col-lg-6"><h3 class="h6 fw-semibold mb-3">@T("Narrow container · the current step is named below","حاوية ضيقة · اسم الخطوة الحالية بالأسفل")</h3><div class="border rounded-4 p-3" style="max-width:320px"><Stepper Items="Signup" @bind-Value="signup" Label="@T("Sign up","التسجيل")" /></div></div>
<div class="col-lg-6"><h3 class="h6 fw-semibold mb-3">بالعربية</h3><div dir="rtl" class="border rounded-4 p-4"><Stepper Items="ArabicSteps" @bind-Value="arabic" Label="خطوات الطلب" OptionalLabel="اختياري" CompletedLabel="مكتمل" CurrentLabel="الخطوة الحالية" ErrorLabel="فيها خطأ" StepLabel="ArabicStepLabel"><div class="d-flex justify-content-between"><Button Variant="ghost" Disabled="@(arabic==0)" @onclick="()=>arabic--">السابق</Button><Button Disabled="@(arabic==4)" @onclick="()=>arabic++">التالي</Button></div></Stepper></div></div>
</div>
@code {
    [Parameter] public bool Arabic { get; set; }
    private int onboarding=1,deploy=2,signup=1,arabic=2;
    private string T(string en,string ar)=>Arabic?ar:en;
    private static string ArabicStepLabel(int step,int count)=>$"الخطوة {step} من {count}";
    private static readonly (string En,string Ar)[] OnboardingText={("Add a photo and your role.","أضف صورتك ودورك."),("Invite people now or later.","ادعُ الأشخاص الآن أو لاحقاً."),("Pick what you hear about.","اختر الإشعارات التي تريدها."),("You're ready to go.","أصبحت جاهزاً للبدء.")};
    private IReadOnlyList<Stepper.Item> Onboarding=>new[]{new Stepper.Item(T("Profile","الملف الشخصي"),Icon:Icon(User)),new Stepper.Item(T("Invite team","دعوة الفريق"),Icon:Icon(Users),Optional:true),new Stepper.Item(T("Notifications","الإشعارات"),Icon:Icon(Bell)),new Stepper.Item(T("Launch","الإطلاق"),Icon:Icon(Rocket))};
    private IReadOnlyList<Stepper.Item> Signup=>new[]{new Stepper.Item(T("Account","الحساب")),new Stepper.Item(T("Verify email","التحقق من البريد")),new Stepper.Item(T("Plan","الخطة")),new Stepper.Item(T("Done","اكتمل"))};
    private static readonly Stepper.Item[] ArabicSteps={new("السلة"),new("العنوان"),new("الدفع"),new("التأكيد")};
    private IReadOnlyList<Stepper.Item> DeploySteps=>new[]{new Stepper.Item(T("Connect repository","ربط المستودع"),"github.com/saadalsaree/RaxUI"),new Stepper.Item(T("Configure build","إعداد البناء"),"npm run build · dist/"),new Stepper.Item(T("Environment variables","متغيرات البيئة"),ErrorMessage:deploy==2?T("2 variables are missing","متغيران مفقودان"):null,Content:Variables),new Stepper.Item(T("Deploy","النشر"),T("Preview, then production","معاينة ثم إنتاج"),Content:Deploy)};
    private RenderFragment Variables=>@<div><p class="small text-body-secondary mb-2">@T("Add API_URL and SENTRY_DSN, then try again.","أضف API_URL وSENTRY_DSN ثم أعد المحاولة.")</p><div class="d-flex gap-2"><Button Size="sm" @onclick="()=>deploy=3">@T("Add variables","إضافة المتغيرات")</Button><Button Size="sm" Variant="ghost" @onclick="()=>deploy=1">@T("Back","رجوع")</Button></div></div>;
    private RenderFragment Deploy=>@<div><p class="small text-body-secondary mb-2">@T("Ships to a preview URL first.","يُنشر إلى رابط معاينة أولاً.")</p><Button Size="sm" @onclick="()=>deploy=4">@T("Deploy now","النشر الآن")</Button></div>;
    // Built-in icon paths from Lucide (ISC).
    private RenderFragment Icon(string path)=>@<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="@path" /></svg>;
    private const string User="M20 21a8 8 0 0 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10z",Users="M16 21a6 6 0 0 0-12 0M10 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM22 21a6 6 0 0 0-4-5.6",Bell="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10 21h4",Rocket="M12 15l-3-3a22 22 0 0 1 2-4A13 13 0 0 1 22 2c0 2.7-.8 7.5-6 11a22 22 0 0 1-4 2zM9 12H4l2-4h5M12 15v5l4-2v-5";
}
