<section class="vstack gap-2 mb-4" data-kanban-project><h3 class="h6 fw-semibold mb-1">Project board</h3>
    <Kanban TItem="Card" @bind-Columns="columns" GetId="c=>c.Id" GetLabel="c=>c.Title" Committed="Log" Style="height:460px" ColumnHandleLabel="Drag column">
        <ColumnHeader Context="column">
            <span class="rounded-circle flex-shrink-0" style="@($"width:8px;height:8px;background:{Dots[column.Id]}")" aria-hidden="true"></span>
            <h3 class="rax-kanban-column-title">@column.Title</h3>
            <span @key="column.Items.Count" class="rax-kanban-column-count" data-over-limit="@(column.Items.Count>column.Limit?"":null)" aria-label="@(column.Limit is null?$"{column.Items.Count} cards":$"{column.Items.Count} of {column.Limit}")">@(column.Limit is null?column.Items.Count:$"{column.Items.Count}/{column.Limit}")</span>
            @if(column.Id=="backlog"){<Button Variant="ghost" Size="icon-sm" aria-label="Add a card to Backlog" OnClick="Add"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></Button>}
        </ColumnHeader>
        <ItemTemplate Context="card">
            <div class="vstack gap-2">
                <span class="fw-medium text-body-emphasis lh-sm">@card.Title</span>
                <div class="d-flex align-items-center gap-2 small text-body-secondary">
                    <Badge Color="@card.Color">@card.Tag</Badge>
                    @if(card.Due is not null){<span>@card.Due</span>}
                    @if(card.Comments>0){<span class="d-inline-flex align-items-center gap-1"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z" /></svg>@card.Comments</span>}
                    <Avatar Size="sm" Name="@card.Assignee" Class="ms-auto" style="width:22px;height:22px;font-size:10px" />
                </div>
            </div>
        </ItemTemplate>
        <Empty>Drop cards here</Empty>
    </Kanban>
    <div class="small text-body-secondary" aria-live="polite">@log</div>
</section>
<section class="vstack gap-2" dir="rtl" lang="ar" data-kanban-arabic><h3 class="h6 fw-semibold mb-1">بالعربية</h3>
        <Kanban TItem="string" @bind-Columns="arabic" GetId="x=>x" GetLabel="x=>x"
                Instructions="لالتقاط بطاقة أو عمود اضغط مسافة أو Enter، ثم حرّكه بالأسهم، واضغط مسافة للإفلات أو Escape للإلغاء."
                ColumnHandleLabel="اسحب عمود" Grabbed="التقطت {item} في {column}. الموضع {position} من {total}."
                Moved="نُقلت {item} إلى {column}، الموضع {position} من {total}." Dropped="أُفلتت {item} في {column} في الموضع {position} من {total}."
                Cancelled="أُلغي النقل. {item} عادت إلى مكانها." ColumnGrabbed="التقطت {item}. الموضع {position} من {total}."
                ColumnMoved="نُقلت {item}، الموضع {position} من {total}." ColumnDropped="أُفلتت {item} في الموضع {position} من {total}.">
            <ItemTemplate Context="card">@card</ItemTemplate>
            <Empty>أفلت البطاقات هنا</Empty>
        </Kanban>
</section>
@code {
    public sealed record Card(string Id,string Title,string Tag,string Color,string Assignee,string? Due=null,int Comments=0);
    private static readonly Dictionary<string,string> Dots=new(){["backlog"]="var(--bs-secondary-color)",["progress"]="var(--bs-primary)",["review"]="var(--bs-warning)",["blocked"]="var(--bs-danger)",["done"]="var(--bs-success)"};
    private int nextId=100;
    private string log="Drag cards between columns, or columns by their grip. Keyboard: Tab to a card, Space, arrows, Space.";
    private IReadOnlyList<KanbanTypes.Column<Card>> columns=new KanbanTypes.Column<Card>[]{
        new("backlog","Backlog",new Card[]{new("c1","Add a Kanban block","Feature","success","Saad Alsaree","Oct 30",3),new("c2","Document the radius scale","Docs","info","Noura Al-Qahtani"),new("c3","Audit focus rings in dark mode","A11y","warning","Omar Haddad",null,1)}),
        new("progress","In progress",new Card[]{new("c4","QR code logo overlay","Feature","success","Saad Alsaree","Oct 24"),new("c5","Speed Dial RTL labels","Bug","danger","Lina Saleh",null,4)}){Limit=3},
        new("review","Review",new Card[]{new("c6","Sortable keyboard announcements","A11y","warning","Omar Haddad","Oct 23")}),
        new("blocked","Blocked",Array.Empty<Card>()),
        new("done","Done",new Card[]{new("c7","Markdown in AIResponse","Feature","success","Noura Al-Qahtani",null,2),new("c8","Input Group paste","Bug","danger","Lina Saleh")})
    };
    private IReadOnlyList<KanbanTypes.Column<string>> arabic=new KanbanTypes.Column<string>[]{
        new("todo","للتنفيذ",new[]{"تصميم صفحة الهبوط","كتابة نصوص الترحيب"}),
        new("doing","قيد العمل",new[]{"ربط بوابة الدفع"}),
        new("done","منجز",new[]{"إعداد النطاق","شعار المتجر"})
    };
    private string TitleOf(string id)=>columns.First(c=>c.Id==id).Title;
    private void Log(KanbanTypes.Change c)=>log=c.Type=="column"
        ?$"Moved column “{TitleOf(c.Id)}” to position {c.Index+1}."
        :$"Moved “{columns.SelectMany(x=>x.Items).First(x=>x.Id==c.Id).Title}” {(c.From==c.To?"within":$"from {TitleOf(c.From)} to")} {TitleOf(c.To)}, position {c.Index+1}.";
    private void Add()=>columns=columns.Select(c=>c.Id=="backlog"?c with{Items=c.Items.Prepend(new Card($"c{nextId++}","New card","Task","secondary","Saad Alsaree")).ToList()}:c).ToList();
}
