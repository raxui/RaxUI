<div class="row g-5">
<div class="col-md-6"><h3 class="h6 fw-semibold mb-2">@T("Frequently asked questions","الأسئلة الشائعة")</h3><Accordion Icon="plus">
<AccordionItem Value="copy" Title="@T("Is RaxUI a package I install?","هل RaxUI حزمة أثبّتها؟")" DefaultOpen>@T("You copy the Razor components and shared styles into your project and own the code.","تنسخ مكونات Razor والأنماط المشتركة إلى مشروعك وتمتلك الكود.")</AccordionItem>
<AccordionItem Value="tailwind" Title="@T("Does it use Tailwind?","هل يستخدم Tailwind؟")">@T("No. It uses Bootstrap semantic/utility classes and SCSS built on Bootstrap CSS variables.","لا. يستخدم أصناف Bootstrap الدلالية والمساعدة وSCSS المبني على متغيرات CSS.")</AccordionItem>
<AccordionItem Value="dark" Title="@T("How does dark mode work?","كيف يعمل الوضع الداكن؟")">@T("Switch data-bs-theme between light and dark; the shared tokens update every component.","بدّل data-bs-theme بين light وdark لتتبع المكونات التوكنات المشتركة.")</AccordionItem>
<AccordionItem Value="a11y" Title="@T("Is it accessible?","هل يدعم الوصول؟")">@T("Native details support basic SSR disclosure; interactivity adds keyboard navigation and controlled state.","يدعم details الفتح في SSR، وتضيف التفاعلية التنقل بلوحة المفاتيح والحالة المتحكم بها.")</AccordionItem>
</Accordion><h3 class="h6 fw-semibold mt-5 mb-2" dir="rtl">الأسئلة الشائعة</h3><div dir="rtl"><Accordion><AccordionItem Title="كم يستغرق التوصيل؟">من ٣ إلى ٥ أيام عمل داخل المدن الرئيسية.</AccordionItem><AccordionItem Title="ما طرق الدفع المتاحة؟">البطاقات البنكية و Apple Pay والتحويل البنكي.</AccordionItem></Accordion></div></div>
<div class="col-md-6 vstack gap-5">
<section><h3 class="h6 fw-semibold mb-2">@T("Settings","الإعدادات")</h3><Accordion Multiple Variant="inset">
<AccordionItem Title="@T("Notifications","الإشعارات")" Description="@T("Email, push and SMS","البريد والإشعارات والرسائل")" Icon="@Icon(Bell)" DefaultOpen><div class="d-flex align-items-center justify-content-between py-1"><label for="acc-email">@T("Email","البريد")</label><Switch id="acc-email" @bind-Value="email" /></div><div class="d-flex align-items-center justify-content-between py-1"><label for="acc-push">@T("Push","الإشعارات")</label><Switch id="acc-push" @bind-Value="push" /></div><div class="d-flex align-items-center justify-content-between py-1"><label for="acc-sms">SMS</label><Switch id="acc-sms" @bind-Value="sms" /></div></AccordionItem>
<AccordionItem Title="@T("Privacy","الخصوصية")" Description="@T("Who can see your activity","من يرى نشاطك")" Icon="@Icon(Lock)"><div class="d-flex align-items-center justify-content-between py-1"><label for="acc-profile">@T("Public profile","ملف عام")</label><Switch id="acc-profile" @bind-Value="profile" /></div><div class="d-flex align-items-center justify-content-between py-1"><label for="acc-status">@T("Show online status","إظهار حالة الاتصال")</label><Switch id="acc-status" @bind-Value="status" /></div></AccordionItem>
<AccordionItem Title="@T("Cloud backup","النسخ السحابي")" Description="@T("Available on the Pro plan","متاح في خطة Pro")" Icon="@Icon(Cloud)" Disabled />
</Accordion></section>
<section><div class="d-flex align-items-center justify-content-between mb-2"><h3 class="h6 fw-semibold mb-0">@T("Order #1048","الطلب #1048")</h3><div class="d-flex gap-1"><Button Variant="ghost" Size="sm" @onclick="Expand">@T("Expand all","توسيع الكل")</Button><Button Variant="ghost" Size="sm" @onclick="Collapse">@T("Collapse all","طي الكل")</Button></div></div>
<Accordion Multiple Variant="cards" @bind-Values="open">
<AccordionItem Value="shipping" Title="@T("Shipping","الشحن")" Description="@T("Arrives Thursday, Oct 29","يصل الخميس 29 أكتوبر")" Icon="@Icon(Truck)"><div class="small"><div class="d-flex justify-content-between"><span>@T("Carrier","شركة الشحن")</span><span>Aramex Express</span></div><div class="d-flex justify-content-between"><span>@T("Tracking","التتبع")</span><span>AX 4821 9930</span></div><div class="progress mt-2" style="height:6px" role="progressbar" aria-label="@T("Delivery progress","تقدم التوصيل")" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:60%"></div></div></div></AccordionItem>
<AccordionItem Value="items" Title="@T("Items","المنتجات")" Description="@T("3 items · $214.97","٣ منتجات · ٢٨١٬٦١١ د.ع")" Icon="@Icon(Box)"><div class="small vstack gap-1"><div class="d-flex justify-content-between"><span>@T("Wireless earbuds","سماعات لاسلكية")</span><span>$129.99</span></div><div class="d-flex justify-content-between"><span>@T("Charging case","علبة شحن")</span><span>$49.99</span></div><div class="d-flex justify-content-between"><span>@T("Silicone tips (3 pairs)","رؤوس سيليكون (٣ أزواج)")</span><span>$34.99</span></div></div></AccordionItem>
<AccordionItem Value="returns" Title="@T("Returns","الإرجاع")" Description="@T("Free within 30 days","مجاناً خلال ٣٠ يوماً")" Icon="@Icon(Return)"><p class="small text-body-secondary mb-0">@T("Start a return from your orders page; we’ll email a prepaid label.","ابدأ الإرجاع من صفحة الطلبات؛ سنرسل ملصق شحن مدفوعاً عبر البريد.")</p></AccordionItem>
</Accordion></section></div></div>
@code {
    [Parameter] public bool Arabic { get; set; }
    private bool email=true,push=true,sms,profile,status=true;
    private IReadOnlyList<string> open=new[]{"shipping"};
    private void Expand()=>open=new[]{"shipping","items","returns"};private void Collapse()=>open=Array.Empty<string>();
    private string T(string en,string ar)=>Arabic?ar:en;
    // Built-in icon paths from Lucide (ISC).
    private RenderFragment Icon(string path)=>@<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="@path" /></svg>;
    private const string Bell="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10 21h4",Lock="M5 11h14v10H5zM8 11V7a4 4 0 0 1 8 0v4",Cloud="M17.5 19a4.5 4.5 0 1 0-1.4-8.8A7 7 0 1 0 4 15.7 4 4 0 0 0 7 19Z",Truck="M3 6h11v10H3zM14 9h4l3 3v4h-7M7 19h.01M17 19h.01",Box="M21 8 12 3 3 8v8l9 5 9-5zM3 8l9 5 9-5M12 13v8",Return="M9 14 4 9l5-5M4 9h11a5 5 0 0 1 0 10h-3";
}
