<div class="row g-4">
<div class="col-md-6 vstack gap-4">
<section><h3 class="small fw-semibold mb-2">@T("Image · initials · fallback","صورة · أحرف الاسم · بديل")</h3><div class="d-flex align-items-center gap-3"><Avatar Size="lg" Src="/avatars/astronaut.jpg" Name="Eileen Collins" /><Avatar Size="lg" Src="data:image/png;base64,invalid" Name="Saad Alsaree" /><Avatar Size="lg" Name="نورة القحطاني" /><Avatar Size="lg" FallbackLabel="@T("Avatar","صورة شخصية")" /></div></section>
<section><h3 class="small fw-semibold mb-2">@T("Sizes & shapes","الأحجام والأشكال")</h3><div class="d-flex flex-wrap align-items-end gap-3">@foreach(var size in new[]{"xs","sm","default","lg","xl"}){<Avatar Size="@size" Src="/avatars/chelsea.jpg" Name="Chelsea" />}<Avatar Size="xl" Shape="rounded" Src="/avatars/coffee.jpg" Name="Coffee shop" /><Avatar Size="lg" Shape="rounded" Name="boot ui" /></div></section>
<section><h3 class="small fw-semibold mb-2">@T("Status","الحالة")</h3><div class="d-flex flex-wrap align-items-center gap-4">@for(var i=0;i<Statuses.Length;i++){var index=i;var status=Statuses[index];<div class="d-flex flex-column align-items-center gap-1"><Avatar Size="lg" Name="@Team[index]" Src="@(index==0?"/avatars/astronaut.jpg":null)" Status="@status" StatusLabel="@StatusLabel(index)" /><span class="small text-body-secondary text-capitalize">@StatusLabel(index)</span></div>}<div class="d-flex flex-column align-items-center gap-1"><Avatar Size="lg" Shape="rounded" Ring Src="/avatars/coffee.jpg" Name="Coffee" Status="online" StatusLabel="@StatusLabel(0)" /><span class="small text-body-secondary">@T("Ring","إطار")</span></div></div></section>
</div>
<div class="col-md-6 vstack gap-4">
<section><h3 class="small fw-semibold mb-2">@T("Group (hover it)","مجموعة (مرّر المؤشر)")</h3><AvatarGroup TItem="string" Items="Team" GetName="x=>x" GetId="x=>x" GetImage="TeamImage" Max="5" Label="@T("Project members","أعضاء المشروع")" MoreLabel="MoreMembers" /></section>
<section><h3 class="small fw-semibold mb-2">@T("Small group","مجموعة صغيرة")</h3><AvatarGroup TItem="string" Items="Reviewers" GetName="x=>x" GetId="x=>x" Max="3" Size="sm" Label="@T("Reviewers","المراجعون")" MoreLabel="MoreMembers" /></section>
<div class="d-flex gap-3 p-3 rounded-4 bg-body-tertiary"><Avatar Src="/avatars/astronaut.jpg" Name="Eileen Collins" Status="online" StatusLabel="@StatusLabel(0)" /><div><div class="small"><span class="fw-semibold">Eileen Collins</span> <span class="text-body-secondary">· @T("2m","دقيقتان")</span></div><div class="small text-body-secondary">@T("The glass cards look great over the launch photos 🚀","البطاقات الزجاجية تبدو جميلة فوق صور الإطلاق 🚀")</div></div></div>
</div></div>
@code {
    [Parameter] public bool Arabic { get; set; }
    private static readonly string[] Team={"Saad Alsaree","Noura Al-Qahtani","Omar Khalid","Layla Hassan","Yousef Nasser","Mona Fares","Ahmed Saleh","Huda Karim"};
    private static readonly string[] Reviewers=Team.Skip(2).ToArray();
    private static readonly string[] Statuses={"online","away","busy","offline"};
    private string T(string en,string ar)=>Arabic?ar:en;
    private string? TeamImage(string name)=>name==Team[1]?"/avatars/astronaut.jpg":null;
    private string MoreMembers(int n)=>T($"{n} more members",$"{n} أعضاء آخرون");
    private string StatusLabel(int index)=>Arabic?new[]{"متصل","بعيد","مشغول","غير متصل"}[index]:Statuses[index];
}
