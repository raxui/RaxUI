@inherits PanelExampleBase
<Button Variant="tinted" OnClick="@(() => open = true)">@T("Share sheet", "شيت المشاركة")</Button>
<Sheet @bind-Open="open" Side="bottom" Title="@T("Share “Q4 Report.pdf”", "مشاركة «تقرير الربع الرابع.pdf»")" Description="@T("2.4 MB · Updated today", "2.4 ميغابايت · حُدّث اليوم")" CloseLabel="@T("Close", "إغلاق")" HandleLabel="@T("Drag sheet", "سحب الشيت")">
    <ChildContent><div class="row row-cols-4 g-3 text-center small">
        @foreach (var item in items)
        {
            <div class="col"><button type="button" class="btn p-0 border-0 d-flex flex-column align-items-center gap-2 w-100" @onclick="@(() => Share(item.English, item.Arabic))"><span class="@($"d-inline-flex align-items-center justify-content-center rounded-4 bg-{item.Tone}-subtle text-{item.Tone}-emphasis")" style="width:56px;height:56px;padding:16px"><PanelIcon Path="@item.Path" /></span>@T(item.English, item.Arabic)</button></div>
        }
    </div></ChildContent>
    <Footer><Button Variant="secondary" Size="lg" Class="w-100" OnClick="@(() => open = false)">@T("Cancel", "إلغاء")</Button></Footer>
</Sheet>
@code {
    private bool open;
    private readonly (string English, string Arabic, string Tone, string Path)[] items = [
        ("Copy link", "نسخ الرابط", "primary", "M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"),
        ("Mail", "البريد", "info", "M3 7h18v12H3ZM3 7l9 6 9-6"),
        ("Messages", "الرسائل", "success", "M21 12a8 8 0 0 1-11.6 7.1L3 21l1.9-6.4A8 8 0 1 1 21 12Z"),
        ("Print", "طباعة", "secondary", "M6 9V3h12v6M6 18H4v-8h16v8h-2M6 14h12v7H6Z")];
    private void Share(string english, string arabic) { open = false; Notify(english + " — done", arabic + " — تم"); }
}
