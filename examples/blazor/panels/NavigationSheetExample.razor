@inherits PanelExampleBase
<Button Variant="tinted" OnClick="@(() => open = true)">@T("Navigation drawer", "قائمة التنقل")</Button>
<Sheet @bind-Open="open" Side="start" ShowCloseButton="false" Title="SheenUI" Description="@T("Workspace", "مساحة العمل")" BodyClass="px-2" style="width:min(18rem,calc(100vw - 3rem))">
    <nav class="list-group list-group-flush bg-transparent">
        @foreach (var item in items)
        {
            <a href="#" @onclick:preventDefault @onclick="@(() => Navigate(item.Id))" class="@($"list-group-item list-group-item-action d-flex align-items-center gap-3 border-0 rounded-3 {(item.Id == active ? "active" : "bg-transparent")}")" aria-current="@(item.Id == active ? "page" : null)"><PanelIcon Path="@item.Path" />@T(item.English, item.Arabic)</a>
        }
    </nav>
</Sheet>
@code {
    private bool open; private string active = "home";
    private readonly (string Id, string English, string Arabic, string Path)[] items = [
        ("home", "Home", "الرئيسية", "M3 10.5 12 3l9 7.5V20H14v-6H9v6H3Z"),
        ("inbox", "Inbox", "الوارد", "M22 12h-6l-2 3h-4l-2-3H2M5 5h14l3 7v6H2v-6Z"),
        ("calendar", "Calendar", "التقويم", "M3 6h18v15H3ZM8 2v4M16 2v4M3 10h18"),
        ("reports", "Reports", "التقارير", "M3 3v18h18M7 15l4-4 3 3 5-6"),
        ("settings", "Settings", "الإعدادات", "M4 6h16M4 12h16M4 18h16M14 4v4M8 10v4M16 16v4")];
    private void Navigate(string id) { active = id; open = false; }
}
