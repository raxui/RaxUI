@inherits PanelExampleBase
<Button Variant="secondary" OnClick="@(() => open = true)"><PanelIcon Path="M12 3v12M7 8l5-5 5 5M5 14v5h14v-5" />@T("Share", "مشاركة")</Button>
<Drawer @bind-Open="open" Title="@T("Share “Roadmap”", "مشاركة «خطة العمل»")" Description="@T("Anyone with the link can view.", "يمكن لأي شخص يملك الرابط المشاهدة.")" HandleLabel="@T("Resize drawer", "تغيير ارتفاع الدروير")">
    <ChildContent><Input @bind-Value="link" readonly aria-label="@T("Link", "الرابط")" /></ChildContent>
    <Footer>
        <Button Variant="tinted" OnClick="@(() => invite = true)">@T("Invite people…", "دعوة أشخاص…")</Button>
        <Drawer @bind-Open="invite" Title="@T("Invite people", "دعوة أشخاص")" Description="@T("The drawer behind steps back while this one is open.", "تتراجع اللوحة الخلفية أثناء فتح هذه اللوحة.")" HandleLabel="@T("Resize drawer", "تغيير ارتفاع الدروير")">
            <ChildContent><Input @bind-Value="email" type="email" placeholder="name@company.com" aria-label="@T("Email", "البريد الإلكتروني")" /></ChildContent>
            <Footer><Button OnClick="Send">@T("Send invite", "إرسال الدعوة")</Button></Footer>
        </Drawer>
        <Button Variant="ghost" OnClick="@(() => open = false)">@T("Done", "تم")</Button>
    </Footer>
</Drawer>
@code { private bool open, invite; private string link = "https://SheenUI.dev/d/roadmap", email = ""; private void Send() { invite = false; Notify("Invitation sent", "تم إرسال الدعوة"); } }
