@inherits PanelExampleBase
<Button Variant="ghost" OnClick="@(() => open = true)">@T($"Filters ({Side})", $"التصفية ({(Side == "right" ? "يمين" : "يسار")})")</Button>
<Drawer @bind-Open="open" Side="@Side" Title="@T("Filters", "التصفية")" Description="@T("Swipe it back toward the edge to close.", "اسحب اللوحة باتجاه الحافة لإغلاقها.")">
    <ChildContent>@for (var i = 0; i < choices.Length; i++) { var index = i;var label = choices[i];<label class="d-flex align-items-center justify-content-between py-2">@T(label.English, label.Arabic)<Switch @bind-Value="values[index]" Class="form-check-sm" /></label> }</ChildContent>
    <Footer><Button OnClick="@(() => open = false)">@T("Show results", "عرض النتائج")</Button></Footer>
</Drawer>
@code {
    [Parameter] public string Side { get; set; } = "right";
    private bool open; private readonly bool[] values = [true, false, false, false];
    private readonly (string English, string Arabic)[] choices = [("Open now", "مفتوح الآن"), ("Free Wi-Fi", "واي فاي مجاني"), ("Outdoor seating", "جلسات خارجية"), ("Wheelchair access", "سهولة الوصول للكراسي المتحركة")];
}
