<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>blazorui</ToolCommandName>
    <PackageId>BlazorUI.Cli</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Description>Source-first Blazor UI components installed into your project.</Description>
    <Authors>SaadAlsaree</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/SaadAlsaree/BlazorUI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>blazor;components;bootstrap;cli</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <AssemblyMetadata Include="RegistryVersion" Value="$(Version)" />
    <EmbeddedResource Include="..\..\registry\**\*" LinkBase="registry" />
  </ItemGroup>

</Project>
