<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Runs on whichever supported SDK the developer has (ADR 009); clears the single TFM from Directory.Build.props. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>raxui</ToolCommandName>
    <PackageId>RaxUI</PackageId>
    <Version>0.1.0-preview.4</Version>
    <Description>Source-first Blazor UI components installed into your project.</Description>
    <Authors>SaadAlsaree</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://raxui.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/raxui/RaxUI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>blazor;components;bootstrap;cli</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>raxui-logo.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/assets/raxui-logo.png" Pack="true" PackagePath="/" />
    <AssemblyMetadata Include="RegistryVersion" Value="$(Version)" />
    <!-- The Blazor registry; React's (registry/react) ships with the Node CLI (ADR 006). LinkBase keeps
         resource names at RaxUI.Cli.registry.*, as before the move to registry/blazor/. -->
    <EmbeddedResource Include="..\..\registry\blazor\**\*" LinkBase="registry" />
  </ItemGroup>

</Project>
