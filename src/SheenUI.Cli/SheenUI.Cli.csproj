<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Runs on whichever supported SDK the developer has (ADR 009); clears the single TFM from Directory.Build.props. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sheenui</ToolCommandName>
    <PackageId>SheenUI.Cli</PackageId>
    <Version>0.1.0-preview.2</Version>
    <Description>Source-first Blazor UI components installed into your project.</Description>
    <Authors>SaadAlsaree</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/SaadAlsaree/SheenUI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>blazor;components;bootstrap;cli</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <AssemblyMetadata Include="RegistryVersion" Value="$(Version)" />
    <!-- The React registry ships with the Node CLI, not this tool (ADR 006). -->
    <EmbeddedResource Include="..\..\registry\**\*" Exclude="..\..\registry\react\**" LinkBase="registry" />
  </ItemGroup>

</Project>
