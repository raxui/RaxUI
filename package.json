{
  "name": "sheenui-monorepo",
  "private": true,
  "type": "module",
  "description": "Node tooling for the SheenUI React library, shared theme, and their tests.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:full": "node scripts/check.mjs --full",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "test:acceptance": "playwright test -c tests/react/acceptance install.spec.ts",
    "test:acceptance:next": "playwright test -c tests/react/acceptance next.spec.ts",
    "theme:css": "node theme/build-css.mjs"
  },
  "devDependencies": {
    "@hookform/resolvers": "5.9.2",
    "@playwright/test": "1.64.1",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-hover-card": "1.2.1",
    "@radix-ui/react-menubar": "1.2.1",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "bootstrap": "5.3.8",
    "clsx": "2.1.1",
    "jsdom": "30.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.91.0",
    "sass": "1.106.1",
    "typescript": "5.9.3",
    "vaul": "1.1.2",
    "vitest": "5.0.3",
    "zod": "4.6.7"
  }
}
