{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/components/ui/popover": ["registry/react/components/popover/popover.tsx"],
      "@/components/ui/input": ["registry/react/components/input/input.tsx"],
      "@/components/ui/field": ["registry/react/components/field/field.tsx"],
      "@/lib/*": ["registry/react/foundation/*"],
      "@/components/ui/button": ["registry/react/components/button/button.tsx"]
    }
  },
  "include": ["registry/react", "tests/react"],
  // Byte-for-byte copies of the Vite template, compared by hash, not compiled here.
  "exclude": ["tests/react/fixtures"]
}
