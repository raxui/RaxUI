{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/components/ui/select": ["registry/react/components/select/select.tsx"],
      "@/components/ui/checkbox": ["registry/react/components/checkbox/checkbox.tsx"],
      "@/components/ui/data-table": ["registry/react/components/data-table/data-table.tsx"],
      "@/components/ui/data-grid": ["registry/react/components/data-grid/data-grid.tsx"],
      "@/components/ui/sortable": ["registry/react/components/sortable/sortable.tsx"],
      "@/components/ui/resizable": ["registry/react/components/resizable/resizable.tsx"],
      "@/components/ui/table": ["registry/react/components/table/table.tsx"],
      "@/components/ui/navbar": ["registry/react/components/navbar/navbar.tsx"],
      "@/components/ui/sidebar": ["registry/react/components/sidebar/sidebar.tsx"],
      "@/components/ui/navigation-menu": ["registry/react/components/navigation-menu/navigation-menu.tsx"],
      "@/components/ui/menubar": ["registry/react/components/menubar/menubar.tsx"],
      "@/components/ui/footer": ["registry/react/components/footer/footer.tsx"],
      "@/components/ui/banner": ["registry/react/components/banner/banner.tsx"],
      "@/components/ui/menu-toggle": ["registry/react/components/menu-toggle/menu-toggle.tsx"],
      "@/components/ui/skeleton": ["registry/react/components/skeleton/skeleton.tsx"],
      "@/components/ui/alert": ["registry/react/components/alert/alert.tsx"],
      "@/components/ui/tooltip": ["registry/react/components/tooltip/tooltip.tsx"],
      "@/components/ui/hover-card": ["registry/react/components/hover-card/hover-card.tsx"],
      "@/components/ui/toast": ["registry/react/components/toast/toast.tsx"],
      "@/components/ui/sheet": ["registry/react/components/sheet/sheet.tsx"],
      "@/components/ui/drawer": ["registry/react/components/drawer/drawer.tsx"],
      "@/components/ui/context-menu": ["registry/react/components/context-menu/context-menu.tsx"],
      "@/components/ui/command": ["registry/react/components/command/command.tsx"],
      "@/components/ui/toaster": ["registry/react/components/toast/toaster.tsx"],
      "@/components/ui/use-toast": ["registry/react/components/toast/use-toast.ts"],
      "@/components/ui/spinner": ["registry/react/components/spinner/spinner.tsx"],
      "@/components/ui/dropdown-menu": ["registry/react/components/dropdown-menu/dropdown-menu.tsx"],
      "@/components/ui/popover": ["registry/react/components/popover/popover.tsx"],
      "@/components/ui/date-picker": ["registry/react/components/date-picker/date-picker.tsx"],
      "@/components/ui/date-range-presets": ["registry/react/components/calendar/date-range-presets.ts"],
      "@/components/ui/calendar": ["registry/react/components/calendar/calendar.tsx"],
      "@/components/ui/time-picker": ["registry/react/components/time-picker/time-picker.tsx"],
      "@/components/ui/date-input": ["registry/react/components/date-input/date-input.tsx"],
      "@/components/ui/input": ["registry/react/components/input/input.tsx"],
      "@/components/ui/field": ["registry/react/components/field/field.tsx"],
      "@/lib/*": ["registry/react/foundation/*"],
      "@/components/ui/button": ["registry/react/components/button/button.tsx"]
