@* Source-owned progress/navigation. Built-in icon paths from Lucide (ISC). *@
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
<CascadingValue Value="this"><div @ref="root" @attributes="AdditionalAttributes" class="@($"rax-stepper {Class}")" data-orientation="@Orientation" data-size="@Size" data-rax-appearance="@Appearance">
<div class="rax-stepper-nav" data-orientation="@Orientation" data-labels="@(Orientation=="horizontal"?LabelPlacement:null)"><ol class="rax-stepper-list" aria-label="@Label">
@for(var i=0;i<Items.Count;i++){
 var index=i;var item=Items[index];var state=item.Error||item.ErrorMessage is not null?"error":index==Value?"active":item.Completed||index<Value?"complete":"upcoming";
 <li class="rax-step" data-state="@state" aria-current="@(index==Value?"step":null)">
 @if(ValueChanged.HasDelegate){<button type="button" id="@(Id+"-step-"+index)" class="rax-step-trigger" disabled="@(!ready||Busy||item.Disabled||(Linear&&index>Value))" @onclick="()=>Change(index)">@Contents(item,index,state)</button>}
 else{<a id="@(Id+"-step-"+index)" class="rax-step-trigger" href="@item.Href">@Contents(item,index,state)</a>}
 @if(index<Items.Count-1){<span class="rax-step-connector" data-filled="@(index<Value?"":null)" aria-hidden="true"></span>}
 @if(Orientation=="vertical"&&index==Value&&item.Content is not null){<div class="rax-step-content">@item.Content</div>}
 </li>
}
</ol><p class="rax-stepper-count" aria-live="polite">@(Value<Items.Count?StepLabel?.Invoke(Value+1,Items.Count)??$"{Value+1} / {Items.Count}":CompletedLabel) @if(Value>=0&&Value<Items.Count){@(" ")<span class="rax-stepper-count-title">@Items[Value].Title</span>}</p></div>
@ChildContent
</div></CascadingValue>
@code {
    public record Item(string Title,string? Description=null,string? Href=null,bool Completed=false,bool Error=false,RenderFragment? Icon=null,bool Optional=false,RenderFragment? Content=null,string? ErrorMessage=null,bool Disabled=false);
    [Parameter] public IReadOnlyList<Item> Items { get; set; }=Array.Empty<Item>();
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public bool Linear { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string Orientation { get; set; }="horizontal";
    [Parameter] public string LabelPlacement { get; set; }="end";
    [Parameter] public string Size { get; set; }="default";
    [Parameter] public string Label { get; set; }="Progress";
    [Parameter] public string CompletedLabel { get; set; }="Completed";
    [Parameter] public string CurrentLabel { get; set; }="Current step";
    [Parameter] public string UpcomingLabel { get; set; }="Upcoming";
    [Parameter] public string ErrorLabel { get; set; }="Has an error";
    [Parameter] public string OptionalLabel { get; set; }="Optional";
    [Parameter] public Func<int,int,string>? StepLabel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Appearance { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues=true)] public IDictionary<string,object>? AdditionalAttributes { get; set; }
    public string Id { get; }=$"rax-stepper-{Guid.NewGuid():N}";
    public string Movement { get; private set; }="forward";
    private int previous;
    private bool ready;
    private ElementReference root;
    private IJSObjectReference? module;
    protected override void OnParametersSet(){if(Value<0||Value>Items.Count)throw new ArgumentOutOfRangeException(nameof(Value));if(Orientation is not ("horizontal" or "vertical"))throw new ArgumentException("Invalid stepper orientation.");Movement=Value<previous?"backward":"forward";previous=Value;}
    private async Task Change(int value){if(Busy||value<0||value>=Items.Count||Items[value].Disabled||(Linear&&value>Value))return;await ValueChanged.InvokeAsync(value);}
    private RenderFragment Contents(Item item,int index,string state)=>@<text><span class="rax-step-indicator" aria-hidden="true">@if(state=="complete"){<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5" /></svg>}else if(state=="error"){<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 7v6M12 17h.01" /></svg>}else if(item.Icon is not null){@item.Icon}else{@(index+1)}</span><span class="rax-step-text"><span class="rax-step-title">@item.Title</span>@if(item.Optional){<span class="rax-step-description">@OptionalLabel</span>}@if(item.Description is not null){<span class="rax-step-description">@item.Description</span>}@if(item.ErrorMessage is not null){<span class="rax-step-description text-danger">@item.ErrorMessage</span>}</span><span class="visually-hidden">@(state=="error"?ErrorLabel:state=="complete"?CompletedLabel:state=="active"?CurrentLabel:UpcomingLabel)</span></text>;
    protected override async Task OnAfterRenderAsync(bool firstRender){if(!firstRender)return;module=await JS.InvokeAsync<IJSObjectReference>("import","./Components/UI/Stepper/Stepper.razor.js");await module.InvokeVoidAsync("init",root);ready=true;StateHasChanged();}
    public async ValueTask DisposeAsync(){if(module is null)return;try{await module.InvokeVoidAsync("dispose",root);await module.DisposeAsync();}catch(JSDisconnectedException){}}
}
