@using SheenUI.Internal.QrCode
@implements IAsyncDisposable
@inject IJSRuntime JS
<div @ref="element" @attributes="AdditionalAttributes" class="sheen-qr-code @Class" data-state="@(error is null ? "ready" : "error")" data-format="@Format" style="@Style">
@if(error is null){
<div class="sheen-qr-code-frame" data-qr-frame><div data-qr-svg>@((MarkupString)svg)</div>@if(Format=="canvas"){<canvas data-qr-canvas role="img" aria-label="@Label" style="display:none;width:100%;height:100%"></canvas>}else if(Format=="image"){<img data-qr-image alt="@Label" width="@Size" height="@Size" style="display:none;width:100%;height:100%" />}</div>
@if(Overlay is not null){<div class="sheen-qr-code-overlay">@Overlay</div>}
@if(Downloads){<div class="d-flex gap-2"><Button Variant="outline" Size="sm" Disabled="@(!ready)" data-qr-download="png" aria-label="@PngLabel">PNG</Button><Button Variant="outline" Size="sm" Disabled="@(!ready)" data-qr-download="svg" aria-label="@SvgLabel">SVG</Button></div>}
}else{<div role="alert">@ErrorLabel</div>}
@ChildContent
</div>
@code {
 [Parameter] public string Value {get;set;}="";
 [Parameter] public int Size {get;set;}=200;
 [Parameter] public string Level {get;set;}="M";
 [Parameter] public int Margin {get;set;}=2;
 [Parameter] public string Shape {get;set;}="square";
 [Parameter] public string Format {get;set;}="svg";
 [Parameter] public string ForegroundColor {get;set;}="#000000";
 [Parameter] public string BackgroundColor {get;set;}="#ffffff";
 [Parameter] public string Label {get;set;}="QR code";
 [Parameter] public string ErrorLabel {get;set;}="Unable to generate QR code.";
 [Parameter] public RenderFragment? Overlay {get;set;}
 [Parameter] public bool Downloads {get;set;}
 [Parameter] public string Filename {get;set;}="qrcode";
 [Parameter] public int? Resolution {get;set;}
 [Parameter] public string PngLabel {get;set;}="Download PNG";
 [Parameter] public string SvgLabel {get;set;}="Download SVG";
 [Parameter] public EventCallback OnGenerated {get;set;}
 [Parameter] public EventCallback<string> OnError {get;set;}
 [Parameter] public RenderFragment? ChildContent {get;set;}
 [Parameter] public string? Class {get;set;}
 [Parameter(CaptureUnmatchedValues=true)] public IDictionary<string,object>? AdditionalAttributes {get;set;}
 private string? encodedValue,encodedLevel,error;
 private string svg="";
 private QrCodeEncoder? matrix;
 private bool ready,disposed,notify;
 private readonly string id=Guid.NewGuid().ToString("N");
 private int hole;
 private ElementReference element;
 private IJSObjectReference? module;
 private string Style=>FormattableString.Invariant($"--sheen-qr-size:{Size}px;--sheen-qr-hole:{(matrix is null?0:hole*Size/(double)(matrix.size+Margin*2))}px;--sheen-qr-bg:{BackgroundColor};")+(AdditionalAttributes?.TryGetValue("style",out var userStyle)==true?userStyle?.ToString():"");
 protected override void OnParametersSet(){
 if(Size<1||Size>4096||Margin<0||Margin>100||Resolution is <1 or >8192)throw new ArgumentOutOfRangeException(nameof(Size));
 if(Shape is not ("square" or "rounded" or "dots")||Format is not ("svg" or "canvas" or "image"))throw new ArgumentException("Invalid QR shape or format.");
 if(!SafeColor(ForegroundColor)||!SafeColor(BackgroundColor))throw new ArgumentException("Use a solid SVG color, not a URL or CSS expression.");
 if(Value!=encodedValue||Level!=encodedLevel||matrix is null&&error is null){
 encodedValue=Value;encodedLevel=Level;notify=true;
 try{var ecc=Level switch{"L"=>QrCodeEncoder.Ecc.LOW,"M"=>QrCodeEncoder.Ecc.MEDIUM,"Q"=>QrCodeEncoder.Ecc.QUARTILE,"H"=>QrCodeEncoder.Ecc.HIGH,_=>throw new ArgumentException("Invalid error correction level.")};matrix=QrCodeEncoder.encodeSegments(QrCodeSegment.makeSegments(string.IsNullOrEmpty(Value)?" ":Value),ecc,boostEcl:false);error=null;}catch(ArgumentException e){matrix=null;error=e.Message;}
 }
 if(matrix is not null){hole=Overlay is null?0:Math.Max(3,(int)Math.Floor(((matrix.size+Margin*2)*.22-1)/2+.5)*2+1);svg=QrCodeDrawing.Svg(matrix,Size,Margin,Shape,hole,ForegroundColor,BackgroundColor,Label);}
 }
 private static bool SafeColor(string color)=>!string.IsNullOrWhiteSpace(color)&&System.Text.RegularExpressions.Regex.IsMatch(color,@"\A(?:#[0-9a-fA-F]{3,8}|[a-zA-Z]+|rgba?\([0-9.,%\s]+\)|hsla?\([0-9.,%\s]+\))\z");
 protected override async Task OnAfterRenderAsync(bool firstRender){
 if(disposed)return;
 module??=await JS.InvokeAsync<IJSObjectReference>("import","./Components/UI/QRCode/QRCode.razor.js");
 if(disposed){await module.DisposeAsync();return;}
 await module.InvokeVoidAsync("sync",element,new{id,format=Format,filename=Filename,resolution=Resolution??Math.Min(Size*4,8192)});
 if(!ready){ready=true;StateHasChanged();}
 if(notify){notify=false;if(error is null)await OnGenerated.InvokeAsync();else await OnError.InvokeAsync(error);}
 }
 public async ValueTask DisposeAsync(){disposed=true;if(module is not null){try{await module.InvokeVoidAsync("dispose",id);await module.DisposeAsync();}catch(JSDisconnectedException){}}}
}
