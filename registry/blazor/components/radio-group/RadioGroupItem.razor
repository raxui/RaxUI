@* SheenUI RadioGroupItem. Source-owned: edit freely. The React circle and growing dot (with boot-ui's press and ring)
   around a real radio, so it posts in static SSR and needs no JavaScript. *@
@using Microsoft.AspNetCore.Components.Forms
@typeparam TValue
<span class="@($"sheen-radio sheen-radio-native {Class} {ExtraClass}".TrimEnd())">
    <InputRadio TValue="TValue" @attributes="AdditionalAttributes" Value="Value" class="sheen-radio-input" />
    <span class="sheen-radio-indicator" aria-hidden="true"></span>
</span>
@code {
    /// <summary>Option value. Give each option a distinct id and label.</summary>
    [Parameter] public TValue Value { get; set; } = default!;
    [Parameter] public string? Class { get; set; }
    private string? ExtraClass => AdditionalAttributes is not null && AdditionalAttributes.TryGetValue("class", out var value) ? Convert.ToString(value) : null;
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
}
