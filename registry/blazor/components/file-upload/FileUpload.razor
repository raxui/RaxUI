@* SheenUI FileUpload. Source-owned: edit freely. InputFile handles interactive selection; native multipart posts work in static SSR. *@
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
<div class="@($"sheen-file-upload {Class}")" data-sheen-appearance="@Appearance" @ref="_root">
    <label class="sheen-upload-zone" data-disabled="@(IsDisabled ? "true" : null)">
        <InputFile @key="_generation" @attributes="Attributes" OnChange="Selected" accept="@Accept" multiple="@(MaxFiles > 1)" class="sheen-upload-input" />
        @* Built-in icon paths from Lucide (ISC). *@
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12" /></svg>
        <span>@Label</span>
    </label>
    @if (_error is not null) { <p id="@(ControlId + "-upload-error")" role="alert" class="sheen-field-error">@_error</p> }
    <ul class="sheen-upload-list">
        @foreach (var file in Value)
        {
            var progress = Progress?.Invoke(file);
            var percent = Math.Clamp(double.IsFinite(progress ?? 0) ? progress ?? 0 : 0, 0, 100);
            <li class="sheen-upload-file">
                <span>@file.Name</span>
                <button type="button" disabled="@(IsDisabled)" title="@($"{RemoveLabel} {file.Name}")" aria-label="@($"{RemoveLabel} {file.Name}")" @onclick="@(() => Remove(file))"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg></button>
                @if (progress.HasValue)
                {
                    <div class="progress" role="progressbar" aria-label="@file.Name" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent">
                        <div class="progress-bar" style="@($"width: {percent.ToString(System.Globalization.CultureInfo.InvariantCulture)}%")"></div>
                    </div>
                }
            </li>
        }
    </ul>
</div>
@code {
    [Parameter] public IReadOnlyList<IBrowserFile> Value { get; set; } = Array.Empty<IBrowserFile>();
    [Parameter] public EventCallback<IReadOnlyList<IBrowserFile>> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<IReadOnlyList<IBrowserFile>>>? ValueExpression { get; set; }
    [Parameter] public string? Accept { get; set; }
    [Parameter] public long MaxSize { get; set; } = 10 * 1024 * 1024;
    [Parameter] public int MaxFiles { get; set; } = 1;
    [Parameter] public Func<IBrowserFile, double?>? Progress { get; set; }
    [Parameter] public string Label { get; set; } = "Choose files or drop them here";
    [Parameter] public string RemoveLabel { get; set; } = "Remove";
    [Parameter] public string TypeMessage { get; set; } = "This file type is not allowed.";
    [Parameter] public string SizeMessage { get; set; } = "This file is too large.";
    [Parameter] public string CountMessage { get; set; } = "Too many files selected.";
    [Parameter] public EventCallback<string> OnError { get; set; }
    [CascadingParameter] private EditContext? EditContext { get; set; }
    private ValidationMessageStore? _messages;
    private EditContext? _context;
    private string? _error;
    private ElementReference _root;
    private IJSObjectReference? _module;
    private int _generation;
    private FieldIdentifier? Identifier => ValueExpression is null ? null : FieldIdentifier.Create(ValueExpression);
    private Dictionary<string, object> Attributes
    {
        get
        {
            var attrs = ControlAttributes;
            if (!attrs.ContainsKey("name") && Identifier is { } identifier) attrs["name"] = identifier.FieldName;
            if (_error is not null) { attrs["aria-invalid"] = "true"; attrs["aria-describedby"] = $"{attrs.GetValueOrDefault("aria-describedby")} {ControlId}-upload-error".Trim(); }
            return attrs;
        }
    }
    protected override void OnParametersSet()
    {
        if (MaxFiles < 1 || MaxSize < 0) throw new ArgumentOutOfRangeException(nameof(MaxFiles));
        if (_context != EditContext) { _messages?.Clear(); _context = EditContext; _messages = EditContext is null ? null : new(EditContext); }
    }
    private bool Accepts(IBrowserFile file) => string.IsNullOrWhiteSpace(Accept) || Accept.Split(',').Any(raw =>
    {
        var rule = raw.Trim();
        if (rule.StartsWith('.')) return file.Name.EndsWith(rule, StringComparison.OrdinalIgnoreCase);
        return rule.EndsWith("/*") ? file.ContentType.StartsWith(rule[..^1], StringComparison.OrdinalIgnoreCase) : file.ContentType.Equals(rule, StringComparison.OrdinalIgnoreCase);
    });
    private async Task Selected(InputFileChangeEventArgs args)
    {
        if (IsDisabled) return;
        _error = args.FileCount > MaxFiles ? CountMessage : null;
        IReadOnlyList<IBrowserFile> files = Array.Empty<IBrowserFile>();
        if (_error is null)
        {
            files = args.GetMultipleFiles(MaxFiles);
            _error = files.Any(f => !Accepts(f)) ? TypeMessage : files.Any(f => f.Size > MaxSize) ? SizeMessage : null;
        }
        _messages?.Clear();
        if (_error is not null)
        {
            if (Identifier is { } identifier) _messages?.Add(identifier, _error);
            _generation++; // Invalid native selection must not be posted later.
            await Change(Array.Empty<IBrowserFile>());
            EditContext?.NotifyValidationStateChanged();
            await OnError.InvokeAsync(_error); return;
        }
        await Change(files);
    }
    private async Task Change(IReadOnlyList<IBrowserFile> files)
    {
        Value = files; await ValueChanged.InvokeAsync(files);
        if (Identifier is { } identifier) EditContext?.NotifyFieldChanged(identifier);
        EditContext?.NotifyValidationStateChanged();
    }
    private async Task Remove(IBrowserFile file)
    {
        if (IsDisabled) return;
        _error = null; _messages?.Clear();
        await Change(Value.Where(f => !ReferenceEquals(f, file)).ToArray());
        if (_module is not null) await _module.InvokeVoidAsync("remove", _root, file.Name, file.Size, file.LastModified.ToUnixTimeMilliseconds());
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/UI/FileUpload/FileUpload.razor.js");
        await _module.InvokeVoidAsync("init", _root);
    }
    public async ValueTask DisposeAsync()
    {
        _messages?.Clear();
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("dispose", _root); await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
    private bool IsDisabled => ControlAttributes.TryGetValue("disabled", out var disabled) && disabled is true;
    [CascadingParameter] private Field.FieldContext? FieldContext { get; set; }
    /// <summary>default, flat, or glass; null inherits the surrounding theme.</summary>
    [Parameter] public string? Appearance { get; set; }
    /// <summary>Extra CSS classes appended to the control.</summary>
    [Parameter] public string? Class { get; set; }
    private string? ExtraClass => AdditionalAttributes is not null && AdditionalAttributes.TryGetValue("class", out var value) ? Convert.ToString(value) : null;
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    private readonly string _autoId = $"sheen-control-{Guid.NewGuid():N}";
    private Dictionary<string, object> ControlAttributes
    {
        get
        {
            var attrs = FieldContext is null ? new Dictionary<string, object>() : new(FieldContext.ControlAttributes);
            if (AdditionalAttributes is not null)
                foreach (var pair in AdditionalAttributes) attrs[pair.Key] = pair.Value;
            if (!attrs.ContainsKey("id")) attrs["id"] = _autoId;
            return attrs;
        }
    }
    private string ControlId => Convert.ToString(ControlAttributes["id"])!;

}
