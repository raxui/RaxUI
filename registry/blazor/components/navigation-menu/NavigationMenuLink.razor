<a data-enhance-nav="@(PreventDefault ? "false" : null)" @onclick:preventDefault="@PreventDefault" @attributes="AdditionalAttributes" href="@Href" class="@(TriggerStyle ? "rax-nav-trigger" : "rax-nav-link") @Class" aria-current="@((Active ?? Parent?.IsCurrent(Href) ?? false) ? "page" : null)" data-active="@((Active ?? Parent?.IsCurrent(Href) ?? false) ? "" : null)" @onclick="OnClick">@ChildContent</a>
@code {
    [Parameter] public bool PreventDefault { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [CascadingParameter] public NavigationMenu? Parent { get; set; }
    [Parameter] public string Href { get; set; } = "/";
    [Parameter] public bool? Active { get; set; }
    [Parameter] public bool TriggerStyle { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
}
