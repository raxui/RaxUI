<div @attributes="AdditionalAttributes" id="@(Parent?.Id + "-content")" class="rax-nav-content @Class" data-nav-content data-shell-value="@Parent?.Key" aria-labelledby="@(Parent?.Id + "-trigger")" tabindex="-1">@ChildContent</div>
@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [CascadingParameter] public NavigationMenuItem? Parent { get; set; }
}
