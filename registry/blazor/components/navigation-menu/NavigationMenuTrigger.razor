@* Lucide ChevronDown, ISC. *@
<button @attributes="AdditionalAttributes" type="button" class="rax-nav-trigger @Class" id="@(Parent?.Id + "-trigger")" data-nav-trigger data-shell-value="@Parent?.Key" aria-expanded="false" aria-controls="@(Parent?.Id + "-content")" disabled="@(Disabled || Parent?.Root?.Ready != true)">@ChildContent<svg class="rax-nav-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button>
@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [CascadingParameter] public NavigationMenuItem? Parent { get; set; }
    [Parameter] public bool Disabled { get; set; }
}
