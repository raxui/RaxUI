@* SheenUI Accordion. Source-owned: edit freely. Native details work in static SSR. *@
<CascadingValue Value="this">
    <div @attributes="AdditionalAttributes" class="@($"sheen-accordion {Class}")" data-variant="@Variant" data-sheen-appearance="@Appearance">@ChildContent</div>
</CascadingValue>
@code {
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public string Name { get; set; } = $"sheen-accordion-{Guid.NewGuid():N}";
    [Parameter] public string Variant { get; set; } = "default";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Appearance { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
}
