@* SheenUI Checkbox. Source-owned: edit freely. Native form behavior also works in static SSR. *@
@using Microsoft.AspNetCore.Components.Forms

<InputCheckbox @attributes="Attributes" role="checkbox" class="@($"form-check-input sheen-checkbox-native {Class} {ExtraClass}".TrimEnd())"
               data-sheen-appearance="@Appearance" Value="Value" ValueChanged="Changed" ValueExpression="ValueExpression" />
@code {
    /// <summary>Mixed state, announced as aria-checked=mixed; activating the native checkbox selects it.</summary>
    [Parameter] public bool Indeterminate { get; set; }
    [Parameter] public EventCallback<bool> IndeterminateChanged { get; set; }
    private async Task Changed(bool value)
    {
        if (Indeterminate) { Indeterminate = false; await IndeterminateChanged.InvokeAsync(false); }
        await ValueChanged.InvokeAsync(value);
    }

    /// <summary>Bound value, including EditContext validation and static SSR form mapping.</summary>
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<bool>>? ValueExpression { get; set; }

    [CascadingParameter] private Field.FieldContext? FieldContext { get; set; }
    /// <summary>default, flat, or glass; null inherits the surrounding theme.</summary>
    [Parameter] public string? Appearance { get; set; }
    /// <summary>Extra CSS classes appended to the control.</summary>
    [Parameter] public string? Class { get; set; }
    private string? ExtraClass => AdditionalAttributes is not null && AdditionalAttributes.TryGetValue("class", out var value) ? Convert.ToString(value) : null;
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    private readonly string _autoId = $"sheen-control-{Guid.NewGuid():N}";
    private Dictionary<string, object> ControlAttributes
    {
        get
        {
            var attrs = FieldContext is null ? new Dictionary<string, object>() : new(FieldContext.ControlAttributes);
            if (AdditionalAttributes is not null)
                foreach (var pair in AdditionalAttributes) attrs[pair.Key] = pair.Value;
            if (!attrs.ContainsKey("id")) attrs["id"] = _autoId;
            return attrs;
        }
    }
    private string ControlId => Convert.ToString(ControlAttributes["id"])!;

    private Dictionary<string, object> Attributes
    {
        get
        {
            var attrs = ControlAttributes;
            if (Indeterminate) { attrs.TryAdd("aria-checked", "mixed"); attrs.TryAdd("data-indeterminate", "true"); }
            return attrs;
        }
    }
}
