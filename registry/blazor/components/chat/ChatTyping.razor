<div @attributes="AdditionalAttributes" class="sheen-chat-group sheen-chat-typing @Class" data-from="other"><div class="sheen-chat-avatar">@Avatar</div><div class="sheen-chat-stack"><div class="sheen-chat-row"><div class="sheen-chat-bubble" role="status" aria-label="@Label"><span class="sheen-chat-dots" aria-hidden="true"><span></span><span></span><span></span></span></div></div></div></div>
@code {
    [Parameter] public string Label { get; set; } = "Someone is typing";
    [Parameter] public RenderFragment? Avatar { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
}
