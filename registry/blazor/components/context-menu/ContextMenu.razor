@* SheenUI ContextMenu. Source-owned: edit freely. Reuses DropdownMenu items. Requires interactivity. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_target" class="sheen-context-target @TargetClass" tabindex="0" aria-haspopup="menu" aria-controls="@_id" aria-expanded="false">@Target</div>
<div @ref="_menu" @attributes="AdditionalAttributes" id="@_id" popover="manual" role="menu" tabindex="-1"
     aria-label="@Label" class="sheen-dropdown-menu sheen-context-menu @Class" data-sheen-appearance="@Appearance">@ChildContent</div>

@code {
    private readonly string _generatedId = "sheen-context-" + Guid.NewGuid().ToString("N");
    private ElementReference _target, _menu;
    private IJSObjectReference? _module;
    private string _id => Id ?? _generatedId;
    [Parameter] public string? Id { get; set; }
    [Parameter] public RenderFragment? Target { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Label { get; set; } = "Actions";
    [Parameter] public string? TargetClass { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Appearance { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/UI/ContextMenu/ContextMenu.razor.js");
        await _module.InvokeVoidAsync("init", _target, _menu);
    }
    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("dispose", _menu); await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
