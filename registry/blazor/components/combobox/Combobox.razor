@* SheenUI Combobox. Source-owned: edit freely. Native select posts in static SSR; searchable listbox needs interactivity. *@
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
<InputSelect TValue="string" @attributes="NativeAttributes" hidden="@_interactive" class="@($"form-select {Class}")"
             Value="Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression">
    <option value="">@Placeholder</option>
    @foreach (var option in Options) { <option value="@option.Value" disabled="@option.Disabled">@option.Label</option> }
</InputSelect>
@if (_interactive)
{
    <Popover Id="@(_autoId + "-popup")" @bind-Open="_open" TriggerAttributes="ControlAttributes" TriggerClass="form-control sheen-input sheen-combobox-trigger"
             PopupRole="listbox" Role="dialog" Label="@SearchPlaceholder" Class="sheen-combobox-panel" Appearance="@Appearance">
        <Trigger>
            <span>@(Options.FirstOrDefault(o => o.Value == Value)?.Label ?? Placeholder)</span>
            @* ChevronsUpDown paths from Lucide (ISC). *@
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m7 15 5 5 5-5M7 9l5-5 5 5" /></svg>
        </Trigger>
        <ChildContent>
            <input @ref="_search" class="form-control sheen-input" role="combobox" aria-label="@SearchPlaceholder" placeholder="@SearchPlaceholder"
                   aria-autocomplete="list" aria-expanded="@(_open ? "true" : "false")" aria-controls="@(_autoId + "-list")"
                   value="@_query" @oninput="@((ChangeEventArgs args) => _query = Convert.ToString(args.Value) ?? "")" />
            <div @ref="_list" id="@(_autoId + "-list")" role="listbox" aria-label="@Placeholder">
                @foreach (var option in Filtered)
                {
                    <div id="@OptionId(option)" role="option" aria-selected="@(option.Value == Value ? "true" : "false")" aria-disabled="@(option.Disabled ? "true" : null)"
                         class="sheen-choice-option" data-value="@option.Value" @onclick="@(() => Select(option.Value))">@option.Label</div>
                }
            </div>
            @if (!Filtered.Any()) { <p class="sheen-choice-empty" role="status">@EmptyMessage</p> }
        </ChildContent>
    </Popover>
}
@code {
    public sealed record Option(string Value, string Label, bool Disabled = false);
    [Parameter] public IReadOnlyList<Option> Options { get; set; } = Array.Empty<Option>();
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<string>>? ValueExpression { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Choose an option";
    [Parameter] public string SearchPlaceholder { get; set; } = "Search options";
    [Parameter] public string EmptyMessage { get; set; } = "No options found.";
    [CascadingParameter] private EditContext? EditContext { get; set; }
    private bool _interactive, _open;
    private string _query = "";
    private ElementReference _search, _list;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Combobox>? _self;
    private IEnumerable<Option> Filtered => Options.Where(o => o.Label.Contains(_query, StringComparison.CurrentCultureIgnoreCase));
    private string OptionId(Option option) => $"{_autoId}-option-{Options.ToList().IndexOf(option)}";
    private Dictionary<string, object> NativeAttributes
    {
        get { var attrs = ControlAttributes; if (_interactive) attrs["id"] = ControlId + "-native"; return attrs; }
    }
    [JSInvokable] public async Task Select(string value)
    {
        if (IsDisabled || !Options.Any(o => o.Value == value && !o.Disabled)) return;
        Value = value; await ValueChanged.InvokeAsync(value);
        if (ValueExpression is not null) EditContext?.NotifyFieldChanged(FieldIdentifier.Create(ValueExpression));
        _open = false; _query = ""; StateHasChanged();
    }
    [JSInvokable] public void Close() { _open = false; StateHasChanged(); }
    [JSInvokable] public void Show() { if (!IsDisabled) { _open = true; StateHasChanged(); } }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_interactive) { _interactive = true; StateHasChanged(); return; }
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/UI/Popover/Popover.razor.js");
        _self ??= DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("initListbox", _search, _list, _self);
    }
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("disposeListbox", _search); await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
    private bool IsDisabled => ControlAttributes.TryGetValue("disabled", out var disabled) && disabled is true;
    [CascadingParameter] private Field.FieldContext? FieldContext { get; set; }
    /// <summary>default, flat, or glass; null inherits the surrounding theme.</summary>
    [Parameter] public string? Appearance { get; set; }
    /// <summary>Extra CSS classes appended to the control.</summary>
    [Parameter] public string? Class { get; set; }
    private string? ExtraClass => AdditionalAttributes is not null && AdditionalAttributes.TryGetValue("class", out var value) ? Convert.ToString(value) : null;
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    private readonly string _autoId = $"sheen-control-{Guid.NewGuid():N}";
    private Dictionary<string, object> ControlAttributes
    {
        get
        {
            var attrs = FieldContext is null ? new Dictionary<string, object>() : new(FieldContext.ControlAttributes);
            if (AdditionalAttributes is not null)
                foreach (var pair in AdditionalAttributes) attrs[pair.Key] = pair.Value;
            if (!attrs.ContainsKey("id")) attrs["id"] = _autoId;
            return attrs;
        }
    }
    private string ControlId => Convert.ToString(ControlAttributes["id"])!;

}
