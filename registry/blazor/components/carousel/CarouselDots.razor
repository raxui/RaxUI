<div @attributes="AdditionalAttributes" class="rax-carousel-dots @Class" data-variant="@Variant">@for(var i=0;i<Carousel.SnapCount;i++){<button type="button" class="rax-carousel-dot" data-carousel-index="@i" aria-label="@Carousel.GoToLabel(i)"><span class="rax-carousel-dot-progress" style="display:none"></span></button>}</div>
@code {
 [CascadingParameter] public Carousel Carousel {get;set;}=default!;
 [Parameter] public string Variant {get;set;}="default";
 [Parameter] public string? Class {get;set;}
 [Parameter(CaptureUnmatchedValues=true)] public IDictionary<string,object>? AdditionalAttributes {get;set;}
}
