<div @attributes="AdditionalAttributes" class="sheen-carousel-item @Class" role="group" aria-roledescription="@Carousel.Labels.Slide" aria-label="@Label">@ChildContent</div>
@code {
 [CascadingParameter] public Carousel Carousel {get;set;}=default!;
 [Parameter] public string? Label {get;set;}
 [Parameter] public string? Class {get;set;}
 [Parameter] public RenderFragment? ChildContent {get;set;}
 [Parameter(CaptureUnmatchedValues=true)] public IDictionary<string,object>? AdditionalAttributes {get;set;}
}
