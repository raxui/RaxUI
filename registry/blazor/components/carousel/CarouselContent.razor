<div class="sheen-carousel-viewport @ViewportClass" style="@ViewportStyle"><div @attributes="AdditionalAttributes" class="sheen-carousel-container @Class" aria-live="polite">@ChildContent</div></div>
@code {
 [Parameter] public string? ViewportClass {get;set;}
 [Parameter] public string? ViewportStyle {get;set;}
 [Parameter] public string? Class {get;set;}
 [Parameter] public RenderFragment? ChildContent {get;set;}
 [Parameter(CaptureUnmatchedValues=true)] public IDictionary<string,object>? AdditionalAttributes {get;set;}
}
