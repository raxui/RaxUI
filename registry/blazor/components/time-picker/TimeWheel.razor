@using Microsoft.JSInterop
@using CultureInfo = System.Globalization.CultureInfo
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="sheen-wheel">
    <div @ref="_root" role="listbox" aria-label="@Label" aria-activedescendant="@(Committed ? $"{_id}-{Selected}" : null)"
         aria-disabled="@(Disabled ? "true" : null)" tabindex="@(Disabled ? -1 : 0)" class="sheen-wheel-list" data-index="@Index"
         data-committed="@(Committed ? "" : null)" data-disabled="@(Disabled ? "" : null)">
        @foreach (var option in Options)
        {
            <div id="@($"{_id}-{option.Value}")" role="option" aria-selected="@(Committed && option.Value == Selected ? "true" : "false")" class="sheen-wheel-item">@option.Label</div>
        }
    </div>
</div>

@code {
    public record Option(int Value, string Label);
    public record Labels
    {
        public string Time { get; init; } = "Time";
        public string Hour { get; init; } = "Hour";
        public string Minute { get; init; } = "Minute";
        public string Period { get; init; } = "AM/PM";
        public string Year { get; init; } = "Year";
        public string Month { get; init; } = "Month";
        public string Day { get; init; } = "Day";
        public string Now { get; init; } = "Now";
        public string Done { get; init; } = "Done";
        public string Clear { get; init; } = "Clear time";
        public string Invalid { get; init; } = "Choose an available time.";
        public static Labels Arabic { get; } = new() { Time = "الوقت", Hour = "الساعة", Minute = "الدقيقة", Period = "صباحاً/مساءً", Year = "السنة", Month = "الشهر", Day = "اليوم", Now = "الآن", Done = "تم", Clear = "مسح الوقت", Invalid = "اختر وقتاً متاحاً." };
    }
    [Parameter] public IReadOnlyList<Option> Options { get; set; } = Array.Empty<Option>();
    [Parameter] public int Selected { get; set; }
    [Parameter] public EventCallback<int> SelectedChanged { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public bool Committed { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AutoFocus { get; set; }
    private readonly string _id = $"sheen-wheel-{Guid.NewGuid():N}";
    private int Index => Math.Max(0, Options.ToList().FindIndex(option => option.Value == Selected));
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<TimeWheel>? _self;
    private bool _disposed;
    public static string Digits(int number, CultureInfo culture, bool padded = false) => string.Concat(number.ToString(padded ? "D2" : "D", CultureInfo.InvariantCulture).Select(c => char.IsAsciiDigit(c) ? culture.NumberFormat.NativeDigits[c - '0'] : c.ToString()));
    public static bool TwelveHour(CultureInfo culture, int? cycle) => cycle.HasValue ? cycle == 12 : culture.DateTimeFormat.ShortTimePattern.Contains('h');
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        try
        {
            if (firstRender)
            {
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/UI/TimePicker/TimeWheel.razor.js");
                if (_disposed) { await module.DisposeAsync(); return; }
                _module = module;
                _self = DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("init", _root, _self, AutoFocus);
            }
            else if (_module is not null) await _module.InvokeVoidAsync("sync", _root);
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) when (_disposed) { }
    }
    [JSInvokable] public async Task Choose(int index)
    {
        if (!_disposed && !Disabled && index >= 0 && index < Options.Count) await SelectedChanged.InvokeAsync(Options[index].Value);
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _root); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (OperationCanceledException) { }
        }
        _self?.Dispose();
    }
}
