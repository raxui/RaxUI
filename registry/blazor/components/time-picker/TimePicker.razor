@using Microsoft.AspNetCore.Components.Forms
@using CultureInfo = System.Globalization.CultureInfo
@inherits InputBase<TValue>
@typeparam TValue

@if (Native || !_ready)
{
    <NativeTimePicker TValue="TValue" Value="CurrentValue" ValueChanged="NativeChanged" ValueExpression="ValueExpression" StartIcon="StartIcon"
                      Size="@Size" Variant="@Variant" Appearance="@Appearance" Class="@Class" ParsingErrorMessage="@(ParsingErrorMessage ?? Words.Invalid)" @attributes="NativeAttributes" />
}
else
{
    <div @attributes="ControlAttributes" role="group" class="@($"rax-time-wheel {CssClass} {Class}")" dir="ltr" data-rax-appearance="@Appearance" data-disabled="@(EffectiveDisabled || ReadOnly ? "" : null)">
        @StartIcon
        <span class="rax-wheel-band" aria-hidden="true"></span>
        <TimeWheel @key="H12" Options="Hours" Selected="@(H12 ? Shown.Hour % 12 == 0 ? 12 : Shown.Hour % 12 : Shown.Hour)" SelectedChanged="HourChanged" Label="@Words.Hour" Committed="HasValue" Disabled="@(EffectiveDisabled || ReadOnly)" AutoFocus="AutoFocus" />
        <span class="rax-wheel-colon" aria-hidden="true">:</span>
        <TimeWheel @key="MinuteStep" Options="Minutes" Selected="@OfferedMinute" SelectedChanged="MinuteChanged" Label="@Words.Minute" Committed="HasValue" Disabled="@(EffectiveDisabled || ReadOnly)" />
        @if (H12)
        {
            <TimeWheel Options="Periods" Selected="@(Shown.Hour >= 12 ? 1 : 0)" SelectedChanged="PeriodChanged" Label="@Words.Period" Committed="HasValue" Disabled="@(EffectiveDisabled || ReadOnly)" />
        }
    </div>
    <input type="hidden" name="@NameAttributeValue" value="@FormatValueAsString(CurrentValue)" disabled="@EffectiveDisabled" />
    @if (Clearable && HasValue && Nullable.GetUnderlyingType(typeof(TValue)) is not null && !ReadOnly)
    {
        <button type="button" class="btn btn-sm btn-link" disabled="@EffectiveDisabled" aria-label="@Words.Clear" @onclick="Clear">@Words.Clear</button>
    }
}

@code {
    [Parameter] public CultureInfo? Culture { get; set; }
    [Parameter] public TimeWheel.Labels? Text { get; set; }
    [Parameter] public int? HourCycle { get; set; }
    [Parameter] public int MinuteStep { get; set; } = 1;
    [Parameter] public TimeOnly? Now { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Clearable { get; set; }
    [Parameter] public bool Native { get; set; }
    [Parameter] public bool AutoFocus { get; set; }
    [Parameter] public string? Appearance { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string Size { get; set; } = "default";
    [Parameter] public string Variant { get; set; } = "outline";
    [Parameter] public string? ParsingErrorMessage { get; set; }
    [Parameter] public RenderFragment? StartIcon { get; set; }
    [CascadingParameter] private Field.FieldContext? FieldContext { get; set; }
    private readonly string _id = $"rax-time-{Guid.NewGuid():N}";
    private CultureInfo FormatCulture => Culture ?? CultureInfo.CurrentCulture;
    private TimeWheel.Labels Words => Text ?? (FormatCulture.TwoLetterISOLanguageName == "ar" ? TimeWheel.Labels.Arabic : new());
    private bool _ready;
    private TimeOnly _suggestion;
    private bool EffectiveDisabled => Disabled || FieldContext?.Disabled == true;
    private bool HasValue => CurrentValue is not null;
    private TimeOnly Shown { get { var suggestion = Now ?? _suggestion; return CurrentValue is TimeOnly time ? time : new TimeOnly(suggestion.Hour, suggestion.Minute / MinuteStep * MinuteStep); } }
    private bool H12 => TimeWheel.TwelveHour(FormatCulture, HourCycle);
    private int OfferedMinute => Math.Min((60 - 1) / MinuteStep * MinuteStep, (int)Math.Round((double)Shown.Minute / MinuteStep, MidpointRounding.AwayFromZero) * MinuteStep);
    private IReadOnlyList<TimeWheel.Option> Hours => Enumerable.Range(H12 ? 1 : 0, H12 ? 12 : 24).Select(h => new TimeWheel.Option(h, TimeWheel.Digits(h, FormatCulture, !H12))).ToArray();
    private IReadOnlyList<TimeWheel.Option> Minutes => Enumerable.Range(0, (59 / MinuteStep) + 1).Select(m => new TimeWheel.Option(m * MinuteStep, TimeWheel.Digits(m * MinuteStep, FormatCulture, true))).ToArray();
    private IReadOnlyList<TimeWheel.Option> Periods => new[] { new TimeWheel.Option(0, FormatCulture.DateTimeFormat.AMDesignator), new TimeWheel.Option(1, FormatCulture.DateTimeFormat.PMDesignator) };
    private Dictionary<string, object> ControlAttributes
    {
        get
        {
            var attrs = FieldContext is null ? new Dictionary<string, object>() : new(FieldContext.ControlAttributes);
            if (AdditionalAttributes is not null) foreach (var pair in AdditionalAttributes) attrs[pair.Key] = pair.Value;
            attrs.Remove("name"); attrs.Remove("class"); attrs.Remove("aria-required");
            if (!attrs.ContainsKey("id")) attrs["id"] = _id;
            if (!attrs.ContainsKey("aria-label") && !attrs.ContainsKey("aria-labelledby")) attrs["aria-label"] = Words.Time;
            if (EffectiveDisabled || ReadOnly) attrs["aria-disabled"] = "true";
            return attrs;
        }
    }
    private Dictionary<string, object> NativeAttributes
    {
        get
        {
            var attrs = ControlAttributes;
            attrs["name"] = NameAttributeValue; attrs["step"] = MinuteStep * 60;
            if (EffectiveDisabled) attrs["disabled"] = true;
            if (ReadOnly) attrs["readonly"] = true;
            return attrs;
        }
    }
    public override Task SetParametersAsync(ParameterView parameters)
    {
        parameters.SetParameterProperties(this); ValueExpression ??= () => Value!;
        return base.SetParametersAsync(ParameterView.Empty);
    }
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if ((Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue)) != typeof(TimeOnly)) throw new InvalidOperationException("TimePicker requires TimeOnly or TimeOnly?.");
        if (MinuteStep is < 1 or > 60 || HourCycle.HasValue && HourCycle is not (12 or 24)) throw new ArgumentException("Use a minute step from 1 to 60 and a 12- or 24-hour cycle.");
    }
    protected override void OnInitialized() => _suggestion = TimeOnly.FromDateTime(DateTime.Now);
    protected override void OnAfterRender(bool firstRender) { if (firstRender) { _ready = true; StateHasChanged(); } }
    protected override string? FormatValueAsString(TValue? value) => value is TimeOnly time ? time.ToString("HH:mm:ss.fffffff", CultureInfo.InvariantCulture) : "";
    protected override bool TryParseValueFromString(string? value, out TValue result, [System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (TimeOnly.TryParse(value, CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var time))
        { result = (TValue)(object)time; validationErrorMessage = null; return true; }
        result = default!; validationErrorMessage = ParsingErrorMessage ?? Words.Invalid; return false;
    }
    private void Set(int hour, int minute) { if (!EffectiveDisabled && !ReadOnly) CurrentValueAsString = new TimeOnly(hour, minute).ToString("HH:mm", CultureInfo.InvariantCulture); }
    private void HourChanged(int hour) => Set(H12 ? hour % 12 + (Shown.Hour >= 12 ? 12 : 0) : hour, Shown.Minute);
    private void MinuteChanged(int minute) => Set(Shown.Hour, minute);
    private void PeriodChanged(int period) => Set(Shown.Hour % 12 + period * 12, Shown.Minute);
    private void NativeChanged(TValue value) { if (!EffectiveDisabled && !ReadOnly) CurrentValueAsString = FormatValueAsString(value); }
    private void Clear() { if (!EffectiveDisabled && !ReadOnly) CurrentValueAsString = ""; }
}
