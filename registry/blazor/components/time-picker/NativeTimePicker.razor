@* RaxUI TimePicker. Source-owned: edit freely. Native form behavior also works in static SSR. *@
@using Microsoft.AspNetCore.Components.Forms
@typeparam TValue
<div class="rax-input-group" data-size="@Size" data-start="@(StartIcon is not null ? "" : null)" data-rax-appearance="@Appearance">
    @if (StartIcon is not null)
    {
        <label for="@ControlId" class="rax-input-slot" data-side="start" aria-hidden="true">@StartIcon</label>
    }
    <InputDate TValue="TValue" Type="InputDateType.Time" @attributes="ControlAttributes" class="@($"form-control rax-input rax-time-picker {(Size == "default" ? "" : $"form-control-{Size}")} {Class} {ExtraClass}".TrimEnd())"
             data-rax-appearance="@Appearance" Value="@Value" ValueChanged="ValueChanged" ValueExpression="OwnValueExpression" ParsingErrorMessage="@ParsingErrorMessage" data-variant="@Variant" />
</div>
@code {
    [Parameter] public RenderFragment? StartIcon { get; set; }
    [Parameter] public string Size { get; set; } = "default";
    [Parameter] public string Variant { get; set; } = "outline";
    [Parameter] public string ParsingErrorMessage { get; set; } = "The {0} field must be a valid time.";

    /// <summary>Bound value, including EditContext validation and static SSR form mapping.</summary>
    [Parameter] public TValue Value { get; set; } = default!;
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<TValue>>? ValueExpression { get; set; }
    // Unbound use (no @bind-Value): the inner input still needs an expression, so point it at this component's own value.
    private System.Linq.Expressions.Expression<Func<TValue>>? _ownValueExpression;
    private System.Linq.Expressions.Expression<Func<TValue>> OwnValueExpression => ValueExpression ?? (_ownValueExpression ??= () => Value);

    [CascadingParameter] private Field.FieldContext? FieldContext { get; set; }
    /// <summary>default, flat, or glass; null inherits the surrounding theme.</summary>
    [Parameter] public string? Appearance { get; set; }
    /// <summary>Extra CSS classes appended to the control.</summary>
    [Parameter] public string? Class { get; set; }
    private string? ExtraClass => AdditionalAttributes is not null && AdditionalAttributes.TryGetValue("class", out var value) ? Convert.ToString(value) : null;
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    private readonly string _autoId = $"rax-control-{Guid.NewGuid():N}";
    private Dictionary<string, object> ControlAttributes
    {
        get
        {
            var attrs = FieldContext is null ? new Dictionary<string, object>() : new(FieldContext.ControlAttributes);
            if (AdditionalAttributes is not null)
                foreach (var pair in AdditionalAttributes) attrs[pair.Key] = pair.Value;
            if (!attrs.ContainsKey("id")) attrs["id"] = _autoId;
            return attrs;
        }
    }
    private string ControlId => Convert.ToString(ControlAttributes["id"])!;

}
