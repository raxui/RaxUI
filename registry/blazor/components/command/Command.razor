@* SheenUI Command. Source-owned: edit freely. Grouped searchable commands in a native dialog. Requires interactivity. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog @ref="_dialog" @attributes="AdditionalAttributes" class="sheen-command-dialog @Class" aria-labelledby="@(_id + "-title")" data-sheen-appearance="@Appearance" @onclose="Closed">
    <h2 id="@(_id + "-title")" class="visually-hidden">@Title</h2>
    <div class="sheen-command">
        <div class="sheen-command-input-wrap"><input @ref="_input" class="sheen-command-input" role="combobox" aria-expanded="true"
            aria-controls="@(_id + "-list")" aria-autocomplete="list" aria-label="@SearchPlaceholder" placeholder="@SearchPlaceholder" @bind="_search" @bind:event="oninput" /></div>
        <div @ref="_list" id="@(_id + "-list")" role="listbox" data-command-list aria-label="@Title" class="sheen-command-list">
            <div class="sheen-command-list-inner">
                @foreach (var group in Filtered.GroupBy(item => item.Group))
                {
                    <div role="group" aria-label="@group.Key" class="sheen-command-group">
                        @if (!string.IsNullOrEmpty(group.Key)) { <div class="sheen-command-group-heading">@group.Key</div> }
                        @foreach (var item in group)
                        {
                            <div id="@(_id + "-" + Items.IndexOf(item))" role="option" aria-selected="false" aria-disabled="@(item.Disabled ? "true" : "false")"
                                 data-value="@item.Value" class="sheen-command-item" @onclick="@(() => Select(item.Value))">@item.Label</div>
                        }
                    </div>
                }
                <div class="sheen-command-empty">@EmptyMessage</div>
            </div>
        </div>
    </div>
</dialog>

@code {
    public record Item(string Value, string Label, string Group = "", bool Disabled = false, string Keywords = "");
    private readonly string _id = "sheen-command-" + Guid.NewGuid().ToString("N");
    private string _search = "";
    private ElementReference _dialog, _input, _list;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Command>? _reference;
    private bool _lastOpen;
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public List<Item> Items { get; set; } = new();
    [Parameter] public EventCallback<string> OnSelect { get; set; }
    [Parameter] public string Title { get; set; } = "Command palette";
    [Parameter] public string SearchPlaceholder { get; set; } = "Search commands...";
    [Parameter] public string EmptyMessage { get; set; } = "No results found.";
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Appearance { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    private IEnumerable<Item> Filtered => Items.Where(item => (item.Label + " " + item.Keywords).Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase));
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _reference = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/UI/Command/Command.razor.js");
        }
        if (_module is null) return;
        await _module.InvokeVoidAsync("init", _dialog, _input, _list, _reference);
        if (firstRender || Open != _lastOpen) { _lastOpen = Open; await _module.InvokeVoidAsync("setOpen", _dialog, Open); }
    }
    [JSInvokable] public async Task Select(string value)
    {
        if (!Items.Any(item => item.Value == value && !item.Disabled)) return;
        await OnSelect.InvokeAsync(value);
        await Close();
    }
    [JSInvokable] public async Task Close() { if (_module is not null) await _module.InvokeVoidAsync("setOpen", _dialog, false); }
    private Task Closed() => OpenChanged.InvokeAsync(false);
    public async Task ShowAsync() { if (_module is not null) await _module.InvokeVoidAsync("setOpen", _dialog, true); await OpenChanged.InvokeAsync(true); }
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _dialog, _input); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _reference?.Dispose();
    }
}
