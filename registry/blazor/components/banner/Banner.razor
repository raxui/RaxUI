@implements IAsyncDisposable
@inject IJSRuntime JS
@* Lucide tone icons / X, ISC. *@
@if (present) {
<div @ref="element" @attributes="AdditionalAttributes" class="rax-banner @Class" role="@(Tone is "warning" or "danger" ? "alert" : "status")" aria-label="@Label" data-tone="@Tone" data-variant="@Variant" data-position="@Position" data-state="@(Current ? "open" : "closed")" data-rax-appearance="@Appearance"><div class="rax-banner-inner">
@if (ShowIcon) { <span class="rax-banner-icon">@if (Icon is not null) { @Icon } else {<svg class="" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="@IconPath" /></svg>}</span> }
<div class="rax-banner-text">@if (Title is not null) { <strong class="rax-banner-title">@Title</strong> }<span class="rax-banner-message">@ChildContent</span></div>
@if (Action is not null) { <div class="rax-banner-actions">@Action</div> }
@if (Dismissible) { <button type="button" class="rax-banner-close" aria-label="@DismissLabel" disabled="@(!ready)" @onclick="Dismiss"><svg class="" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg></button> }
</div></div>
}
@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter] public string Tone { get; set; } = "info";
    [Parameter] public string Variant { get; set; } = "tinted";
    [Parameter] public string Position { get; set; } = "inline";
    [Parameter] public string? Appearance { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool ShowIcon { get; set; } = true;
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public RenderFragment? Action { get; set; }
    [Parameter] public bool Dismissible { get; set; }
    [Parameter] public string DismissLabel { get; set; } = "Dismiss";
    [Parameter] public string? PersistKey { get; set; }
    [Parameter] public bool Open { get; set; } = true;
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    private string IconPath => Tone switch {
        "success" => "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM8 12.5l2.5 2.5L16 9.5",
        "warning" => "M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z",
        "danger" => "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM15 9l-6 6M9 9l6 6",
        "neutral" => "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM12 8v4l2.5 2.5",
        _ => "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM12 11v5M12 8h.01"
    };
    private bool Current => OpenChanged.HasDelegate ? Open : localOpen ?? Open;
    private bool? localOpen, previousOpen;
    private bool present = true, ready, closing, rememberDismissal;
    private ElementReference element; private IJSObjectReference? module;
    protected override void OnParametersSet() {
        if (previousOpen is null) present = Open;
        if (previousOpen != Open) { previousOpen = Open; localOpen = Open; if (Open) present = true; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender) {
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/UI/Banner/Banner.razor.js");
        if (!ready) { ready = true; if (!OpenChanged.HasDelegate && await module.InvokeAsync<bool>("remembered", PersistKey)) { localOpen = false; present = false; } StateHasChanged(); }
        if (!present) return;
        await module.InvokeVoidAsync("sync", element, Position, Current);
        if (!Current && !closing) { closing = true; await module.InvokeVoidAsync("dismiss", element, rememberDismissal ? PersistKey : null); if (!Current) present = false; closing = false; rememberDismissal = false; StateHasChanged(); }
    }
    private async Task Dismiss() { if (closing || !ready || !Current) return; rememberDismissal = true; localOpen = false; await OpenChanged.InvokeAsync(false); StateHasChanged(); }
    public async Task ResetAsync() { module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/UI/Banner/Banner.razor.js"); await module.InvokeVoidAsync("reset", PersistKey); localOpen = true; present = true; await OpenChanged.InvokeAsync(true); StateHasChanged(); }
    public async ValueTask DisposeAsync() { if (module is not null) { try { await module.DisposeAsync(); } catch (JSDisconnectedException) { } } }
}
