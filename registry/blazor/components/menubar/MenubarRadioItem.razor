@* Lucide Circle, ISC. *@
<button @attributes="AdditionalAttributes" type="button" role="menuitemradio" aria-checked="@((Parent?.Current == Value) ? "true" : "false")" tabindex="-1" disabled="@Disabled" class="rax-dropdown-item rax-dropdown-inset @Class" @onclick="Select"><span class="rax-dropdown-indicator">@if (Parent?.Current == Value) {<svg class="" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" /></svg>}</span>@ChildContent</button>
@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [CascadingParameter] public MenubarRadioGroup? Parent { get; set; }
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    private Task Select() => Parent?.Select(Value) ?? Task.CompletedTask;
}
