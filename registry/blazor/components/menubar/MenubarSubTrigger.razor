@* Lucide ChevronRight, ISC. *@
<button @attributes="AdditionalAttributes" type="button" role="menuitem" class="rax-dropdown-item @Class" id="@(Parent?.Id + "-trigger")" data-menubar-sub-trigger data-shell-value="@Parent?.Key" aria-haspopup="menu" aria-expanded="false" aria-controls="@(Parent?.Id + "-content")" tabindex="-1" disabled="@(Disabled || Parent?.Root?.Ready != true)">@ChildContent<svg class="rax-dropdown-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg></button>
@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [CascadingParameter] public MenubarSub? Parent { get; set; }
    [Parameter] public bool Disabled { get; set; }
}
