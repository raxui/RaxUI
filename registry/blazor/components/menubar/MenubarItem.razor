@if (Href is not null) { <a @attributes="AdditionalAttributes" href="@(Disabled ? null : Href)" role="menuitem" tabindex="-1" aria-disabled="@(Disabled ? "true" : null)" class="@Css" @onclick="Selected">@ChildContent</a> } else { <button @attributes="AdditionalAttributes" type="button" role="menuitem" tabindex="-1" disabled="@Disabled" class="@Css" @onclick="Selected">@ChildContent</button> }
@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Inset { get; set; }
    [Parameter] public string Variant { get; set; } = "default";
    [Parameter] public EventCallback<MouseEventArgs> OnSelect { get; set; }
    private string Css => $"rax-dropdown-item {(Inset ? "rax-dropdown-inset" : "")} {(Variant == "destructive" ? "rax-dropdown-item-destructive" : "")} {Class}";
    private Task Selected(MouseEventArgs args) => Disabled ? Task.CompletedTask : OnSelect.InvokeAsync(args);
}
