<CascadingValue Value="this"><div @attributes="AdditionalAttributes" class="rax-menubar-menu @Class">@ChildContent</div></CascadingValue>
@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [CascadingParameter] public Menubar? Root { get; set; }
    [Parameter] public string? Value { get; set; }
    internal string Id { get; } = "rax-menubar-" + Guid.NewGuid().ToString("N");
    internal string Key => Value ?? Id;
}
