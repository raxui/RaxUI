<div @attributes="AdditionalAttributes" class="rax-dropdown-menu rax-menubar-content @Class" role="menu" tabindex="-1" data-menubar-content data-submenu data-shell-value="@Parent?.Key" id="@(Parent?.Id + "-content")" aria-labelledby="@(Parent?.Id + "-trigger")"><span class="rax-dropdown-highlight" aria-hidden="true"></span>@ChildContent</div>
@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [CascadingParameter] public MenubarSub? Parent { get; set; }
}
