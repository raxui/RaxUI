@* SheenUI FormSection. Source-owned: edit freely. A grouped settings card, from boot-ui. *@
<section @attributes="AdditionalAttributes" class="@($"sheen-form-section {Class}".TrimEnd())"
         aria-labelledby="@(Title is null ? null : _titleId)" data-sheen-appearance="@Appearance">
    @if (Title is not null)
    {
        <h3 id="@_titleId" class="sheen-form-section-title">@Title</h3>
    }
    <div class="sheen-form-section-card">@ChildContent</div>
    @if (Footer is not null)
    {
        <p class="sheen-form-section-footer">@Footer</p>
    }
</section>

@code {
    private readonly string _titleId = $"sheen-section-{Guid.NewGuid():N}";
    /// <summary>Small heading above the group.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>Explanatory content below the group.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }
    /// <summary>default, flat, or glass; null inherits the surrounding theme.</summary>
    [Parameter] public string? Appearance { get; set; }
    /// <summary>Extra CSS classes appended after the component's own classes.</summary>
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
}
