@* SheenUI Autocomplete. Source-owned: edit freely. Native input/datalist posts in static SSR; enhanced async suggestions need interactivity. *@
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inherits InputBase<string>
@implements IAsyncDisposable
@inject IJSRuntime JS
<input @ref="_input" @attributes="ControlAttributes" type="text" name="@NameAttributeValue" class="@($"form-control sheen-input {CssClass} {Class}")"
       data-sheen-appearance="@Appearance" value="@CurrentValueAsString" @oninput="Changed" @onfocus="Focused"
       role="@(_interactive ? "combobox" : null)" aria-autocomplete="@(_interactive ? "list" : null)"
       aria-expanded="@(_interactive ? (_open ? "true" : "false") : null)" aria-controls="@(_interactive ? _autoId + "-list" : null)"
       list="@(!_interactive ? _autoId + "-datalist" : null)" autocomplete="off" />
@if (!_interactive)
{
    <datalist id="@(_autoId + "-datalist")">@foreach (var suggestion in Suggestions) { <option value="@suggestion"></option> }</datalist>
}
else
{
    <Popover Id="@(_autoId + "-popup")" Anchor="_input" @bind-Open="_open" Role="presentation" Class="sheen-autocomplete-panel" Appearance="@Appearance">
        <div @ref="_list" id="@(_autoId + "-list")" role="listbox" aria-label="@SuggestionsLabel" aria-busy="@(Busy ? "true" : "false")">
            @if (!Busy && !_failed)
            {
                @foreach (var suggestion in Filtered)
                {
                    <div id="@OptionId(suggestion)" role="option" aria-selected="@(suggestion == CurrentValue ? "true" : "false")" class="sheen-choice-option"
                         data-value="@suggestion" @onclick="@(() => Select(suggestion))">@suggestion</div>
                }
            }
        </div>
        @if (Busy) { <p role="status" class="sheen-choice-empty"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> @LoadingMessage</p> }
        else if (_failed || !Filtered.Any()) { <p role="status" class="sheen-choice-empty">@(_failed ? ErrorMessage : EmptyMessage)</p> }
    </Popover>
}
@code {
    [Parameter] public IReadOnlyList<string> Suggestions { get; set; } = Array.Empty<string>();
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<string>>>? LoadSuggestions { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string SuggestionsLabel { get; set; } = "Suggestions";
    [Parameter] public string LoadingMessage { get; set; } = "Loading suggestions";
    [Parameter] public string EmptyMessage { get; set; } = "No suggestions found.";
    [Parameter] public string ErrorMessage { get; set; } = "Unable to load suggestions.";
    private IReadOnlyList<string> _results = Array.Empty<string>();
    private IEnumerable<string> Filtered => (LoadSuggestions is null ? Suggestions.Where(s => s.Contains(CurrentValue ?? "", StringComparison.CurrentCultureIgnoreCase)) : _results).Distinct();
    private string OptionId(string suggestion) => $"{_autoId}-option-{Filtered.ToList().IndexOf(suggestion)}";
    private bool _interactive, _open, _pending, _failed, _disposed;
    private bool Busy => Loading || _pending;
    private ElementReference _input, _list;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Autocomplete>? _self;
    private CancellationTokenSource? _request;
    private bool IsDisabled => ControlAttributes.TryGetValue("disabled", out var value) && value is true;
    private bool IsReadOnly => ControlAttributes.TryGetValue("readonly", out var value) && value is not false && value is not null;
    private async Task Changed(ChangeEventArgs args)
    {
        if (IsDisabled || IsReadOnly) return;
        CurrentValueAsString = Convert.ToString(args.Value); _open = true;
        await Load();
    }
    private async Task Focused() { if (!IsDisabled && !IsReadOnly) { _open = true; await Load(); } }
    private async Task Load()
    {
        _request?.Cancel(); _request?.Dispose(); _request = new();
        _failed = false;
        if (LoadSuggestions is null) return;
        var request = _request;
        _pending = true; _results = Array.Empty<string>(); StateHasChanged();
        try
        {
            var results = await LoadSuggestions(CurrentValue ?? "", request.Token);
            if (!request.IsCancellationRequested && !_disposed) _results = results;
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested) { }
        catch (Exception) { if (!request.IsCancellationRequested && !_disposed) _failed = true; }
        finally { if (!request.IsCancellationRequested && !_disposed) { _pending = false; StateHasChanged(); } }
    }
    [JSInvokable] public void Select(string value)
    {
        if (IsDisabled || IsReadOnly || Busy || !Filtered.Contains(value)) return;
        CurrentValueAsString = value; Close();
    }
    [JSInvokable] public void Close() { _request?.Cancel(); _pending = false; _open = false; StateHasChanged(); }
    [JSInvokable] public void Show() { if (!IsDisabled && !IsReadOnly) { _open = true; StateHasChanged(); } }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_interactive) { _interactive = true; StateHasChanged(); return; }
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/UI/Popover/Popover.razor.js");
        _self ??= DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("initListbox", _input, _list, _self);
    }
    protected override bool TryParseValueFromString(string? value, out string result, [System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage)
    { result = value ?? ""; validationErrorMessage = null; return true; }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; _request?.Cancel(); _request?.Dispose();
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("disposeListbox", _input); await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
    [CascadingParameter] private Field.FieldContext? FieldContext { get; set; }
    /// <summary>default, flat, or glass; null inherits the surrounding theme.</summary>
    [Parameter] public string? Appearance { get; set; }
    /// <summary>Extra CSS classes appended to the control.</summary>
    [Parameter] public string? Class { get; set; }
    private string? ExtraClass => AdditionalAttributes is not null && AdditionalAttributes.TryGetValue("class", out var value) ? Convert.ToString(value) : null;
    private readonly string _autoId = $"sheen-control-{Guid.NewGuid():N}";
    private Dictionary<string, object> ControlAttributes
    {
        get
        {
            var attrs = FieldContext is null ? new Dictionary<string, object>() : new(FieldContext.ControlAttributes);
            if (AdditionalAttributes is not null)
                foreach (var pair in AdditionalAttributes) attrs[pair.Key] = pair.Value;
            if (!attrs.ContainsKey("id")) attrs["id"] = _autoId;
            return attrs;
        }
    }
    private string ControlId => Convert.ToString(ControlAttributes["id"])!;

}
