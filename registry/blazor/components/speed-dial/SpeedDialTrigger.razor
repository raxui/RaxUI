@* Built-in SVG paths from Lucide (ISC), matching the React source. *@
<Button @attributes="AdditionalAttributes" Class="@($"sheen-speed-dial-trigger {Class}")" Variant="@Variant" Size="@Size" Disabled="@(!Dial.Ready || Dial.Disabled)" aria-label="@Label" aria-haspopup="menu" aria-expanded="@(Dial.Current ? "true" : "false")" aria-controls="@Dial.ContentId" data-state="@(Dial.Current ? "open" : "closed")">
@if (ChildContent is not null) { @ChildContent } else { <svg data-speed-dial-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg> }
</Button>
@code {
    [CascadingParameter] public SpeedDial Dial { get; set; } = default!;
    [Parameter] public string Label { get; set; } = "Actions";
    [Parameter] public string Variant { get; set; } = "default";
    [Parameter] public string Size { get; set; } = "icon-lg";
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
}
