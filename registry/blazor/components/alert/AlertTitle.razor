@* RaxUI AlertTitle. Source-owned: edit freely. Styled by the alert component CSS. *@
<h5 @attributes="AdditionalAttributes" class="@($"rax-alert-box-title {Class}")" data-rax-appearance="@Appearance" >@ChildContent</h5>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>default, flat, or glass; null inherits the surrounding theme.</summary>
    [Parameter] public string? Appearance { get; set; }
    /// <summary>Extra CSS classes.</summary>
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
}
