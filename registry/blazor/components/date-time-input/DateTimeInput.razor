@typeparam TValue
@inherits DatePickerBase<TValue>
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using CultureInfo = System.Globalization.CultureInfo
@inject IJSRuntime JS

@if (Native || !Ready)
{
    <NativeDateTimeInput TValue="TValue" Value="CurrentValue" ValueChanged="NativeChanged" ValueExpression="ValueExpression" StartIcon="StartIcon"
                         Size="@Size" Variant="@Variant" Appearance="@Appearance" Class="@Class" ParsingErrorMessage="@(ParsingErrorMessage ?? Words.InvalidDate)" @attributes="NativeAttributes" />
}
else
{
    <div @ref="_root" @attributes="ControlAttributes" tabindex="-1" class="@($"rax-input-group rax-date-field {Class} {CssClass}")" role="group" dir="@EffectiveDir"
         data-size="@Size" data-variant="@Variant" data-rax-appearance="@Appearance" data-start="@(StartIcon is not null ? "" : null)" data-end="" data-disabled="@(EffectiveDisabled ? "" : null)" data-readonly="@(ReadOnly ? "" : null)">
        @if (StartIcon is not null) { <span class="rax-input-slot" data-side="start" aria-hidden="true">@StartIcon</span> }
        <div class="form-control rax-input rax-date-segments" data-variant="@Variant">
            <span class="rax-date-run" dir="ltr">
                @foreach (var type in DateOrder)
                {
                    if (type != DateOrder[0]) { <span class="rax-date-literal" aria-hidden="true">@FormatCulture.DateTimeFormat.DateSeparator</span> }
                    @Segment(type)
                }
            </span>
            <span class="rax-date-literal" aria-hidden="true"> · </span>
            <span class="rax-date-run" dir="ltr">
                @Segment("hour")<span class="rax-date-literal" aria-hidden="true">:</span>@Segment("minute")
                @if (H12) { <span class="rax-date-literal" aria-hidden="true"> </span>@Segment("period") }
            </span>
        </div>
        <div class="rax-input-slot" data-side="end">
            @if (CanClear && CurrentValue is not null && !ReadOnly)
            {
                <button type="button" class="rax-input-clear" aria-label="@Words.Clear" disabled="@EffectiveDisabled" @onclick="Clear">×</button>
            }
            <button type="button" class="rax-input-action" disabled="@(EffectiveDisabled || ReadOnly)" aria-label="@Words.PickDate" aria-expanded="@(Open ? "true" : "false")" aria-haspopup="dialog" aria-controls="@(ControlId + "-popup")" @onclick="Toggle">
                <svg class="rax-icon rax-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2ZM16 2v4M8 2v4M3 10h18" /></svg>
            </button>
        </div>
    </div>
    <input type="hidden" name="@InputName" value="@(Complete && _draftValid ? Serialize(CurrentValue) : "")" disabled="@EffectiveDisabled" />
    @if (_anchorReady)
    {
    <Popover Id="@(ControlId + "-popup")" Anchor="_root" Open="Open" OpenChanged="OpenChanged" Label="@Words.PickDate" Class="rax-date-popover" Appearance="@Appearance">
        @if (Open)
        {
            <div class="rax-date-popover-body" dir="@EffectiveDir">
                <Calendar Value="SelectedDate" ValueChanged="PickDate" Min="Min" Max="Max" IsDateDisabled="@(day => !CanSelect(day))" Culture="FormatCulture" Text="Words" Today="Today" Dir="@EffectiveDir" WeekStartsOn="WeekStartsOn" AutoFocus Appearance="@Appearance" />
                <TimePicker TValue="TimeOnly?" Value="SelectedTime" ValueChanged="PickTime" Culture="FormatCulture" Text="TimeWords" HourCycle="HourCycle" MinuteStep="MinuteStep" Appearance="@Appearance" Now="NowTime" />
            </div>
            <div class="rax-date-popover-footer">
                <Button Size="sm" Variant="ghost" OnClick="UseNow">@TimeWords.Now</Button>
                <Button Size="sm" OnClick="Done">@TimeWords.Done</Button>
            </div>
        }
    </Popover>
    }
}

@code {
    [Parameter] public int? HourCycle { get; set; }
    [Parameter] public int MinuteStep { get; set; } = 1;
    [Parameter] public bool Native { get; set; }
    [Parameter] public TimeWheel.Labels? TimeText { get; set; }
    [Parameter] public DateTime? Now { get; set; }
    [Parameter] public RenderFragment? StartIcon { get; set; }
    private TimeWheel.Labels TimeWords => TimeText ?? (FormatCulture.TwoLetterISOLanguageName == "ar" ? TimeWheel.Labels.Arabic : new());
    private bool H12 => TimeWheel.TwelveHour(FormatCulture, HourCycle);
    private TimeOnly NowTime { get { var now = Now ?? DateTime.Now; return new TimeOnly(now.Hour, now.Minute / MinuteStep * MinuteStep); } }
    private TimeOnly? SelectedTime => CurrentValue switch { DateTime dt => TimeOnly.FromDateTime(dt), DateTimeOffset dto => TimeOnly.FromDateTime(dto.DateTime), _ => null };
    private readonly Dictionary<string, int?> _parts = new() { ["year"] = null, ["month"] = null, ["day"] = null, ["hour"] = null, ["minute"] = null, ["period"] = null };
    private string? _last;
    private bool _lastH12;
    private bool _draftValid = true;
    private bool Complete => _parts.All(pair => pair.Key == "period" && !H12 || pair.Value.HasValue);
    private string[] DateOrder => new[] { "year", "month", "day" }.OrderBy(type => FormatCulture.DateTimeFormat.ShortDatePattern.IndexOf(type == "year" ? 'y' : type == "month" ? 'M' : 'd')).ToArray();
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<DateTimeInput<TValue>>? _self;
    private bool _disposed;
    private bool _anchorReady;
    private bool _initializing;
    private string SegmentName(string type) => type switch { "year" => TimeWords.Year, "month" => TimeWords.Month, "day" => TimeWords.Day, "hour" => TimeWords.Hour, "minute" => TimeWords.Minute, _ => TimeWords.Period };
    private (int Min, int Max) Limits(string type) => type switch
    {
        "year" => (1, 9999), "month" => (1, 12), "day" => (1, DateTime.DaysInMonth(_parts["year"] ?? 2000, _parts["month"] ?? 1)),
        "hour" => H12 ? (1, 12) : (0, 23), "minute" => (0, 59), _ => (0, 1)
    };
    private RenderFragment Segment(string type) => @<span class="rax-date-segment" role="spinbutton" tabindex="@(EffectiveDisabled ? -1 : 0)" data-segment="@type"
        contenteditable="@(!EffectiveDisabled && !ReadOnly ? "true" : "false")" inputmode="@(type == "period" ? "text" : "numeric")" spellcheck="false" aria-label="@SegmentName(type)"
        aria-valuemin="@Limits(type).Min" aria-valuemax="@Limits(type).Max" aria-valuenow="@_parts[type]" aria-valuetext="@(type == "period" && _parts[type].HasValue ? PeriodText(_parts[type]!.Value) : null)"
        aria-disabled="@(EffectiveDisabled ? "true" : null)" aria-readonly="@(ReadOnly ? "true" : null)" data-placeholder="@(!_parts[type].HasValue ? "" : null)">
        <span class="rax-date-segment-value" data-tick="" @key="_parts[type]">@(_parts[type].HasValue ? type == "period" ? PeriodText(_parts[type]!.Value) : TimeWheel.Digits(_parts[type]!.Value, FormatCulture, type != "year") : type == "year" ? "yyyy" : type == "period" ? "–" : "––")</span>
    </span>;
    private string PeriodText(int value) => value == 0 ? FormatCulture.DateTimeFormat.AMDesignator : FormatCulture.DateTimeFormat.PMDesignator;
    private Dictionary<string, object> NativeAttributes
    {
        get { var attrs = ControlAttributes; attrs["name"] = InputName; attrs["step"] = MinuteStep * 60; if (EffectiveDisabled) attrs["disabled"] = true; if (ReadOnly) attrs["readonly"] = true; return attrs; }
    }
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if ((Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue)) == typeof(DateOnly)) throw new InvalidOperationException("DateTimeInput requires DateTime, DateTimeOffset or their nullable forms.");
        if (MinuteStep is < 1 or > 60 || HourCycle.HasValue && HourCycle is not (12 or 24)) throw new ArgumentException("Invalid time options.");
        if (_last != Serialize(CurrentValue) || _lastH12 != H12) ReadParts();
    }
    private void ReadParts()
    {
        _last = Serialize(CurrentValue); _lastH12 = H12; _draftValid = true;
        var day = SelectedDate; var time = SelectedTime;
        _parts["year"] = day?.Year; _parts["month"] = day?.Month; _parts["day"] = day?.Day;
        _parts["hour"] = time.HasValue ? H12 ? time.Value.Hour % 12 == 0 ? 12 : time.Value.Hour % 12 : time.Value.Hour : null;
        _parts["minute"] = time?.Minute; _parts["period"] = time.HasValue ? time.Value.Hour >= 12 ? 1 : 0 : null;
    }
    [JSInvokable] public Task EditSegment(string type, string action, string digits)
    {
        if (EffectiveDisabled || ReadOnly || !_parts.ContainsKey(type)) return Task.CompletedTask;
        var limits = Limits(type); var prior = _parts[type];
        if (action == "clear") _parts[type] = null;
        else if (action == "digits" && int.TryParse(digits, out var number)) { if (number >= limits.Min && number <= limits.Max) _parts[type] = number; else return Task.CompletedTask; }
        else if (action == "am" || action == "pm") _parts[type] = action == "pm" ? 1 : 0;
        else if (action == "home") _parts[type] = limits.Min;
        else if (action == "end") _parts[type] = limits.Max;
        else
        {
            var delta = action == "up" ? 1 : action == "down" ? -1 : action == "pageup" ? 5 : -5;
            if (type == "minute") delta *= MinuteStep;
            var next = (prior ?? limits.Min) + delta;
            _parts[type] = next > limits.Max ? limits.Min : next < limits.Min ? limits.Max : next;
        }
        if (_parts["day"].HasValue) _parts["day"] = Math.Min(_parts["day"]!.Value, Limits("day").Max);
        CommitParts(); return InvokeAsync(StateHasChanged);
    }
    private void CommitParts()
    {
        _draftValid = false;
        if (!Complete) { CurrentValueAsString = ""; _last = Serialize(CurrentValue); return; }
        var date = new DateOnly(_parts["year"]!.Value, _parts["month"]!.Value, _parts["day"]!.Value);
        var hour = _parts["hour"]!.Value; if (H12) hour = hour % 12 + _parts["period"]!.Value * 12;
        if (!CanSelect(date)) { CurrentValueAsString = "invalid"; return; }
        try { CurrentValue = WithTime(CalendarState.WithDate(CurrentValue, date), new TimeOnly(hour, _parts["minute"]!.Value)); }
        catch (ArgumentException) { CurrentValueAsString = "invalid"; return; }
        CurrentValueAsString = Serialize(CurrentValue); _last = Serialize(CurrentValue); _draftValid = true; Validate();
    }
    private static TValue WithTime(TValue value, TimeOnly time)
    {
        object result = value switch
        {
            DateTime dt => (object)DateTime.SpecifyKind(DateOnly.FromDateTime(dt).ToDateTime(time), dt.Kind),
            DateTimeOffset dto => new DateTimeOffset(DateOnly.FromDateTime(dto.DateTime).ToDateTime(time), dto.Offset),
            _ => throw new InvalidOperationException("DateTimeInput requires a date-time value.")
        };
        return (TValue)result;
    }
    protected override bool TryParseValueFromString(string? value, out TValue result, [System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (DateTime.TryParse(value, CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.RoundtripKind, out _) && Complete)
        { result = CurrentValue!; validationErrorMessage = null; return true; }
        result = default!; validationErrorMessage = ParsingErrorMessage ?? Words.InvalidDate; return false;
    }
    private void PickDate(DateOnly? day)
    {
        if (!day.HasValue || EffectiveDisabled || ReadOnly || !CanSelect(day.Value)) return;
        var time = SelectedTime ?? NowTime;
        CurrentValue = WithTime(CalendarState.WithDate(CurrentValue, day), time); Refresh();
    }
    private void PickTime(TimeOnly? time)
    {
        if (!time.HasValue || EffectiveDisabled || ReadOnly) return;
        var day = SelectedDate ?? Today ?? DateOnly.FromDateTime(Now ?? DateTime.Today);
        if (!CanSelect(day)) return;
        try { CurrentValue = WithTime(CalendarState.WithDate(CurrentValue, day), time.Value); Refresh(); }
        catch (ArgumentException) { CurrentValueAsString = "invalid"; }
    }
    private void Refresh() { ReadParts(); CurrentValueAsString = Serialize(CurrentValue); Validate(); }
    private void NativeChanged(TValue value)
    {
        if (EffectiveDisabled || ReadOnly) return;
        if (value is null) { Clear(); return; }
        var day = CalendarState.DateOf(value)!.Value;
        var time = value is DateTime dt ? TimeOnly.FromDateTime(dt) : TimeOnly.FromDateTime(((DateTimeOffset)(object)value!).DateTime);
        CurrentValue = WithTime(CalendarState.WithDate(CurrentValue, day), time); Refresh();
    }
    private void Toggle() { if (!EffectiveDisabled && !ReadOnly) Open = !Open; }
    private Task OpenChanged(bool open) { Open = open && !EffectiveDisabled && !ReadOnly; return Task.CompletedTask; }
    private void Done() => Open = false;
    private void UseNow() { var now = Now ?? DateTime.Now; PickDate(DateOnly.FromDateTime(now)); PickTime(new TimeOnly(now.Hour, now.Minute / MinuteStep * MinuteStep)); }
    private void Clear() { if (!EffectiveDisabled && !ReadOnly) { CurrentValueAsString = ""; ReadParts(); Open = false; } }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || Native || string.IsNullOrEmpty(_root.Id) || _module is not null || _initializing) return;
        _initializing = true;
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/UI/DateTimeInput/DateTimeInput.razor.js");
            if (_disposed) { await module.DisposeAsync(); return; }
            _module = module;
            _self = DotNetObjectReference.Create(this); await _module.InvokeVoidAsync("init", _root, _self);
            _anchorReady = true; StateHasChanged();
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) when (_disposed) { }
        finally { _initializing = false; }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; Dispose(true);
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _root); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (OperationCanceledException) { }
        }
        _self?.Dispose();
    }
}
