@* RaxUI DateRangeInput. Source-owned: edit freely. Native date inputs post during static SSR. *@
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@implements IDisposable
<div class="rax-date-range-input" data-rax-appearance="@Appearance">
    <div class="rax-input-group" data-start="@(StartIcon is not null ? "" : null)">
        @if (StartIcon is not null) { <label for="@ControlId" class="rax-input-slot" data-side="start" aria-hidden="true">@StartIcon</label> }
    <InputDate TValue="DateOnly?" Type="InputDateType.Date" @attributes="StartAttributes" class="@($"form-control rax-input {Class}")"
               Value="Value" ValueChanged="ValueChanged" ValueExpression="OwnValueExpression" max="@Format(EndValue)" ParsingErrorMessage="@ParsingErrorMessage" />
    </div>
    <span aria-hidden="true">@Separator</span>
    <InputDate TValue="DateOnly?" Type="InputDateType.Date" @attributes="EndAttributes" class="@($"form-control rax-input {Class}")"
               Value="EndValue" ValueChanged="EndValueChanged" ValueExpression="OwnEndValueExpression" min="@Format(Value)" ParsingErrorMessage="@ParsingErrorMessage" />
</div>
@if (OutOfOrder) { <p id="@(ControlId + "-range-error")" class="rax-field-error" role="alert">@OrderMessage</p> }
@code {
    [Parameter] public DateOnly? Value { get; set; }
    [Parameter] public EventCallback<DateOnly?> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<DateOnly?>>? ValueExpression { get; set; }
    // Unbound use (no @bind-Value): the inner input still needs an expression, so point it at this component's own value.
    private System.Linq.Expressions.Expression<Func<DateOnly?>>? _ownValueExpression;
    private System.Linq.Expressions.Expression<Func<DateOnly?>> OwnValueExpression => ValueExpression ?? (_ownValueExpression ??= () => Value);
    [Parameter] public DateOnly? EndValue { get; set; }
    [Parameter] public EventCallback<DateOnly?> EndValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<DateOnly?>>? EndValueExpression { get; set; }
    private System.Linq.Expressions.Expression<Func<DateOnly?>>? _ownEndValueExpression;
    private System.Linq.Expressions.Expression<Func<DateOnly?>> OwnEndValueExpression => EndValueExpression ?? (_ownEndValueExpression ??= () => EndValue);
    [Parameter] public RenderFragment? StartIcon { get; set; }
    [Parameter] public string StartLabel { get; set; } = "Start date";
    [Parameter] public string EndLabel { get; set; } = "End date";
    [Parameter] public string Separator { get; set; } = "\u2013";
    [Parameter] public string OrderMessage { get; set; } = "Start date must be on or before end date.";
    [Parameter] public string ParsingErrorMessage { get; set; } = "The {0} field must be a valid date.";
    [CascadingParameter] private EditContext? EditContext { get; set; }
    private EditContext? _subscribed;
    private ValidationMessageStore? _messages;
    private bool _validatedInvalid;
    private string? _validatedMessage;
    private FieldIdentifier? _validatedField;
    private bool OutOfOrder => Value.HasValue && EndValue.HasValue && Value > EndValue;
    private static string? Format(DateOnly? value) => value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    protected override void OnParametersSet()
    {
        if (_subscribed != EditContext)
        {
            Dispose(); _subscribed = EditContext;
            _validatedInvalid = false; _validatedMessage = null; _validatedField = null;
            if (_subscribed is not null) { _messages = new(_subscribed); _subscribed.OnValidationRequested += Validate; }
        }
        UpdateValidation();
    }
    private void Validate(object? sender, ValidationRequestedEventArgs args) => UpdateValidation();
    private void UpdateValidation()
    {
        if (_messages is null || ValueExpression is null) return;
        var identifier = FieldIdentifier.Create(ValueExpression);
        if (_validatedInvalid == OutOfOrder && _validatedMessage == OrderMessage && _validatedField?.Equals(identifier) == true) return;
        _validatedInvalid = OutOfOrder; _validatedMessage = OrderMessage; _validatedField = identifier;
        _messages.Clear();
        if (OutOfOrder) _messages.Add(identifier, OrderMessage);
        EditContext!.NotifyValidationStateChanged();
    }
    public void Dispose()
    {
        if (_subscribed is not null) _subscribed.OnValidationRequested -= Validate;
        _messages?.Clear(); _messages = null; _subscribed = null;
    }
    private Dictionary<string, object> StartAttributes => Endpoint(false);
    private Dictionary<string, object> EndAttributes => Endpoint(true);
    private Dictionary<string, object> Endpoint(bool end)
    {
        var attrs = ControlAttributes;
        if (end) attrs["id"] = ControlId + "-end";
        attrs.Remove("aria-labelledby"); attrs["aria-label"] = end ? EndLabel : StartLabel;
        if (OutOfOrder) { attrs["aria-invalid"] = "true"; attrs["aria-describedby"] = $"{attrs.GetValueOrDefault("aria-describedby")} {ControlId}-range-error".Trim(); }
        return attrs;
    }
    [CascadingParameter] private Field.FieldContext? FieldContext { get; set; }
    /// <summary>default, flat, or glass; null inherits the surrounding theme.</summary>
    [Parameter] public string? Appearance { get; set; }
    /// <summary>Extra CSS classes appended to the control.</summary>
    [Parameter] public string? Class { get; set; }
    private string? ExtraClass => AdditionalAttributes is not null && AdditionalAttributes.TryGetValue("class", out var value) ? Convert.ToString(value) : null;
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    private readonly string _autoId = $"rax-control-{Guid.NewGuid():N}";
    private Dictionary<string, object> ControlAttributes
    {
        get
        {
            var attrs = FieldContext is null ? new Dictionary<string, object>() : new(FieldContext.ControlAttributes);
            if (AdditionalAttributes is not null)
                foreach (var pair in AdditionalAttributes) attrs[pair.Key] = pair.Value;
            if (!attrs.ContainsKey("id")) attrs["id"] = _autoId;
            return attrs;
        }
    }
    private string ControlId => Convert.ToString(ControlAttributes["id"])!;

}
