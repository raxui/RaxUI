@* Lucide ArrowUp, ISC. *@
<button @attributes="AdditionalAttributes" type="button" class="btn sheen-button btn-glass btn-glass-ghost btn-sm sheen-footer-top @Class" data-footer-top data-scroll-target="@ScrollTarget"><svg class="" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 7-7 7 7M12 5v14" /></svg>@Label</button>
@code {
    [Parameter] public string Label { get; set; } = "Back to top";
    [Parameter] public string? ScrollTarget { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
}
