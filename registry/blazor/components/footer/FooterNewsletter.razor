@* Lucide Check, ISC. The host supplies the subscription service. *@
<form @attributes="AdditionalAttributes" class="rax-footer-newsletter @Class" novalidate data-state="@state" @onsubmit="Subscribe" @onsubmit:preventDefault>
    <label for="@id" class="rax-footer-heading">@Title</label>@if (Description is not null) { <p class="rax-footer-tagline">@Description</p> }
    @if (state == "done") { <p class="rax-footer-newsletter-done" role="status"><svg class="" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>@SuccessMessage</p> }
    else { <div class="rax-footer-newsletter-row"><input id="@id" class="form-control" type="email" dir="ltr" autocomplete="email" maxlength="254" placeholder="@Placeholder" @bind="email" @bind:event="oninput" disabled="@(state == "sending")" aria-invalid="@(state == "invalid" ? "true" : null)" aria-describedby="@(state is "invalid" or "error" ? id + "-error" : null)" /><Button type="submit" disabled="@(!ready || state == "sending")">@(state == "sending" ? SendingLabel : SubmitLabel)</Button></div>
        @if (state is "invalid" or "error") { <p id="@(id + "-error")" class="rax-footer-newsletter-error" role="alert">@(state == "invalid" ? InvalidMessage : ErrorMessage)</p> }
    }
</form>
@code {
    [Parameter] public string Title { get; set; } = "Stay in the loop";
    [Parameter] public string? Description { get; set; } = "One email a month. No spam.";
    [Parameter] public string Placeholder { get; set; } = "you@example.com";
    [Parameter] public string SubmitLabel { get; set; } = "Subscribe";
    [Parameter] public string SendingLabel { get; set; } = "Subscribing…";
    [Parameter] public string SuccessMessage { get; set; } = "Thanks! Check your inbox to confirm.";
    [Parameter] public string InvalidMessage { get; set; } = "Enter a valid email address.";
    [Parameter] public string ErrorMessage { get; set; } = "Something went wrong. Try again.";
    [Parameter] public EventCallback<string> OnSubscribe { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    private readonly string id = "rax-newsletter-" + Guid.NewGuid().ToString("N");
    private string email = "", state = "idle"; private bool ready;
    protected override void OnAfterRender(bool firstRender) { if (firstRender) { ready = true; StateHasChanged(); } }
    private async Task Subscribe() {
        if (!ready || state == "sending") return;
        var address = email.Trim();
        if (address.Length > 254 || !System.Text.RegularExpressions.Regex.IsMatch(address, @"^[^\s@]+@[^\s@]+\.[^\s@]+$")) { state = "invalid"; return; }
        state = "sending";
        try { await OnSubscribe.InvokeAsync(address); state = "done"; } catch { state = "error"; }
    }
}
