<div @attributes="AdditionalAttributes" class="sheen-footer-brand @Class"><a class="sheen-footer-logo" href="@Href">@Logo@if (Name is not null) { <span>@Name</span> }</a>@if (Tagline is not null) { <p class="sheen-footer-tagline">@Tagline</p> }@ChildContent</div>
@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter] public string Href { get; set; } = "/";
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Tagline { get; set; }
    [Parameter] public RenderFragment? Logo { get; set; }
}
