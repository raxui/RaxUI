@* Lucide ChevronDown, ISC. All links stay visible until interactive enhancement. *@
<nav @attributes="AdditionalAttributes" class="sheen-footer-column @Class" aria-labelledby="@(id + "-title")" data-default-open="@DefaultOpen.ToString().ToLowerInvariant()"><h2 class="sheen-footer-heading" id="@(id + "-title")"><span data-footer-title>@Title</span><button type="button" data-footer-toggle hidden aria-expanded="true" aria-controls="@(id + "-list")">@Title<svg class="sheen-nav-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button></h2><div class="sheen-footer-list-wrap" id="@(id + "-list")"><ul class="sheen-footer-list">@ChildContent</ul></div></nav>
@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    private readonly string id = "sheen-footer-" + Guid.NewGuid().ToString("N");
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public bool DefaultOpen { get; set; }
}
