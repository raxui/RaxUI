@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
<CascadingValue Value="this"><footer @ref="element" @attributes="AdditionalAttributes" class="sheen-footer @Class" data-variant="@Variant" data-sheen-appearance="@Appearance" style="@(Style + (MaxWidth is null ? "" : $";--sheen-footer-max:{MaxWidth}"))"><div class="sheen-footer-inner">@ChildContent</div></footer></CascadingValue>
@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter] public string Variant { get; set; } = "subtle";
    [Parameter] public string? Appearance { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? MaxWidth { get; set; }
    protected override void OnInitialized() => Navigation.LocationChanged += LocationChanged;
    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);
    internal bool IsCurrent(string href) { var target = Navigation.ToAbsoluteUri(href); var current = Navigation.ToAbsoluteUri(Navigation.Uri); return current.GetLeftPart(UriPartial.Path).TrimEnd('/').Equals(target.GetLeftPart(UriPartial.Path).TrimEnd('/'), StringComparison.OrdinalIgnoreCase) && (string.IsNullOrEmpty(target.Fragment) || current.Fragment == target.Fragment); }
    private bool disposed;
    private ElementReference element; private IJSObjectReference? module;
    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (disposed) return; module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/UI/Footer/Footer.razor.js");
        if (disposed) { await module.DisposeAsync(); return; } await module.InvokeVoidAsync("init", element); }
    public async ValueTask DisposeAsync() { disposed = true; Navigation.LocationChanged -= LocationChanged; if (module is not null) { try { await module.InvokeVoidAsync("dispose", element); await module.DisposeAsync(); } catch (JSDisconnectedException) { } } }
}
