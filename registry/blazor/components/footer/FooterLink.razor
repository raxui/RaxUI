<li><a data-enhance-nav="@(PreventDefault ? "false" : null)" @onclick:preventDefault="@PreventDefault" @attributes="AdditionalAttributes" class="rax-footer-link @Class" aria-current="@(Parent?.IsCurrent(Href) == true ? "page" : null)" href="@Href"><span>@ChildContent</span></a>@if (Badge is not null) { <span class="rax-footer-badge">@Badge</span> }</li>
@code {
    [CascadingParameter] public Footer? Parent { get; set; }
    [Parameter] public bool PreventDefault { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter] public string Href { get; set; } = "/";
    [Parameter] public RenderFragment? Badge { get; set; }
}
