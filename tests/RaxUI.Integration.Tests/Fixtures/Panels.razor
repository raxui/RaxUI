@page "/panel-demo"
@rendermode InteractiveServer
<div id="panel-theme" data-rax-appearance="@appearance" data-bs-theme="@mode" dir="@direction" style="padding:1rem">
    <label>Appearance<select id="panel-appearance" @bind="appearance"><option>default</option><option>flat</option><option>glass</option></select></label>
    <label>Mode<select id="panel-mode" @bind="mode"><option>light</option><option>dark</option></select></label>
    <label>Direction<select id="panel-direction" @bind="direction"><option>ltr</option><option>rtl</option></select></label>
    <label>Side<select id="panel-side" @bind="side"><option>start</option><option>end</option><option>top</option><option>bottom</option></select></label>
    <label>Draggable<input id="panel-draggable" type="checkbox" @bind="draggable" /></label>
    <button id="open-sheet-probe" disabled="@(!ready)" @onclick="@(() => sheet = true)">Open probe sheet</button>
    <button id="open-drawer-probe" disabled="@(!ready)" @onclick="@(() => drawer = true)">Open probe drawer</button>
    <Sheet @bind-Open="sheet" Side="@side" Draggable="draggable" Title="Probe sheet" Description="Panel geometry and gestures" FooterClass="gap-2">
        <ChildContent><input id="panel-text" @bind="text" aria-label="Text" /><button id="panel-action" @onclick="@(() => clicks++)">Action</button>@for(var i=0;i<60;i++){<p>Scrollable content @i</p>}</ChildContent>
        <Footer><button @onclick="@(() => sheet = false)">Close probe sheet</button></Footer>
    </Sheet>
    <Drawer @bind-Open="drawer" Side="@side" Title="Probe drawer" Description="Directional geometry" ShowCloseButton>
        <ChildContent>@for(var i=0;i<60;i++){<p>Scrollable content @i</p>}</ChildContent>
        <Footer><button @onclick="@(() => drawer = false)">Close probe drawer</button></Footer>
    </Drawer>
    <output id="panel-values">@text|@clicks|@sheet|@drawer</output>
    <CascadingValue Name="PanelExamplesArabic" Value='@(direction == "rtl")'><SheetExamples /><DrawerExamples /></CascadingValue>
    <Toaster />
</div>
@code {
    private string appearance = "default", mode = "light", direction = "ltr", side = "start", text = "Safe text";
    private bool sheet, drawer, ready, draggable = true; private int clicks;
    protected override void OnAfterRender(bool firstRender) { if(firstRender){ready=true;StateHasChanged();} }
}
