<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.58.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- A tiny registry (alpha depends on beta) for dependency installs, read with EmbeddedRegistry(assembly, prefix). -->
    <EmbeddedResource Include="TestRegistry\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SheenUI.Cli\SheenUI.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures/**/*.razor" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/blazor/data/*.razor" Link="Fixtures/DataExamples/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/VirtualizationProbe.razor.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/blazor/app-shell/*" Link="Fixtures/AppShellExamples/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/blazor/panels/*" Link="Fixtures/PanelExamples/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/blazor/SheenDemo.razor" Link="Fixtures/SheenDemo.razor" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
