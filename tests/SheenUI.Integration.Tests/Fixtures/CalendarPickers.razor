@page "/calendar-demo"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using CultureInfo = System.Globalization.CultureInfo

<PageTitle>SheenUI Gregorian calendars</PageTitle>
<div id="calendar-demo" dir="rtl" class="container py-4" style="max-width:1100px">
    <h1 class="h4">التقويم الميلادي ومنتقيات التاريخ</h1>
    <div class="row g-4 mt-2">
        <section class="col-lg-5" aria-label="تقويم ميلادي">
            <div class="sheen-panel p-3 d-inline-block">
                <Calendar @bind-Value="day" Culture="Arabic" Min="@(new DateOnly(2024, 2, 1))" Max="@(new DateOnly(2024, 4, 30))" WeekStartsOn="DayOfWeek.Monday" />
            </div>
            <output id="calendar-value">@CalendarState.Iso(day)</output>
        </section>
        <section class="col-lg-7" aria-label="حجز موعد">
            <EditForm Model="Model" FormName="calendar-booking" OnValidSubmit="Save" Context="bookingForm">
                <DataAnnotationsValidator />
                <Form>
                    <div class="vstack gap-3">
                        <Field Id="booking-day" For="@(() => Model!.Day)"><FieldLabel>الموعد</FieldLabel>
                            <DatePicker @bind-Value="Model!.Day" Culture="Arabic" Clearable Min="@(new DateOnly(2026, 10, 1))" Max="@(new DateOnly(2026, 10, 31))" IsDateDisabled="@(date => date.Day == 20)" />
                            <FieldError />
                        </Field>
                        <Field Id="booking-time" For="@(() => Model!.DateTime)"><FieldLabel>تاريخ مع وقت محفوظ</FieldLabel>
                            <DatePicker @bind-Value="Model!.DateTime" Culture="Arabic" />
                            <FieldError />
                        </Field>
                        <Field Id="booking-offset" For="@(() => Model!.Offset)"><FieldLabel>تاريخ مع إزاحة محفوظة</FieldLabel>
                            <DatePicker @bind-Value="Model!.Offset" Culture="Arabic" />
                            <FieldError />
                        </Field>
                        <Field Id="booking-range" For="@(() => Model!.From)"><FieldLabel>مدة الإقامة</FieldLabel>
                            <DateRangePicker @bind-Value="Model!.From" @bind-EndValue="Model!.To" Culture="Arabic" Clearable MinDays="2" MaxDays="10"
                                             Min="@(new DateOnly(2026, 10, 1))" Max="@(new DateOnly(2026, 12, 31))" ExcludeDisabled IsDateDisabled="@(date => date.DayOfWeek == DayOfWeek.Sunday)" />
                            <FieldError />
                        </Field>
                        <Field Id="offset-range" For="@(() => Model!.OffsetFrom)"><FieldLabel>Offset range</FieldLabel>
                            <DateRangePicker @bind-Value="Model!.OffsetFrom" @bind-EndValue="Model!.OffsetTo" Culture="English" Clearable Today="@(new DateOnly(2026, 10, 26))" />
                            <FieldError />
                        </Field>
                        <DatePicker TValue="DateOnly?" id="unbound-picker" Value="@(new DateOnly(2026, 10, 15))" Culture="English" />
                        <DatePicker TValue="DateOnly?" id="readonly-picker" Value="@(new DateOnly(2026, 10, 15))" ReadOnly Culture="English" />
                        <Field Disabled><FieldLabel>Disabled picker</FieldLabel><DatePicker TValue="DateOnly?" id="disabled-picker" Culture="English" /></Field>
                        <Button id="invalidate-range" Variant="ghost" OnClick="Invalidate">Invalidate range</Button>
                        <Button id="calendar-save" type="submit" Disabled="@(!ready)">حفظ</Button>
                    </div>
                </Form>
            </EditForm>
            <output id="booking-values">@Values</output>
            <output id="offset-range-values">@($"{Model!.OffsetFrom:O}|{Model.OffsetTo:O}")</output>
            <output id="booking-saved">@saved</output>
        </section>
    </div>
    <section class="mt-4" aria-label="حدود السنة">
        <Calendar id="minimum-calendar" Value="@(new DateOnly(1, 1, 1))" Min="@(new DateOnly(1, 1, 1))" Max="@(new DateOnly(1, 3, 31))" Culture="English" />
        <Calendar id="maximum-calendar" Value="@(new DateOnly(9999, 12, 31))" Culture="English" NumberOfMonths="2" Responsive />
    </section>
</div>

@code {
    private static readonly CultureInfo Arabic = new("ar-IQ");
    private static readonly CultureInfo English = new("en-GB");
    private DateOnly? day = new(2024, 2, 29);
    [SupplyParameterFromForm] private Booking? Model { get; set; }
    protected override void OnInitialized() => Model ??= new();
    private bool ready;
    private string saved = "";
    protected override void OnAfterRender(bool firstRender) { if (firstRender) { ready = true; StateHasChanged(); } }
    private void Save() => saved = "Saved";
    private void Invalidate() { Model!.To = Model.From?.AddDays(-1); saved = ""; }
    private string Values => $"{Model!.Day:yyyy-MM-dd}|{Model!.DateTime:O}|{Model!.Offset:O}|{Model!.From:yyyy-MM-dd}|{Model!.To:yyyy-MM-dd}";
    public class Booking
    {
        [Required(ErrorMessage = "اختر الموعد أولاً")]
        public DateOnly? Day { get; set; }
        public DateTime DateTime { get; set; } = new(2026, 10, 15, 14, 35, 0, DateTimeKind.Utc);
        public DateTimeOffset Offset { get; set; } = new(2026, 10, 15, 23, 45, 0, TimeSpan.FromHours(3));
        public DateTimeOffset? OffsetFrom { get; set; } = new DateTimeOffset(2026, 10, 12, 9, 15, 0, TimeSpan.FromHours(3));
        public DateTimeOffset? OffsetTo { get; set; } = new DateTimeOffset(2026, 10, 15, 18, 30, 0, TimeSpan.FromHours(2));
        public DateOnly? From { get; set; } = new(2026, 10, 12);
        public DateOnly? To { get; set; } = new(2026, 10, 15);
    }
}
