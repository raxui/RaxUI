@page "/data-components"
@rendermode InteractiveServer
<div data-sheen-appearance="@appearance" data-bs-theme="@mode" dir="@direction" style="padding:1rem">
<label>Appearance<select id="data-appearance" @bind="appearance"><option>default</option><option>flat</option><option>glass</option></select></label>
<label>Mode<select id="data-mode" @bind="mode"><option>light</option><option>dark</option></select></label>
<label>Direction<select id="data-direction" @bind="direction"><option>ltr</option><option>rtl</option></select></label>
<h1>Data components</h1><output id="model-checks">@checks</output>
<section id="table-example"><DataTableExamples Arabic='@(direction=="rtl")'/></section>
<section id="sortable-example"><SortableExamples Arabic='@(direction=="rtl")'/></section>
<section id="resizable-example"><ResizableExamples Arabic='@(direction=="rtl")'/></section>
<section id="grid-example"><DataGridExamples Arabic='@(direction=="rtl")'/></section>
</div>
@code {
    private string appearance="default",mode="light",direction="ltr",checks="";
    private sealed record Sample(string Id,int Count,string Category);
    protected override void OnInitialized(){
        void Require(bool condition,string name){if(!condition)throw new InvalidOperationException("Model check failed: "+name);}
        var rows=new[]{new Sample("a",2,"x"),new Sample("b",1,"y"),new Sample("c",3,"x")};
        var columns=new[]{new DataTableTypes.Column<Sample>{Id="count",Title="Count",Value=r=>r.Count,Format=_=>"formatted"},new DataTableTypes.Column<Sample>{Id="category",Title="Category",Value=r=>r.Category}};
        var table=new DataTableState.State<Sample>();table.Initialize(2,null,null,"comfortable");table.Configure(rows,columns,r=>r.Id);table.Toggle("a");table.SortBy("count",false);
        Require(table.PageRows.First().Id=="b"&&table.SelectedRows.Single().Id=="a","sort/identity");table.SetPage(999);Require(table.Page==2,"page clamp");table.Filter("category","x");Require(table.Page==1&&table.Filtered.Count==2,"filter/page reset");table.Search("2");Require(table.Filtered.Count==1&&table.Filtered[0].Id=="a","raw value search");table.Search("missing");Require(table.Filtered.Count==0&&table.PageCount==1,"empty search");
        var grid=new DataGridModel.State<Sample>();grid.Configure(rows,new[]{new DataGridTypes.Column<Sample>{Id="count",Title="Count",Value=r=>r.Count,Aggregate="sum"}},r=>r.Id);Require(Convert.ToDecimal(grid.Totals["count"])==6m&&grid.RowIndexes["c"]==2,"grid aggregate/index");
        var number=new DataGridTypes.Column<Sample>{Id="number",Title="Number",Value=r=>r.Count,Editor=new(){Type="number",Min=1,Max=10}};var labels=new DataGridTypes.Labels();
        Require(DataGridEditing.Session.Validate(number,rows[0],DataGridEditing.Session.Parse(number.Editor!,"bad"),labels)==labels.InvalidNumber,"invalid number");Require(DataGridEditing.Session.Parse(new(){Type="date"},"2024-02-29") is DateOnly&&DataGridEditing.Session.Parse(new(){Type="date"},"2023-02-29") is string,"Gregorian date validation");
        var session=new DataGridEditing.Session();session.Begin("a","count",2,null);session.SetDraft("invalid");session.End(false);session.Begin("a","count",2,null);Require(session.Draft=="invalid","retained draft");session.End();session.Begin("a","count",2,null);Require(session.Draft=="2","explicit discard");
        checks="Passed";
    }
}
