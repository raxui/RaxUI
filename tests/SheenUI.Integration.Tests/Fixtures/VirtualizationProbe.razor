@page "/virtual-window"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
<h1>Virtualization comparison</h1>
<p>Mode: @Mode · 10,000 rows · 40px · <span id="probe-draft">@draft</span></p>
<div @ref="root" id="probe-grid" role="grid" tabindex="0" aria-label="Virtualization probe" aria-rowcount="10000" aria-colcount="1" style="height:240px;overflow:auto;position:relative;border:1px solid #999" data-mode="@Mode" data-callbacks="@callbacks">
    @if(Mode=="framework"){
        <Virtualize Items="rows" ItemSize="40" OverscanCount="12" Context="row">
            @Row(row,false)
        </Virtualize>
    }else{
        <div style="height:400000px;position:relative">
            @foreach(var index in Enumerable.Range(start,Math.Max(0,end-start)).Append(0).Distinct().OrderBy(i=>i)){
                @Row(rows[index],true)
            }
        </div>
    }
</div>
@code {
    [SupplyParameterFromQuery] public string Mode { get; set; } = "manual";
    private readonly List<int> rows=Enumerable.Range(0,10000).ToList();
    private int start,end=20,callbacks;private string draft="Draft 0";
    private ElementReference root;private IJSObjectReference? module;private DotNetObjectReference<VirtualizationProbe>? self;
    private RenderFragment Row(int row,bool positioned)=>@<div @key="row" role="row" aria-rowindex="@(row+1)" data-row="@row" style="@($"height:40px;box-sizing:border-box;{(positioned?$"position:absolute;top:0;inset-inline:0;transform:translateY({row*40}px)":"")}")"><div role="gridcell" id="@($"probe-cell-{row}")">@if(row==0){<input aria-label="Retained editor" value="@draft" @oninput="e=>draft=Convert.ToString(e.Value)??string.Empty" />}else{@($"Row {row}")}</div></div>;
    protected override async Task OnAfterRenderAsync(bool firstRender){
        module??=await JS.InvokeAsync<IJSObjectReference>("import","./Components/Pages/VirtualizationProbe.razor.js");self??=DotNetObjectReference.Create(this);await module.InvokeVoidAsync("sync",root,self,Mode);
    }
    [JSInvokable] public async Task Range(int first,int last){start=Math.Clamp(first,0,9999);end=Math.Clamp(last,start+1,10000);callbacks++;await InvokeAsync(StateHasChanged);}
    [JSInvokable] public Task Ping()=>Task.CompletedTask;
    public async ValueTask DisposeAsync(){if(module is null)return;try{await module.InvokeVoidAsync("dispose",root);await module.DisposeAsync();}catch(JSDisconnectedException){}self?.Dispose();}
}
