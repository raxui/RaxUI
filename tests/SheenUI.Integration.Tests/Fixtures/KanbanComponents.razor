@page "/kanban-demo"
@rendermode InteractiveServer
<div data-sheen-appearance="@appearance" data-bs-theme="@mode" dir="@direction" style="padding:1rem">
<label>Appearance<select id="kanban-appearance" @bind="appearance"><option>default</option><option>flat</option><option>glass</option></select></label>
<label>Mode<select id="kanban-mode" @bind="mode"><option>light</option><option>dark</option></select></label>
<label>Direction<select id="kanban-direction" @bind="direction"><option>ltr</option><option>rtl</option></select></label>
<h1>Kanban</h1>
<section id="tasks-example">
    <Kanban TItem="Job" @bind-Columns="tasks" GetId="t=>t.Id" GetLabel="t=>t.Title" Committed="Commit" IsDisabled="t=>t.Locked">
        <ItemTemplate Context="task">
            <div class="fw-medium">@task.Title</div>
            <span class="badge text-bg-@(task.Priority=="High"?"danger":"secondary") mt-2">@task.Priority</span>
        </ItemTemplate>
        <Empty>Drop cards here</Empty>
    </Kanban>
    <output id="tasks-state">@string.Join(" | ",tasks.Select(c=>c.Id+":"+string.Join(",",c.Items.Select(t=>t.Id))))</output>
    <output id="tasks-commit">@committed</output>
</section>
<section id="arabic-example" dir="rtl" lang="ar" class="mt-4">
    <Kanban TItem="string" @bind-Columns="arabic" GetId="x=>x" GetLabel="x=>x" AsHandle="false" MovableColumns="false"
            Instructions="اضغط مسافة أو Enter لالتقاط البطاقة، والأسهم لنقلها، ومسافة للإفلات، وEscape للإلغاء."
            ItemHandleLabel="اسحب البطاقة" Grabbed="التقطت {item} في {column}. الموضع {position} من {total}."
            Moved="نُقلت {item} إلى {column}، الموضع {position} من {total}." Dropped="أُفلتت {item} في {column} عند الموضع {position} من {total}."
            Cancelled="أُلغي النقل. عادت {item} إلى مكانها." ItemClass="d-flex align-items-center gap-2">
        <ItemTemplate Context="card">@card</ItemTemplate>
        <Empty>أفلت البطاقات هنا</Empty>
    </Kanban>
    <output id="arabic-state">@string.Join(" | ",arabic.Select(c=>c.Id+":"+string.Join(",",c.Items)))</output>
</section>
</div>
@code {
    private sealed record Job(string Id,string Title,string Priority,bool Locked=false);
    private string appearance="default",mode="light",direction="ltr",committed="";
    private IReadOnlyList<KanbanTypes.Column<Job>> tasks=new KanbanTypes.Column<Job>[]{
        new("todo","To do",new Job[]{new Job("t1","Write docs","High"),new("t2","Design tokens","Low"),new("t3","Legal review","Low",true)}),
        new("doing","In progress",new Job[]{new("t4","Kanban port","High")}){Limit=1},
        new("done","Done",Array.Empty<Job>()),
        new("archive","Archive",Array.Empty<Job>()){Disabled=true}
    };
    private void Commit(KanbanTypes.Change c)=>committed=$"{c.Type}:{c.Id}:{c.From}>{c.To}@{c.Index}";
    private IReadOnlyList<KanbanTypes.Column<string>> arabic=new KanbanTypes.Column<string>[]{
        new("new","جديد",new[]{"تصميم الشعار","مراجعة النص"}),
        new("review","قيد المراجعة",Array.Empty<string>())
    };
}
